+/* Use a known non-zero fill so an omitted output bit is visible in the
+ * round-trip check instead of being masked by a fresh zero-filled buffer. */
+static int hdr_plus_round_trip_prefilled(const AVDynamicHDRPlus *in,
+                                         AVDynamicHDRPlus *out,
+                                         int *size_match)
+{
+    uint8_t *buf = NULL;
+    size_t required = 0, size;
+    int ret;
+
+    *size_match = 0;
+    ret = av_dynamic_hdr_plus_to_t35(in, NULL, &required);
+    if (ret < 0)
+        return ret;
+    buf = av_malloc(required);
+    if (!buf)
+        return AVERROR(ENOMEM);
+    memset(buf, 0xA5, required);
+    size = required;
+    ret = av_dynamic_hdr_plus_to_t35(in, &buf, &size);
+    if (ret < 0)
+        goto done;
+    *size_match = size == required;
+    if (!*size_match) {
+        ret = AVERROR_INVALIDDATA;
+        goto done;
+    }
+    memset(out, 0, sizeof(*out));
+    ret = av_dynamic_hdr_plus_from_t35(out, buf, size);
+
+done:
+    av_free(buf);
+    return ret;
+}
