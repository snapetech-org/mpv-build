Subject: [PATCH] retain SSH host-key verification in the bundled FEL engine

diff --git a/doc/protocols.texi b/doc/protocols.texi
index aaee2292e9d37f3bd9f22ade3d8b22f5347a980e..dc6535c86b9c30da7d731f33fd16ff4096c6d3d9 100644
--- a/doc/protocols.texi
+++ b/doc/protocols.texi
@@ -1318,6 +1318,10 @@ Verify the server host key against the known_hosts file before
 authenticating, if set to 1. Servers that are not in the file, or whose
 key differs from the one recorded there, are refused. Default value is 1.
 
+@item verify
+Verify the server host key against known_hosts before authentication. Unknown
+or changed keys are refused. The default is 1.
+
 @end table
 
 Example: Play a file stored on remote server.
diff --git a/libavformat/libssh.c b/libavformat/libssh.c
index 2b219a8362474e1f6641c2a2ebb1a70e4b5c76b7..f0827cd58d182a5bbcf621bc670486a96d096255 100644
--- a/libavformat/libssh.c
+++ b/libavformat/libssh.c
@@ -171,6 +171,12 @@ static av_cold int libssh_create_sftp_session(LIBSSHContext *libssh)
         return AVERROR(EIO);
     }
 
+    if (libssh->verify) {
+        int ret = libssh_verify_hostkey(libssh);
+        if (ret < 0)
+            return ret;
+    }
+
     return 0;
 }
 
