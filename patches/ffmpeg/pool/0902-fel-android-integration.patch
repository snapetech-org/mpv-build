+
+#ifndef AVCODEC_MEDIACODEC_SHED_H
+#define AVCODEC_MEDIACODEC_SHED_H
+
+#include <stdint.h>
+
+#include "avcodec.h"
+#include "packet.h"
+
+/*
+ * A hardware decoder cannot skip frames the way a software one honours
+ * AVDiscard: MediaCodec decodes everything it is handed. The only way to
+ * spend less decoder time is to hand it less. These helpers remove, from an
+ * access unit about to be queued, the one shown frame that no later frame
+ * can reference -- a frame that refreshes no reference slot (AV1, VP9), a
+ * nal_ref_idc == 0 picture (H.264), or a sub-layer non-reference picture of
+ * the highest temporal sub-layer (HEVC). Not decoding such a frame cannot
+ * corrupt anything that follows; that is the whole safety argument, so
+ * every helper fails open: anything it does not fully understand is kept.
+ *
+ * A VP9 superframe's hidden frames stay in the packet when its shown frame
+ * is shed: the packet is truncated to them, never reordered. AV1 is shed by
+ * whole temporal units only (see av1_shed).
+ */
+
+typedef struct MediaCodecShedContext {
+    enum AVCodecID codec_id;
+
+    // AV1: a coded-bitstream reader that follows the stream (sequence header
+    // and reference state) so every frame header decomposes; NULL when the
+    // parser is unavailable for this stream.
+    struct CodedBitstreamContext *cbs;
+    struct CodedBitstreamFragment *frag;
+    int cbs_failures;   // consecutive units the reader refused
+
+    // HEVC: sps_max_sub_layers_minus1 of the last SPS seen, -1 until one has.
+    int hevc_max_sub_layers_minus1;
+} MediaCodecShedContext;
+
+int ff_mediacodec_shed_init(MediaCodecShedContext *sh, AVCodecContext *avctx);
+void ff_mediacodec_shed_flush(MediaCodecShedContext *sh);
+void ff_mediacodec_shed_uninit(MediaCodecShedContext *sh);
+
+/**
+ * Follow the stream for the parsers that keep state (AV1). Cheap; call for
+ * every packet that will be queued, whether or not shedding is wanted.
+ */
+void ff_mediacodec_shed_observe(MediaCodecShedContext *sh, AVCodecContext *avctx,
+                                const AVPacket *pkt);
+
+/**
+ * Remove the shown non-reference frame from pkt when there is one. On
+ * return pkt->size is 0 when the whole access unit was that frame, smaller
+ * when a VP9 superframe's hidden frames were kept, unchanged when nothing
+ * could be shed.
+ *
+ * @return 1 when a frame was shed, 0 when the packet is untouched, < 0 on an
+ *         allocation failure (pkt untouched).
+ */
+int ff_mediacodec_shed_packet(MediaCodecShedContext *sh, AVCodecContext *avctx,
+                              AVPacket *pkt);
+
+// Bitstream classifiers, exported for the host regression.
+int ff_mediacodec_shed_h264_droppable(const uint8_t *data, int size);
+int ff_mediacodec_shed_hevc_droppable(const uint8_t *data, int size,
+                                      int *max_sub_layers_minus1);
+int ff_mediacodec_shed_vp9_frame_droppable(const uint8_t *data, int size);
+int ff_mediacodec_shed_vp9_packet(AVPacket *pkt);
+
+#endif /* AVCODEC_MEDIACODEC_SHED_H */
