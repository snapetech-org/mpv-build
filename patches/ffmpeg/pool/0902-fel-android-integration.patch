+// --- mediacodec dv filter
+
+static const uint8_t *dv_next_startcode(const uint8_t *p, const uint8_t *end)
+{
+    for (; end - p >= 3; p++) {
+        if (p[0] == 0 && p[1] == 0 && p[2] == 1)
+            return p;
+    }
+    return end;
+}
+
+/*
+ * Output buffer for a rewritten access unit, reused across packets: the
+ * previous packet's ref is gone by the time the next one is fetched, so the
+ * buffer is normally writable and grows in place. AVPacket.size plus padding
+ * must fit in int.
+ */
+static int dv_out_reserve(MediaCodecContext *s, size_t used, size_t extra)
+{
+    const size_t limit = INT_MAX - AV_INPUT_BUFFER_PADDING_SIZE;
+    size_t needed, capacity;
+
+    if (used > limit || extra > limit - used)
+        return AVERROR(ENOMEM);
+    needed = used + extra + AV_INPUT_BUFFER_PADDING_SIZE;
+    if (s->dv_out && !av_buffer_is_writable(s->dv_out))
+        av_buffer_unref(&s->dv_out);
+    if (s->dv_out && needed <= s->dv_out->size)
+        return 0;
+    capacity = s->dv_out ? s->dv_out->size : 0;
+    capacity = FFMAX(needed, FFMIN((size_t)INT_MAX, capacity + capacity / 2));
+    return av_buffer_realloc(&s->dv_out, capacity);
+}
+
+static int dv_out_append(MediaCodecContext *s, size_t *used,
+                         const uint8_t *data, size_t size)
+{
+    int ret;
+
+    if (!size)
+        return 0;
+    ret = dv_out_reserve(s, *used, size);
+    if (ret < 0)
+        return ret;
+    memcpy(s->dv_out->data + *used, data, size);
+    *used += size;
+    return 0;
+}
+
+static int dv_sei_value(const uint8_t **p, const uint8_t *end, size_t *value)
+{
+    *value = 0;
+    while (*p < end) {
+        unsigned byte = *(*p)++;
+        if (*value > SIZE_MAX - byte)
+            return 0;
+        *value += byte;
+        if (byte != 255)
+            return 1;
+    }
+    return 0;
+}
+
+/*
+ * Unescape a prefix/suffix SEI NAL's payload into the SEI scratch and drop its
+ * ST 2094-40 messages there. Returns 1 with the kept RBSP size in *kept (0 when
+ * the whole NAL goes) when a message was removed, 0 when the NAL is unchanged
+ * (also for anything malformed, which leaves the NAL untouched), or
+ * AVERROR(ENOMEM). Touches nothing but the scratch.
+ */
+static int dv_sei_strip(MediaCodecContext *s, const uint8_t *nal,
+                        const uint8_t *end, size_t *kept)
+{
+    const uint8_t *p, *payload_end;
+    uint8_t *rbsp;
+    size_t rbsp_size = 0;
+    unsigned zeros = 0;
+    int removed = 0;
+
+    if (end - nal < 3)
+        return 0;
+    while (end > nal + 2 && end[-1] == 0)
+        end--;
+    av_fast_malloc(&s->dv_sei_scratch, &s->dv_sei_scratch_size, end - nal);
+    if (!s->dv_sei_scratch)
+        return AVERROR(ENOMEM);
+    rbsp = s->dv_sei_scratch;
+    for (p = nal + 2; p < end; p++) {
+        if (zeros == 2) {
+            if (*p == 3) {
+                if (end - p < 2 || p[1] > 3)
+                    return 0;
+                zeros = 0;
+                continue;
+            }
+            if (*p < 3)
+                return 0;
+        }
+        rbsp[rbsp_size++] = *p;
+        zeros = *p == 0 ? zeros + 1 : 0;
+    }
+    if (!rbsp_size || rbsp[rbsp_size - 1] != 0x80)
+        return 0;
+    *kept = 0;
+    p = rbsp;
+    payload_end = rbsp + rbsp_size - 1;
+    while (p < payload_end) {
+        const uint8_t *message = p;
+        size_t type, size;
+        if (!dv_sei_value(&p, payload_end, &type) ||
+            !dv_sei_value(&p, payload_end, &size) ||
+            size > (size_t)(payload_end - p))
+            return 0;
+        if (type == 4 && size >= 7 &&
+            p[0] == 0xB5 && p[1] == 0 && p[2] == 0x3C &&
+            p[3] == 0 && p[4] == 1 && p[5] == 4 &&
+            (p[6] == 0 || p[6] == 1)) {
+            removed = 1;
+        } else {
+            size_t message_size = p - message + size;
+            memmove(rbsp + *kept, message, message_size);
+            *kept += message_size;
+        }
+        p += size;
+    }
+    return removed;
+}
+
+/* Append the NAL header bytes [region, nal + 2) and the re-escaped kept RBSP. */
+static int dv_sei_write(MediaCodecContext *s, size_t *used,
+                        const uint8_t *region, const uint8_t *nal, size_t kept)
+{
+    const uint8_t *rbsp = s->dv_sei_scratch;
+    size_t escaped_size = 0;
+    unsigned zeros = 0;
+    uint8_t *dst;
+    int ret;
+
+    s->dv_sei_scratch[kept++] = 0x80;
+    for (size_t i = 0; i < kept; i++) {
+        if (zeros == 2 && rbsp[i] <= 3) {
+            escaped_size++;
+            zeros = 0;
+        }
+        escaped_size++;
+        zeros = rbsp[i] == 0 ? zeros + 1 : 0;
+    }
+    ret = dv_out_reserve(s, *used, nal + 2 - region + escaped_size);
+    if (ret < 0)
+        return ret;
+    dst = s->dv_out->data + *used;
+    memcpy(dst, region, nal + 2 - region);
+    dst += nal + 2 - region;
+    zeros = 0;
+    for (size_t i = 0; i < kept; i++) {
+        if (zeros == 2 && rbsp[i] <= 3) {
+            *dst++ = 3;
+            zeros = 0;
+        }
+        *dst++ = rbsp[i];
+        zeros = rbsp[i] == 0 ? zeros + 1 : 0;
+    }
+    *used = dst - s->dv_out->data;
+    return 0;
+}
+
+/*
+ * Rewrite an Annex-B access unit in one pass; native DV keeps BL+EL+RPU
+ * intact. The packet is only materialized once a NAL actually changes: the
+ * unchanged run before it is copied in bulk, and an access unit that needs no
+ * change is left exactly as it came, without allocating or copying. This runs
+ * on the decoder thread for every access unit of a Dolby Vision session,
+ * right before the copy into the codec input buffer.
+ */
+static int dv_filter_packet(AVCodecContext *avctx, AVPacket *pkt)
+{
+    MediaCodecContext *s = avctx->priv_data;
+    const uint8_t *data, *end, *sc, *keep;
+    size_t out_size = 0;
+    int changed = 0, ret;
+
+    if (!pkt->size)
+        return 0;
+    data = pkt->data;
+    end = data + pkt->size;
+    keep = data; // start of the unchanged run not yet in the output
+
+    sc = dv_next_startcode(data, end);
+    while (sc < end) {
+        const uint8_t *nal = sc + 3;
+        const uint8_t *region = sc, *next_sc, *next_region;
+        int type, drop = 0;
+        size_t kept = 0;
+
+        if (region > data && region[-1] == 0)
+            region--;
+        next_sc = dv_next_startcode(nal, end);
+        next_region = next_sc;
+        if (next_region > nal && next_region < end && next_region[-1] == 0)
+            next_region--;
+        type = next_region - nal >= 2 ? (nal[0] >> 1) & 0x3f : -1;
+
+        if ((type == 63 && s->dv_filter != DV_FILTER_NONE) ||
+            (type == 62 && s->dv_filter == DV_FILTER_STRIP)) {
+            drop = 1;
+        } else if ((type == 39 || type == 40) && s->dv_strip_hdr10plus) {
+            ret = dv_sei_strip(s, nal, next_region, &kept);
+            if (ret < 0)
+                return ret;
+            drop = ret;
+        } else if (type == 62 && s->dv_filter == DV_FILTER_CONVERT) {
+            // DV_FILTER_CONVERT is only ever selected with libdovi.
+            drop = 1;
+        }
+        if (!drop) {
+            sc = next_sc;
+            continue;
+        }
+
+        if (!changed) {
+            /* The output is at most the input plus a converted RPU. */
+            ret = dv_out_reserve(s, 0, pkt->size);
+            if (ret < 0)
+                return ret;
+            changed = 1;
+        }
+        ret = dv_out_append(s, &out_size, keep, region - keep);
+        if (ret < 0)
+            return ret;
+        keep = next_region;
+
+        if (type == 39 || type == 40) {
+            if (kept) {
+                ret = dv_sei_write(s, &out_size, region, nal, kept);
+                if (ret < 0)
+                    return ret;
+            }
+        } else if (type == 62 && s->dv_filter == DV_FILTER_CONVERT) {
+            static const uint8_t sc4[4] = { 0, 0, 0, 1 };
+            uint8_t *p81 = NULL;
+            size_t p81_size = 0;
+
+            ret = 0;
+            if (ff_dovi_convert_p7_rpu_to_p81(nal, next_region - nal,
+                                              &p81, &p81_size, avctx) >= 0) {
+                ret = dv_out_append(s, &out_size, sc4, sizeof(sc4));
+                if (ret >= 0)
+                    ret = dv_out_append(s, &out_size, p81, p81_size);
+            }
+            av_free(p81);
+            if (ret < 0)
+                return ret;
+        }
+        sc = next_sc;
+    }
+
+    if (!changed)
+        return 0;
+    ret = dv_out_append(s, &out_size, keep, end - keep);
+    if (ret < 0)
+        return ret;
+    if (!out_size) {
+        av_packet_unref(pkt);
+        return 0;
+    }
+    memset(s->dv_out->data + out_size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    av_buffer_unref(&pkt->buf);
+    pkt->buf = av_buffer_ref(s->dv_out);
+    if (!pkt->buf)
+        return AVERROR(ENOMEM);
+    pkt->data = s->dv_out->data;
+    pkt->size = out_size;
+    return 0;
+}
+
+// --- end mediacodec dv filter
+#endif
+
+/*
+ * Some decoders (MediaTek OMX HEVC) default to input buffers too small for a
+ * high-bitrate IDR. Size them like ExoPlayer's getCodecMaxInputSize(); an
+ * access unit that still does not fit is dropped by ff_mediacodec_dec_send
+ * rather than split.
+ */
+static int video_max_input_size(const AVCodecContext *avctx)
+{
+    int64_t pixels = (int64_t)avctx->width * avctx->height;
+    int64_t size;
+
+    if (avctx->width <= 0 || avctx->height <= 0)
+        return 0;
+
+    switch (avctx->codec_id) {
+    case AV_CODEC_ID_H264:
+        pixels = (int64_t)FFALIGN(avctx->width, 16) * FFALIGN(avctx->height, 16);
+        size = pixels * 3 / 4;
+        break;
+    case AV_CODEC_ID_HEVC:
