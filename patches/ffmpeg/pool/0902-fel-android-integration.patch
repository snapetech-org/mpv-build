+static void JNICALL mediacodec_jni_onError(JNIEnv *env, jclass cls,
+                                           jlong handle, jint error_code,
+                                           jstring diagnostic)
+{
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)(intptr_t)handle;
+    char *detail = diagnostic ? ff_jni_jstring_to_utf_chars(env, diagnostic, codec) : NULL;
+    // CodecException carries a vendor error code, not a status the platform
+    // maps for us; the diagnostic string is what names it.
+    codec->async_cb.onAsyncError(&codec->api, codec->async_userdata,
+                                 AVERROR_EXTERNAL, detail ? detail : "CodecException");
+    av_free(detail);
+}
