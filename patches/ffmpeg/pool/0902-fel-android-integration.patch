+// Repoint a live decoder at another surface. The codec takes its own
+// reference; ours replaces the configure-time one so the old Surface can be
+// dropped by its owner the moment this returns. Called with the registry
+// locked, from whichever thread owns the surface — MediaCodec serializes it
+// against the decoding thread's own calls.
+int ff_mediacodec_dec_set_surface(MediaCodecDecContext *s, void *surface,
+                                  void *native_window)
+{
+    FFANativeWindow *next, *prev;
+    int ret;
+
+    if (!s->codec || !s->surface)
+        return AVERROR(EINVAL);
+    next = ff_mediacodec_surface_ref(surface, native_window, s->codec);
+    if (!next)
+        return AVERROR(ENOMEM);
+    ret = ff_AMediaCodec_setOutputSurface(s->codec, next);
+    if (ret < 0) {
+        ff_mediacodec_surface_unref(next, s->codec);
+        return ret;
+    }
+    prev = s->surface;
+    s->surface = next;
+    ff_mediacodec_surface_unref(prev, s->codec);
+    av_log(s->codec, AV_LOG_VERBOSE, "Output surface replaced by %p\n", next);
+    return 0;
+}
