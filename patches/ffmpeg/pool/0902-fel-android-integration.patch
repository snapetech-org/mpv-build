diff --git a/libavcodec/mediacodec.h b/libavcodec/mediacodec.h
index 5382302..06113cf 100644
--- a/libavcodec/mediacodec.h
+++ b/libavcodec/mediacodec.h
@@ -102,4 +102,141 @@ int av_mediacodec_release_buffer(AVMediaCodecBuffer *buffer, int render);
  */
 int av_mediacodec_render_buffer_at_time(AVMediaCodecBuffer *buffer, int64_t time);
 
+/**
+ * The presentation time the codec attached to this output buffer, in
+ * microseconds: the value a later AVMediaCodecRendered.media_time_us reports
+ * for it.
+ */
+int64_t av_mediacodec_buffer_get_pts(const AVMediaCodecBuffer *buffer);
+
+/**
+ * When an output buffer moved through the decoder, as CLOCK_MONOTONIC
+ * nanoseconds (the clock releaseOutputBuffer(int, long) takes); a time that
+ * is not known is 0.
+ */
+typedef struct AVMediaCodecBufferTiming {
+    /** The access unit carrying this frame's timestamp was queued to the codec. */
+    int64_t input_ns;
+    /** The codec reported the decoded buffer: its output callback in
+     *  asynchronous mode, the dequeue itself otherwise. */
+    int64_t output_ns;
+    /** The decoder handed the buffer to the caller. */
+    int64_t dequeue_ns;
+    /** Decoded buffers still waiting in the output queue at that hand-off,
+     *  -1 when the codec runs synchronously and the queue is its own. */
+    int queued_outputs;
+    /** Output buffers the caller held, unreleased, at that hand-off. */
+    int held_buffers;
+} AVMediaCodecBufferTiming;
+
+/**
+ * How `buffer` moved through the decoder, for the caller's diagnostics.
+ *
+ * @return 0 on success, AVERROR(ENOSYS) where MediaCodec is not built in.
+ */
+int av_mediacodec_buffer_get_timing(const AVMediaCodecBuffer *buffer,
+                                    AVMediaCodecBufferTiming *timing);
+
+/**
+ * One frame the surface has rendered, as reported by the platform's
+ * frame-rendered callback: the presentation time it was queued with and the
+ * `System#nanoTime()` (CLOCK_MONOTONIC) instant of the render. Delivery is
+ * informational, may be batched and delayed, and may skip frames.
+ */
+typedef struct AVMediaCodecRendered {
+    int64_t media_time_us;
+    int64_t system_nano;
+} AVMediaCodecRendered;
+
+/**
+ * Drain, in delivery order, the frames the codec owning `buffer` has rendered
+ * since the previous drain. The codec keeps a bounded ring; when nobody
+ * drains it, the newest reports are dropped.
+ *
+ * @return the number of entries written to `out`, or AVERROR(ENOSYS) when
+ * this codec delivers no feedback (see av_mediacodec_rendered_source).
+ */
+int av_mediacodec_drain_rendered(AVMediaCodecBuffer *buffer,
+                                 AVMediaCodecRendered *out, int max);
+
+/**
+ * Where the rendered-frame feedback of the codec owning `buffer` comes from:
+ * "jni" when MediaCodec.setOnFrameRenderedListener is registered through the
+ * application's callback bridge class (jni.h), "ndk" when
+ * AMediaCodec_setOnFrameRenderedCallback is, otherwise an "off:" reason —
+ * "off:api" (no bridge class on the Java wrapper, or the platform predates
+ * the listener: Java API 23, NDK Android 13), "off:codec" (the codec refused
+ * the callback), "off:surface" (no output surface).
+ */
+const char *av_mediacodec_rendered_source(const AVMediaCodecBuffer *buffer);
+
+/**
+ * Register the host's wakeup, and report the mode the codec runs in.
+ *
+ * A MediaCodec decoder blocks its caller while its hardware is busy. With a
+ * wakeup registered it holds the caller only for its normal bounded dequeues:
+ * a codec that cannot take or produce a buffer answers EAGAIN from both
+ * avcodec_send_packet() and avcodec_receive_frame(), which libavcodec's
+ * contract otherwise forbids, and the decoder calls `wakeup` once asking
+ * again can make progress. The host asks again when woken and otherwise
+ * leaves the decoder alone. An asynchronous codec reports progress itself. A
+ * synchronous one reports nothing, so the host is woken at once while the
+ * codec may still be working; once it has handed out nothing for a second
+ * while the host holds some of its output buffers (a paused player), only
+ * the host giving one back wakes it. Without a wakeup the decoder keeps the
+ * blocking contract.
+ *
+ * `wakeup` may be called from a codec-owned thread, from the thread that
+ * gives an output buffer back, or from inside the host's own call into the
+ * decoder; unregistering (NULL) returns only once no call is still on its
+ * way, so the opaque may be freed after it.
+ *
+ * @return 1 when the codec runs asynchronously, 0 when synchronously, or
+ * AVERROR(ENOSYS) when `avctx` is not an opened MediaCodec decoder.
+ */
+int av_mediacodec_set_wakeup_callback(AVCodecContext *avctx,
+                                      void (*wakeup)(void *opaque), void *opaque);
+
+/**
+ * Re-declare the operating rate (MediaFormat "operating-rate", in frames
+ * per second) of a running MediaCodec decoder without reconfiguring it.
+ * Vendors use the rate to pick the codec's clock; whether a running
+ * component takes a new value is vendor-defined, and a component that
+ * ignores it reports no error, so the effect is only ever confirmed by
+ * measuring decode time. A decoder running the media3_rate option (by
+ * default MediaTek's and MStar's) sets its own rate and ignores this call,
+ * returning 0.
+ *
+ * @return 0 when the platform accepted the parameter, AVERROR(ENOSYS) when
+ * `avctx` is not an opened MediaCodec decoder or the platform predates
+ * runtime parameters (Java API 19, NDK API 26), another negative value
+ * otherwise.
+ */
+int av_mediacodec_set_operating_rate(AVCodecContext *avctx, int rate);
+
+/**
+ * Frames a MediaCodec decoder shed before decoding them, on the host's
+ * AVDISCARD_NONREF request (avctx->skip_frame): `performed` is the lifetime
+ * count, `pending` how many of them the codec has not yet shown to be
+ * past — an output at or after a shed frame's time retires it. A host
+ * pacing its requests subtracts `pending` from how far behind it is.
+ *
+ * @return 0, or AVERROR(ENOSYS) when `avctx` is not a MediaCodec decoder.
+ */
+int av_mediacodec_input_drop_stats(AVCodecContext *avctx,
+                                   int64_t *performed, int *pending);
+
+/**
+ * Repoint every decoder opened from the MediaCodec hardware device `device_ref`
+ * at `surface` (an android.view.Surface jobject) without recreating it, and
+ * make `surface` the one later decoders on that device configure with.
+ * Buffers already dequeued from the codec render to the new surface when
+ * released.
+ *
+ * @return 0 on success, AVERROR(ENOSYS) when the platform cannot repoint a
+ * running decoder (Java API < 23, NDK API < 26), another negative value when
+ * a codec refused the surface — the device context is then left unchanged.
+ */
+int av_mediacodec_hwdevice_set_surface(AVBufferRef *device_ref, void *surface);
+
 #endif /* AVCODEC_MEDIACODEC_H */
