+// The application's callback bridge class (jni.h): resolved once per
+// process from the class av_jni_set_mediacodec_callback_class registered,
+// with the natives below bound to it. The class reference stays the
+// application's.
+struct JNIMediaCodecCallbackBridge {
+    jclass cls;
+    jmethodID init_id;
+    jmethodID handler_id;
+    jmethodID release_id;
+    int state; // 0 unresolved, 1 ready, -1 unusable
+};
