+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <string.h>
+
+#include "libavutil/avutil.h"
+
+#include "hevc/hevc.h"
+#include "mediacodec_reorder.h"
+
+enum {
+    SLOT_PENDING, // queued, not output yet
+    SLOT_OUTPUT,  // output
+    SLOT_LEADING, // a RASL picture the decoder is expected to skip
+    SLOT_GONE,    // written off: will not be output
+};
+
+// Whether a slot's timestamp belongs to a frame that is or will be output.
+static int expected(const MediaCodecReorderSlot *s)
+{
+    return s->state == SLOT_PENDING || s->state == SLOT_OUTPUT;
+}
+
+// The reorder bound when the stream states none, and how many later-decoded
+// frames may be output before a frame that is still coming: the largest DPB
+// either H.264 or HEVC allows, and the longest B-frame run x264 and x265 write.
+#define MAX_PICTURES 16
+
+static MediaCodecReorderSlot *slot_at(MediaCodecReorder *r, int i)
+{
+    return &r->slot[(r->head + i) % FF_MEDIACODEC_REORDER_SLOTS];
+}
+
+static void reorder_off(MediaCodecReorder *r, const char *reason)
+{
+    r->mode = FF_MEDIACODEC_REORDER_OFF;
+    r->off_reason = reason;
+    r->head = r->count = r->next = 0;
+}
+
+void ff_mediacodec_reorder_init(MediaCodecReorder *r, int depth, int hevc, int enabled)
+{
+    memset(r, 0, sizeof(*r));
+    r->depth = depth > 0 ? depth : MAX_PICTURES;
+    if (r->depth > MAX_PICTURES)
+        r->depth = MAX_PICTURES;
+    r->hevc = hevc;
+    ff_mediacodec_reorder_flush(r);
+    if (!enabled)
+        reorder_off(r, "not a reordering video decoder");
+}
+
+void ff_mediacodec_reorder_flush(MediaCodecReorder *r)
+{
+    r->head = r->count = r->next = 0;
+    r->last_in = r->last_out = AV_NOPTS_VALUE;
+    r->new_sequence = 1;
+    r->skip_rasl = 0;
+}
+
+// The offset of the NAL unit that starts at or after *pos, with *pos moved
+// past its start code; -1 when there is none. Only NAL headers are read,
+// which never hold an emulation prevention byte.
+static int next_nal(const uint8_t *data, int size, int *pos)
+{
+    for (int i = *pos; i + 3 <= size; i++) {
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) {
+            *pos = i + 3;
+            return i + 3;
+        }
+    }
+    *pos = size;
+    return -1;
+}
+
+// Follows random access through one HEVC access unit and returns whether it
+// is a RASL picture the decoder will not output: one associated with a BLA
+// picture, or with the CRA picture decoding started from (the first IRAP
+// after a flush or an end of sequence, where NoRaslOutputFlag is 1).
+static int hevc_rasl_not_output(MediaCodecReorder *r, const uint8_t *data, int size)
+{
+    int pos = 0, nal, picture = -1, end_of_sequence = 0, not_output = 0;
+
+    while ((nal = next_nal(data, size, &pos)) >= 0) {
+        int type, layer_id;
+        if (nal + 2 > size)
+            break;
+        type     = (data[nal] >> 1) & 0x3f;
+        layer_id = ((data[nal] & 1) << 5) | (data[nal + 1] >> 3);
+        if (type == HEVC_NAL_EOS_NUT || type == HEVC_NAL_EOB_NUT)
+            end_of_sequence = 1;
+        else if (picture < 0 && layer_id == 0 && type <= HEVC_NAL_RSV_VCL31)
+            picture = type;
+    }
+
+    if (picture >= HEVC_NAL_BLA_W_LP && picture <= HEVC_NAL_RSV_IRAP_VCL23) {
+        r->skip_rasl = picture <= HEVC_NAL_BLA_N_LP ||
+                       (picture == HEVC_NAL_CRA_NUT && r->new_sequence);
+        r->new_sequence = 0;
+    } else if (picture == HEVC_NAL_RASL_N || picture == HEVC_NAL_RASL_R) {
+        not_output = r->skip_rasl;
+    }
+    // An end of sequence ends this access unit; the next IRAP starts over.
+    if (end_of_sequence)
+        r->new_sequence = 1;
+    return not_output;
+}
+
+void ff_mediacodec_reorder_input(MediaCodecReorder *r, int64_t pts,
+                                 const uint8_t *data, int size)
+{
+    MediaCodecReorderSlot *s;
+    int not_output = 0;
+
+    if (r->mode == FF_MEDIACODEC_REORDER_OFF)
+        return;
+    if (r->hevc && data && !r->rasl_output)
+        not_output = hevc_rasl_not_output(r, data, size);
+    if (pts == AV_NOPTS_VALUE) {
+        reorder_off(r, "an access unit has no timestamp");
+        return;
+    }
+    // Well-formed B-frame timestamps step back in decode order; so does a
+    // discontinuity. Either way the container's own timestamps stand.
+    if (r->last_in != AV_NOPTS_VALUE && pts <= r->last_in) {
+        reorder_off(r, "timestamps do not increase in decode order");
+        return;
+    }
+    if (r->count == FF_MEDIACODEC_REORDER_SLOTS) {
+        reorder_off(r, "too many frames in flight");
+        return;
+    }
+    r->last_in = pts;
+    s = slot_at(r, r->count++);
+    s->pts   = pts;
+    s->state = not_output ? SLOT_LEADING : SLOT_PENDING;
+    r->leading += not_output;
+}
+
+// Ring position of the slot holding the timestamp of `rank` among the slots
+// still expected to be output; r->count when there is none.
+static int rank_position(MediaCodecReorder *r, int rank)
+{
+    for (int i = 0; i < r->count; i++) {
+        if (!expected(slot_at(r, i)))
+            continue;
+        if (!rank--)
+            return i;
+    }
+    return r->count;
+}
+
+// Writes off the pending frames that can no longer be output: more of the
+// frames before `found` in decode order are missing than may follow it in
+// output order, or more later-decoded frames have been output than may pass
+// a frame that is still coming.
+static void write_off_missing(MediaCodecReorder *r, int found, int missing)
+{
+    int later = 0;
+
+    for (int i = 0; i < found && missing > r->depth; i++) {
+        MediaCodecReorderSlot *s = slot_at(r, i);
+        if (s->state == SLOT_PENDING) {
+            s->state = SLOT_GONE;
+            missing--;
+            r->dropped++;
+        }
+    }
+    for (int i = r->count - 1; i >= 0; i--) {
+        MediaCodecReorderSlot *s = slot_at(r, i);
+        if (s->state == SLOT_OUTPUT) {
+            later++;
+        } else if (s->state == SLOT_PENDING && later > MAX_PICTURES) {
+            s->state = SLOT_GONE;
+            r->dropped++;
+        }
+    }
+}
+
+// Drops the front slots no output needs any more: written off, or output with
+// their timestamp already handed out.
+static void trim(MediaCodecReorder *r)
+{
+    while (r->count) {
+        MediaCodecReorderSlot *s = slot_at(r, 0);
+        if (s->state == SLOT_PENDING)
+            break;
+        if (s->state == SLOT_OUTPUT) {
+            // The front slot expected to be output has rank 0.
+            if (!r->next)
+                break;
+            r->next--;
+        }
+        r->head = (r->head + 1) % FF_MEDIACODEC_REORDER_SLOTS;
+        r->count--;
+    }
+}
+
+int64_t ff_mediacodec_reorder_output(MediaCodecReorder *r, int64_t pts)
+{
+    int found = -1, missing = 0, at;
+    int64_t out = pts;
+
+    if (r->mode == FF_MEDIACODEC_REORDER_OFF || pts == AV_NOPTS_VALUE)
+        return pts;
+
+    // Queued in increasing order yet output going backwards: the decoder
+    // reordered frames whose timestamps were in decode order.
+    if (r->mode == FF_MEDIACODEC_REORDER_ARMED &&
+        r->last_out != AV_NOPTS_VALUE && pts < r->last_out)
+        r->mode = FF_MEDIACODEC_REORDER_ON;
+    r->last_out = pts;
+
+    // This frame's slot: the first with its timestamp not yet output.
+    for (int i = 0; i < r->count; i++) {
+        MediaCodecReorderSlot *s = slot_at(r, i);
+        if (s->state != SLOT_OUTPUT && s->pts == pts) {
+            found = i;
+            break;
+        }
+    }
+    if (found >= 0) {
+        MediaCodecReorderSlot *s = slot_at(r, found);
+        int ranked = rank_position(r, r->next);
+
+        if (s->state == SLOT_LEADING) {
+            // The decoder outputs RASL pictures after all: every one taken
+            // out is coming, and none will be taken out from now on. Each
+            // lying before the slot the next timestamp comes from moves that
+            // rank up by one.
+            for (int i = 0; i < r->count; i++) {
+                MediaCodecReorderSlot *l = slot_at(r, i);
+                if (l->state == SLOT_LEADING) {
+                    l->state = SLOT_PENDING;
+                    r->next += i < ranked;
+                    r->readmitted++;
+                }
+            }
+            r->rasl_output = 1;
+        } else if (s->state == SLOT_GONE) {
+            // Written off, yet output: count it back in.
+            r->next += found < ranked;
+            r->readmitted++;
+        }
+        s->state = SLOT_OUTPUT;
+        for (int i = 0; i < found; i++)
+            missing += slot_at(r, i)->state == SLOT_PENDING;
+        write_off_missing(r, found, missing);
+    }
+
+    at = rank_position(r, r->next);
+    if (at < r->count) {
+        if (r->mode == FF_MEDIACODEC_REORDER_ON) {
+            out = slot_at(r, at)->pts;
+            r->recovered++;
+        }
+        r->next++;
+    }
+    trim(r);
+    return out;
+}
diff --git a/libavcodec/mediacodec_reorder.h b/libavcodec/mediacodec_reorder.h
new file mode 100644
index 0000000..16825cb
--- /dev/null
+++ b/libavcodec/mediacodec_reorder.h
@@ -0,0 +1,124 @@
+/*
+ * Android MediaCodec presentation-order recovery
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef AVCODEC_MEDIACODEC_REORDER_H
+#define AVCODEC_MEDIACODEC_REORDER_H
+
+#include <stdint.h>
+
+/*
+ * A container that stores B-frame video without composition offsets (an MP4
+ * with no ctts box, the product of remuxing a raw H.264/HEVC stream with
+ * generated timestamps) hands every access unit a timestamp in decode order.
+ * MediaCodec echoes each frame's queued timestamp back with the frame, so in
+ * presentation order those timestamps run backwards on every reordered frame.
+ * A libavcodec decoder recovers because its frames also carry the packet DTS
+ * and the player falls back to it; a MediaCodec frame has no DTS, so the
+ * player drops the frames it sees going backwards and falls ever further
+ * behind its audio.
+ *
+ * The module watches for exactly that stream: timestamps strictly increasing
+ * in decode order while the decoder's output steps backwards. Once seen, each
+ * frame is presented at the queued timestamps taken in increasing order, the
+ * order a decoder outputs frames in, which is what VLC does for the same
+ * files. A stream that ever queues a timestamp at or below its predecessor
+ * orders its own timestamps (or is discontinuous), and the module then stays
+ * out of the way for the rest of the session.
+ *
+ * Frames the decoder never outputs would shift every later assignment, so
+ * they are taken out of the timeline: HEVC RASL pictures that follow the
+ * random access point decoding started from are known not to be output when
+ * they are queued, and any other frame is written off once more frames that
+ * precede it in decode order are missing than the stream's reorder bound
+ * allows to follow a frame in output order.
+ *
+ * Timestamps are in microseconds as queued to the codec, untagged;
+ * AV_NOPTS_VALUE marks an access unit without one. The decoding thread owns
+ * the state.
+ */
+
+#define FF_MEDIACODEC_REORDER_SLOTS 64
+
+enum MediaCodecReorderMode {
+    FF_MEDIACODEC_REORDER_OFF   = -1, // settled: timestamps pass through
+    FF_MEDIACODEC_REORDER_ARMED =  0, // watching; timestamps pass through
+    FF_MEDIACODEC_REORDER_ON    =  1, // frames get the queued timestamps in order
+};
+
+typedef struct MediaCodecReorderSlot {
+    int64_t pts;
+    uint8_t state;   // pending, output, taken out as a RASL picture, or written off
+} MediaCodecReorderSlot;
+
+typedef struct MediaCodecReorder {
+    int mode;
+    const char *off_reason;  // why the mode is OFF, NULL otherwise
+    int depth;               // frames that may follow a later-decoded one in output
+    int hevc;                // recognise HEVC leading pictures
+    int64_t last_in;         // last queued timestamp since the flush
+    int64_t last_out;        // last output timestamp since the flush
+
+    // HEVC random access: the next IRAP picture starts decoding (first after a
+    // flush or an end of sequence), whether the current IRAP's RASL pictures
+    // are output, and whether this decoder outputs the RASL pictures it should
+    // skip (then none are taken out when queued).
+    int new_sequence;
+    int skip_rasl;
+    int rasl_output;
+
+    // Queued frames in decode order, which is also timestamp order. `next` is
+    // the rank, among the slots still expected to be output, of the timestamp
+    // the next output frame is given.
+    MediaCodecReorderSlot slot[FF_MEDIACODEC_REORDER_SLOTS];
+    int head, count;
+    int next;
+
+    // Lifetime counters.
+    uint64_t recovered;  // frames given a recovered timestamp
+    uint64_t leading;    // RASL pictures taken out when queued
+    uint64_t dropped;    // frames written off by the reorder bounds
+    uint64_t readmitted; // frames taken or written off that were output after all
+} MediaCodecReorder;
+
+/**
+ * @param depth    the stream's reorder bound (sps_max_num_reorder_pics,
+ *                 num_reorder_frames, has_b_frames); <= 0 when unknown
+ * @param hevc     the stream is HEVC (leading pictures are recognised)
+ * @param enabled  0 leaves the module off for the whole session
+ */
+void ff_mediacodec_reorder_init(MediaCodecReorder *r, int depth, int hevc, int enabled);
+
+/** The codec was flushed: every queued frame is gone. The mode is kept. */
+void ff_mediacodec_reorder_flush(MediaCodecReorder *r);
+
+/**
+ * An access unit was queued to the codec with timestamp `pts`. `data`/`size`
+ * is the Annex B access unit (used for HEVC leading pictures; may be NULL).
+ */
+void ff_mediacodec_reorder_input(MediaCodecReorder *r, int64_t pts,
+                                 const uint8_t *data, int size);
+
+/**
+ * The codec output a frame with timestamp `pts`; call once per frame, in
+ * output order. Returns the timestamp to present it at.
+ */
+int64_t ff_mediacodec_reorder_output(MediaCodecReorder *r, int64_t pts);
+
+#endif /* AVCODEC_MEDIACODEC_REORDER_H */
diff --git a/libavcodec/mediacodec_shed.c b/libavcodec/mediacodec_shed.c
new file mode 100644
index 0000000..9e6f7e6
--- /dev/null
+++ b/libavcodec/mediacodec_shed.c
@@ -0,0 +1,491 @@
+/*
+ * Android MediaCodec pre-decode frame shedding
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * FFmpeg is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include "config_components.h"
+
+#include <stdint.h>
+#include <string.h>
+
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+
+#include "avcodec.h"
+#if CONFIG_AV1_MEDIACODEC_DECODER
+#include "av1.h"
+#include "cbs.h"
+#include "cbs_av1.h"
+#endif
+#include "h264.h"
+#include "hevc/hevc.h"
+#include "mediacodec_shed.h"
+#include "packet.h"
+
+// --- H.264 / HEVC ------------------------------------------------------------
+//
+// The packets a MediaCodec decoder is fed are Annex B (the wrapper's bitstream
+// filter converts length-prefixed streams). Only the NAL headers are read, and
+// those bytes can never hold an emulation prevention byte, so no unescaping.
+
+// The offset of the NAL unit that starts at or after *pos, with *pos moved
+// past it; -1 when there is none.
+static int annexb_next_nal(const uint8_t *data, int size, int *pos)
+{
+    int i = *pos;
+    while (i + 3 <= size) {
+        if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1) {
+            *pos = i + 3;
+            return i + 3;
+        }
+        i++;
+    }
+    *pos = size;
+    return -1;
+}
+
+int ff_mediacodec_shed_h264_droppable(const uint8_t *data, int size)
+{
+    int pos = 0, nal, slices = 0;
+
+    while ((nal = annexb_next_nal(data, size, &pos)) >= 0) {
+        int ref_idc, type;
+        if (nal >= size)
+            return 0;
+        ref_idc = (data[nal] >> 5) & 3;
+        type    =  data[nal] & 0x1f;
+        switch (type) {
+        case H264_NAL_SLICE:
+        case H264_NAL_DPA:
+        case H264_NAL_DPB:
+        case H264_NAL_DPC:
+        case H264_NAL_IDR_SLICE:
+            if (ref_idc)
+                return 0;
+            slices++;
+            break;
+        // Parameter sets and the SVC/MVC extension carriers ride along
+        // with pictures: never lose them, and never reason about layered
+        // streams from the base layer's ref_idc alone.
+        case H264_NAL_SPS:
+        case H264_NAL_PPS:
+        case H264_NAL_SPS_EXT:
+        case H264_NAL_PREFIX:
+        case H264_NAL_SUB_SPS:
+        case H264_NAL_DPS:
+        case H264_NAL_AUXILIARY_SLICE:
+        case H264_NAL_EXTEN_SLICE:
+        case H264_NAL_DEPTH_EXTEN_SLICE:
+            return 0;
+        default:
+            break;
+        }
+    }
+    return slices > 0;
+}
+
+// Table 7-1's sub-layer non-reference types: samples of these pictures are
+// never used for inter prediction by later pictures of the same sub-layer.
+// (Mirrors ff_hevc_nal_is_nonref; kept local so the classifier stays free
+// of the decoder's headers.)
+static int hevc_nal_is_sub_layer_nonref(int type)
+{
+    switch (type) {
+    case HEVC_NAL_TRAIL_N:
+    case HEVC_NAL_TSA_N:
+    case HEVC_NAL_STSA_N:
+    case HEVC_NAL_RADL_N:
+    case HEVC_NAL_RASL_N:
+    case HEVC_NAL_VCL_N10:
+    case HEVC_NAL_VCL_N12:
+    case HEVC_NAL_VCL_N14:
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+// A sub-layer non-reference picture may still be referenced by pictures of
+// a *higher* sub-layer, so only pictures of the highest sub-layer the SPS
+// declares are safe to shed. *max_sub_layers_minus1 follows any SPS in the
+// access unit (and an access unit carrying parameter sets is always kept).
+int ff_mediacodec_shed_hevc_droppable(const uint8_t *data, int size,
+                                      int *max_sub_layers_minus1)
+{
+    int pos = 0, nal, slices = 0;
+
+    while ((nal = annexb_next_nal(data, size, &pos)) >= 0) {
+        int type, layer_id, temporal_id;
+        if (nal + 2 > size)
+            return 0;
+        type        = (data[nal] >> 1) & 0x3f;
+        layer_id    = ((data[nal] & 1) << 5) | (data[nal + 1] >> 3);
+        temporal_id = (data[nal + 1] & 7) - 1;
+        if (temporal_id < 0)
+            return 0;
+        if (type == HEVC_NAL_SPS) {
+            // sps_video_parameter_set_id(4) sps_max_sub_layers_minus1(3) ...
+            if (nal + 3 <= size && layer_id == 0)
+                *max_sub_layers_minus1 = (data[nal + 2] >> 1) & 7;
+            return 0;
+        }
+        if (type == HEVC_NAL_VPS || type == HEVC_NAL_PPS)
+            return 0;
+        if (type <= HEVC_NAL_RSV_VCL31) {
+            if (layer_id != 0)
+                return 0;
+            if (!hevc_nal_is_sub_layer_nonref(type))
+                return 0;
+            if (*max_sub_layers_minus1 < 0 || temporal_id != *max_sub_layers_minus1)
+                return 0;
+            slices++;
+        }
+    }
+    return slices > 0;
+}
+
+// --- VP9 -----------------------------------------------------------------------
+
+typedef struct ShedBits {
+    const uint8_t *data;
+    int size;
+    int pos; // in bits
+} ShedBits;
+
+static unsigned shed_bits_read(ShedBits *b, int n, int *ok)
+{
+    unsigned v = 0;
+    while (n-- > 0) {
+        if (b->pos >= b->size * 8) {
+            *ok = 0;
+            return 0;
+        }
+        v = (v << 1) | ((b->data[b->pos >> 3] >> (7 - (b->pos & 7))) & 1);
+        b->pos++;
+    }
+    return v;
+}
+
+// Whether the frame starting at data is a shown inter frame that refreshes
+// no reference slot: uncompressed_header() up to refresh_frame_flags, which
+// for a shown non-intra frame follows reset_frame_context directly.
+int ff_mediacodec_shed_vp9_frame_droppable(const uint8_t *data, int size)
+{
+    ShedBits b = { data, size, 0 };
+    int ok = 1, profile, frame_type, show_frame, error_resilient;
+    unsigned refresh;
+
+    if (shed_bits_read(&b, 2, &ok) != 2 || !ok)  // frame_marker
+        return 0;
+    profile  = shed_bits_read(&b, 1, &ok);
+    profile |= shed_bits_read(&b, 1, &ok) << 1;
+    if (profile == 3 && shed_bits_read(&b, 1, &ok)) // reserved_zero
+        return 0;
+    if (shed_bits_read(&b, 1, &ok))                 // show_existing_frame
+        return 0;
+    frame_type      = shed_bits_read(&b, 1, &ok);
+    show_frame      = shed_bits_read(&b, 1, &ok);
+    error_resilient = shed_bits_read(&b, 1, &ok);
+    if (!ok || frame_type == 0 || !show_frame)      // key frame; hidden frame
+        return 0;
+    // intra_only is only signalled for hidden frames, so this shown inter
+    // frame reads reset_frame_context (unless error resilient) and then
+    // refresh_frame_flags.
+    if (!error_resilient)
+        shed_bits_read(&b, 2, &ok);
+    refresh = shed_bits_read(&b, 8, &ok);
+    return ok && refresh == 0;
+}
+
+// A superframe index (Annex B of the VP9 spec) trails the frames it lists:
+// marker byte, N sizes of M bytes each (little endian), the same marker.
+static int vp9_superframe_index(const uint8_t *data, int size,
+                                int *frames, int *mag, int *index_size)
+{
+    uint8_t marker;
+    if (size < 1)
+        return 0;
+    marker = data[size - 1];
+    if ((marker & 0xe0) != 0xc0)
+        return 0;
+    *frames = (marker & 7) + 1;
+    *mag = ((marker >> 3) & 3) + 1;
+    *index_size = 2 + *mag * *frames;
+    if (size < *index_size || data[size - *index_size] != marker)
+        return 0;
+    return 1;
+}
+
+// Shed the shown frame of a VP9 packet. A superframe keeps its leading
+// (hidden reference) frames and gets its index rewritten in place for one
+// frame fewer; a plain frame packet is emptied.
+int ff_mediacodec_shed_vp9_packet(AVPacket *pkt)
+{
+    int frames = 1, mag = 0, index_size = 0;
+    int i, kept = 0, last_offset, last_size;
+    uint32_t sizes[8];
+
+    if (pkt->size <= 0)
+        return 0;
+    if (vp9_superframe_index(pkt->data, pkt->size, &frames, &mag, &index_size)) {
+        const uint8_t *idx = pkt->data + pkt->size - index_size + 1;
+        int total = 0;
+        for (i = 0; i < frames; i++) {
+            uint32_t sz = 0;
+            for (int j = 0; j < mag; j++)
+                sz |= (uint32_t)idx[i * mag + j] << (8 * j);
+            sizes[i] = sz;
+            total += sz;
+            if (sz == 0 || total > pkt->size - index_size)
+                return 0;
+        }
+        if (total != pkt->size - index_size)
+            return 0;
+        for (i = 0; i < frames - 1; i++)
+            kept += sizes[i];
+        last_offset = kept;
+        last_size = sizes[frames - 1];
+    } else {
+        last_offset = 0;
+        last_size = pkt->size;
+    }
+
+    if (!ff_mediacodec_shed_vp9_frame_droppable(pkt->data + last_offset, last_size))
+        return 0;
+
+    if (frames == 1) {
+        pkt->size = 0;
+        return 1;
+    }
+    if (frames == 2) {
+        // The packet's buffer may be shared with the demuxer: shorten the
+        // view, never touch the bytes past it.
+        pkt->size = kept;
+        return 1;
+    }
+    // Rebuild the index for frames - 1 entries behind the kept frames. It is
+    // shorter than the old one and the removed frame freed at least a byte,
+    // so it fits in place.
+    if (av_packet_make_writable(pkt) < 0)
+        return AVERROR(ENOMEM);
+    {
+        int n = frames - 1;
+        uint8_t marker = 0xc0 | ((mag - 1) << 3) | (n - 1);
+        uint8_t *w = pkt->data + kept;
+        *w++ = marker;
+        for (i = 0; i < n; i++)
+            for (int j = 0; j < mag; j++)
+                *w++ = (sizes[i] >> (8 * j)) & 0xff;
+        *w++ = marker;
+        pkt->size = (int)(w - pkt->data);
+    }
+    return 1;
+}
+
+#if CONFIG_AV1_MEDIACODEC_DECODER
+// --- AV1 -----------------------------------------------------------------------
+//
+// The coded-bitstream reader decomposes every OBU of a temporal unit and
+// keeps the sequence header and reference state the frame headers of later
+// units need, so it must see every packet, not only the ones being judged.
+
+static const AV1RawFrameHeader *av1_unit_frame_header(const CodedBitstreamUnit *unit)
+{
+    const AV1RawOBU *obu = unit->content;
+    if (!obu)
+        return NULL;
+    if (unit->type == AV1_OBU_FRAME)
+        return &obu->obu.frame.header;
+    if (unit->type == AV1_OBU_FRAME_HEADER)
+        return &obu->obu.frame_header;
+    return NULL;
+}
+
+// A stream the reader keeps failing on is one it will never shed; stop
+// asking after this many consecutive units rather than log every one.
+#define AV1_READ_FAILURES_TO_GIVE_UP 8
+
+// Decompose pkt into sh->frag. 0 on success; the fragment is reset on failure.
+static int av1_read(MediaCodecShedContext *sh, AVCodecContext *avctx,
+                    const AVPacket *pkt)
+{
+    int err;
+    if (!sh->cbs)
+        return AVERROR(ENOSYS);
+    err = ff_cbs_read_packet(sh->cbs, sh->frag, pkt);
+    if (err < 0) {
+        ff_cbs_fragment_reset(sh->frag);
+        if (++sh->cbs_failures >= AV1_READ_FAILURES_TO_GIVE_UP) {
+            av_log(avctx, AV_LOG_WARNING,
+                   "AV1 temporal units not decomposed (%d); frame shedding "
+                   "is off for this stream\n", err);
+            ff_cbs_close(&sh->cbs);
+        }
+        return err;
+    }
+    sh->cbs_failures = 0;
+    return 0;
+}
+
+// Shed a temporal unit whose only frame is shown and refreshes no reference
+// slot; the unit is emptied. Every temporal unit has to show exactly one
+// frame, so a unit that carries anything besides that frame -- a hidden
+// reference frame, a sequence header -- goes to the codec whole: cut down to
+// its hidden frames it would show none, and a MediaTek AV1 decoder
+// (OMX.MTK.VIDEO.DECODER.AV1) fed such units stops producing output.
+static int av1_shed(MediaCodecShedContext *sh, AVCodecContext *avctx, AVPacket *pkt)
+{
+    CodedBitstreamFragment *frag = sh->frag;
+    const AV1RawFrameHeader *hdr = NULL;
+    int last = -1;
+
+    if (av1_read(sh, avctx, pkt) < 0)
+        return 0;
+
+    for (int i = frag->nb_units - 1; i >= 0; i--) {
+        CodedBitstreamUnitType type = frag->units[i].type;
+        if (type == AV1_OBU_FRAME || type == AV1_OBU_FRAME_HEADER) {
+            last = i;
+            break;
+        }
+        if (type == AV1_OBU_TILE_GROUP || type == AV1_OBU_METADATA ||
+            type == AV1_OBU_PADDING || type == AV1_OBU_REDUNDANT_FRAME_HEADER)
+            continue;
+        break; // a tile list or something newer than this reader: keep
+    }
+    if (last >= 0)
+        hdr = av1_unit_frame_header(&frag->units[last]);
+    if (!hdr || hdr->show_existing_frame || !hdr->show_frame ||
+        hdr->refresh_frame_flags != 0 ||
+        hdr->frame_type == AV1_FRAME_KEY || hdr->frame_type == AV1_FRAME_SWITCH)
+        goto keep;
+
+    for (int i = 0; i < last; i++) {
+        CodedBitstreamUnitType type = frag->units[i].type;
+        if (type == AV1_OBU_FRAME || type == AV1_OBU_FRAME_HEADER ||
+            type == AV1_OBU_TILE_GROUP || type == AV1_OBU_TILE_LIST ||
+            type == AV1_OBU_SEQUENCE_HEADER)
+            goto keep;
+    }
+    ff_cbs_fragment_reset(frag);
+    pkt->size = 0;
+    return 1;
+
+keep:
+    ff_cbs_fragment_reset(frag);
+    return 0;
+}
+
+#endif /* CONFIG_AV1_MEDIACODEC_DECODER */
+
+// --- Entry points --------------------------------------------------------------
+
+int ff_mediacodec_shed_init(MediaCodecShedContext *sh, AVCodecContext *avctx)
+{
+    memset(sh, 0, sizeof(*sh));
+    sh->codec_id = avctx->codec_id;
+    sh->hevc_max_sub_layers_minus1 = -1;
+
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    if (avctx->codec_id == AV_CODEC_ID_AV1) {
+        int err;
+        sh->frag = av_mallocz(sizeof(*sh->frag));
+        if (!sh->frag)
+            return AVERROR(ENOMEM);
+        err = ff_cbs_init(&sh->cbs, AV_CODEC_ID_AV1, avctx);
+        if (err < 0) {
+            av_freep(&sh->frag);
+            return 0;
+        }
+        if (avctx->extradata && avctx->extradata_size > 0) {
+            // The av1C sequence header, when the container carries one; the
+            // first temporal unit repeats it anyway.
+            if (ff_cbs_read_extradata_from_codec(sh->cbs, sh->frag, avctx) < 0)
+                av_log(avctx, AV_LOG_VERBOSE, "AV1 extradata not decomposed\n");
+            ff_cbs_fragment_reset(sh->frag);
+        }
+    }
+#endif
+    return 0;
+}
+
+void ff_mediacodec_shed_flush(MediaCodecShedContext *sh)
+{
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    if (sh->cbs)
+        ff_cbs_flush(sh->cbs);
+#endif
+}
+
+void ff_mediacodec_shed_uninit(MediaCodecShedContext *sh)
+{
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    if (sh->frag) {
+        ff_cbs_fragment_free(sh->frag);
+        av_freep(&sh->frag);
+    }
+    ff_cbs_close(&sh->cbs);
+#endif
+}
+
+void ff_mediacodec_shed_observe(MediaCodecShedContext *sh, AVCodecContext *avctx,
+                                const AVPacket *pkt)
+{
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    if (sh->codec_id == AV_CODEC_ID_AV1 && sh->cbs && pkt->size > 0) {
+        if (av1_read(sh, avctx, pkt) >= 0)
+            ff_cbs_fragment_reset(sh->frag);
+    }
+#endif
+}
+
+int ff_mediacodec_shed_packet(MediaCodecShedContext *sh, AVCodecContext *avctx,
+                              AVPacket *pkt)
+{
+    if (pkt->size <= 0)
+        return 0;
+
+#if CONFIG_AV1_MEDIACODEC_DECODER
+    // The AV1 reader must see every unit, key frames first of all: that is
+    // where the sequence header it needs for everything after arrives.
+    if (sh->codec_id == AV_CODEC_ID_AV1)
+        return av1_shed(sh, avctx, pkt);
+#endif
+
+    // A key frame is a reference by construction, and the cheapest test.
+    if (pkt->flags & AV_PKT_FLAG_KEY)
+        return 0;
+
+    switch (sh->codec_id) {
+    case AV_CODEC_ID_H264:
+        if (!ff_mediacodec_shed_h264_droppable(pkt->data, pkt->size))
+            return 0;
+        pkt->size = 0;
+        return 1;
+    case AV_CODEC_ID_HEVC:
+        if (!ff_mediacodec_shed_hevc_droppable(pkt->data, pkt->size,
+                                               &sh->hevc_max_sub_layers_minus1))
+            return 0;
+        pkt->size = 0;
+        return 1;
+    case AV_CODEC_ID_VP9:
+        return ff_mediacodec_shed_vp9_packet(pkt);
+    default:
+        return 0;
+    }
+}
