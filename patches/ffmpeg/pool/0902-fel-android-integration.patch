+static int mediacodec_jni_setParameters(FFAMediaCodec *ctx, const FFAMediaFormat *params)
+{
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)ctx;
+    FFAMediaFormat *format = (FFAMediaFormat *)params;
+    JNIEnv *env = NULL;
+    jobject bundle = NULL;
+    int copied = 0;
+    int ret = 0;
+
+    if (!codec->jfields.set_parameters_id)
+        return AVERROR(ENOSYS);
+    if (!format)
+        return AVERROR(EINVAL);
+
+    JNI_GET_ENV_OR_RETURN(env, codec, AVERROR_EXTERNAL);
+
+    bundle = (*env)->NewObject(env, codec->jfields.bundle_class, codec->jfields.bundle_init_id);
+    if (ff_jni_exception_check(env, 1, codec) < 0 || !bundle)
+        return AVERROR_EXTERNAL;
+
+    for (int i = 0; i < FF_ARRAY_ELEMS(jni_codec_parameter_keys); i++) {
+        const char *key = jni_codec_parameter_keys[i].key;
+        jstring jkey;
+
+        if (jni_codec_parameter_keys[i].is_long) {
+            int64_t value;
+            if (!ff_AMediaFormat_getInt64(format, key, &value))
+                continue;
+            jkey = ff_jni_utf_chars_to_jstring(env, key, codec);
+            if (!jkey) {
+                ret = AVERROR_EXTERNAL;
+                goto done;
+            }
+            (*env)->CallVoidMethod(env, bundle, codec->jfields.bundle_put_long_id, jkey, (jlong)value);
+        } else {
+            int32_t value;
+            if (!ff_AMediaFormat_getInt32(format, key, &value))
+                continue;
+            jkey = ff_jni_utf_chars_to_jstring(env, key, codec);
+            if (!jkey) {
+                ret = AVERROR_EXTERNAL;
+                goto done;
+            }
+            (*env)->CallVoidMethod(env, bundle, codec->jfields.bundle_put_int_id, jkey, (jint)value);
+        }
+        (*env)->DeleteLocalRef(env, jkey);
+        if (ff_jni_exception_check(env, 1, codec) < 0) {
+            ret = AVERROR_EXTERNAL;
+            goto done;
+        }
+        copied++;
+    }
+
+    if (!copied) {
+        av_log(codec, AV_LOG_WARNING, "setParameters: no parameter key to apply\n");
+        ret = AVERROR(EINVAL);
+        goto done;
+    }
+
+    (*env)->CallVoidMethod(env, codec->object, codec->jfields.set_parameters_id, bundle);
+    if (ff_jni_exception_check(env, 1, codec) < 0)
+        ret = AVERROR_EXTERNAL;
+
+done:
+    (*env)->DeleteLocalRef(env, bundle);
+    return ret;
 }
 
