+/**
+ * @file
+ * AV2 low overhead OBU demuxer.
+ *
+ * AV2 OBU framing format (from dav2d parse_obus, src/obu.c):
+ *   [ULEB128 length][has_extension:1][obu_type:5][tlayer_id:2]
+ *   [optional extension: mlayer_id:3 xlayer_id:5]
+ *   [payload: length bytes - header bytes]
+ *
+ * This is different from AV1's OBU format:
+ *   AV1: [forbidden:1][type:4][ext:1][has_size:1][reserved:1][opt ext][opt size][payload]
+ *   AV2: [ULEB128 total_len][ext:1][type:5][tlayer:2][opt ext][payload]
+ *
+ * Packets are complete temporal units: a Temporal Delimiter OBU and all OBUs
+ * that follow it, up to but not including the next Temporal Delimiter. This is
+ * the same grouping the raw (Section 5) input reader of dav2d uses, and
+ * matches the one-displayed-frame-per-temporal-unit model that reader assumes
+ * when counting frames. Each OBU keeps its ULEB128 length prefix.
+ *
+ * Timestamps are generated per temporal unit, i.e. in decoding order. Frames
+ * may be output in a different (implicit) order; the decoder is responsible
+ * for mapping these timestamps onto frames in presentation order.
+ */
+
+#include "config_components.h"
+
+#include "libavutil/common.h"
+#include "libavutil/opt.h"
+#include "libavcodec/av2.h"
+#include "avformat.h"
+#include "avio_internal.h"
+#include "demux.h"
+#include "internal.h"
+
+/*
+ * Maximum bytes to peek for probe:
+ *   ULEB128 (up to 9 bytes) + 1-byte OBU header + 1-byte extension = 11 bytes
+ */
+#define MAX_AV2_OBU_HEADER_SIZE 11
+
+typedef struct AV2DemuxContext {
+    const AVClass *class;
+    AVRational    framerate;
+} AV2DemuxContext;
+
+/**
+ * Read a ULEB128 value from a byte array.
+ * @param buf       input buffer
+ * @param buf_size  available bytes
+ * @param[out] val  decoded value
+ * @return number of bytes consumed, or < 0 on error/truncation
+ */
+static int read_uleb128(const uint8_t *buf, int buf_size, uint64_t *val)
+{
+    *val = 0;
+    for (int i = 0; i < 8 && i < buf_size; i++) {
+        uint8_t byte = buf[i];
+        *val |= (uint64_t)(byte & 0x7f) << (i * 7);
+        if (!(byte & 0x80))
+            return i + 1;
+    }
+    return AVERROR_INVALIDDATA;
+}
+
+/**
+ * Parse one AV2 OBU from buf, return total OBU size (length field + content)
+ * and OBU type.
+ *
+ * AV2 OBU wire format:
+ *   ULEB128(content_length) | has_ext(1) | type(5) | tlayer(2) | [ext(8)] | payload
+ *
+ * @param[out] obu_type   OBU type field
+ * @return total packet size (ULEB128 bytes + content_length), or < 0 on error
+ */
+static int parse_av2_obu(const uint8_t *buf, int buf_size, int *obu_type)
+{
+    uint64_t content_len;
+    uint8_t hdr;
+    int leb_bytes;
+    int has_ext;
+    int min_hdr;
+
+    if (buf_size < 2)
+        return AVERROR_INVALIDDATA;
+
+    /* Read ULEB128 content length */
+    leb_bytes = read_uleb128(buf, buf_size, &content_len);
+    if (leb_bytes < 0)
+        return leb_bytes;
+    if (content_len > INT_MAX - leb_bytes)
+        return AVERROR_INVALIDDATA;
+
+    /* Parse OBU header byte (first byte of content) */
+    if (leb_bytes >= buf_size)
+        return AVERROR_INVALIDDATA;
+
+    hdr       = buf[leb_bytes];
+    has_ext   = (hdr >> 7) & 1;
+    *obu_type = (hdr >> 2) & 0x1f;  /* bits [6:2] = 5-bit type */
+    /* bits [1:0] = tlayer_id, ignored */
+
+    /* Minimum content is 1 byte header (+ 1 byte ext if present) */
+    min_hdr = 1 + has_ext;
+    if (content_len < (uint64_t)min_hdr)
+        return AVERROR_INVALIDDATA;
+
+    return leb_bytes + (int)content_len;
+}
+
+static int is_kf(int type)
+{
+    return type == AV2_OBU_CLOSED_LOOP_KF || type == AV2_OBU_OPEN_LOOP_KF;
+}
+
+//return < 0 if we need more data
+static int get_score(int type, int *seq)
+{
+    if (type == AV2_OBU_SEQUENCE_HEADER) {
+        *seq = 1;
+        return -1;
+    } else if (is_kf(type))
+        return *seq ? AVPROBE_SCORE_EXTENSION + 1 : 0;
+    return -1;
+}
+
+static int av2_probe(const AVProbeData *p)
+{
+    uint64_t content_len;
+    int leb_bytes;
+    int pos = 0;
+    int ret, hdr, type, seq = 0;
+
+    // Check that the first OBU is a Temporal Delimiter.
+    leb_bytes = read_uleb128(p->buf, p->buf_size, &content_len);
+    if (leb_bytes < 0 || !content_len)
+        return 0;
+    if (content_len > (uint64_t)(p->buf_size - leb_bytes))
+        return 0;
+
+    hdr  = p->buf[leb_bytes];
+    type = (hdr >> 2) & 0x1f;
+    // A Temporal Delimiter has no payload beyond its header.
+    if (type != AV2_OBU_TEMPORAL_DELIMITER || content_len != 1 + (hdr >> 7))
+        return 0;
+
+    pos += leb_bytes + (int)content_len;
+
+    while (1) {
+        leb_bytes = read_uleb128(p->buf + pos, p->buf_size - pos, &content_len);
+        if (leb_bytes < 0 || !content_len || content_len > 0x40000000)
+            return 0;
+        if (leb_bytes >= p->buf_size - pos)
+            return 0;
+
+        hdr  = p->buf[pos + leb_bytes];
+        type = (hdr >> 2) & 0x1f;
+
+        ret = get_score(type, &seq);
+        if (ret >= 0)
+            return ret;
+
+        if (pos + (int64_t)leb_bytes + content_len > p->buf_size)
+            return 0;
+
+        pos += leb_bytes + (int)content_len;
+    }
+
+    return 0;
+}
+
+static int av2_read_header(AVFormatContext *s)
+{
+    AV2DemuxContext *c = s->priv_data;
+    AVStream *st;
+
+    st = avformat_new_stream(s, NULL);
+    if (!st)
+        return AVERROR(ENOMEM);
+
+    st->codecpar->codec_type = AVMEDIA_TYPE_VIDEO;
+    st->codecpar->codec_id   = AV_CODEC_ID_AV2;
+    st->avg_frame_rate       = c->framerate;
+
+    avpriv_set_pts_info(st, 64, 1, 1200000);
+
+    return 0;
+}
+
+/**
+ * Peek at the next OBU without consuming it.
+ * @return total OBU size (ULEB128 bytes + content length), 0 on EOF,
+ *         or < 0 on error
+ */
+static int peek_obu(AVFormatContext *s, int *type)
+{
+    uint8_t peek[MAX_AV2_OBU_HEADER_SIZE + AV_INPUT_BUFFER_PADDING_SIZE];
+    int64_t seek_ret;
+    int peek_size, total_size, ret;
+
+    if ((ret = ffio_ensure_seekback(s->pb, MAX_AV2_OBU_HEADER_SIZE)) < 0)
+        return ret;
+
+    peek_size = avio_read(s->pb, peek, MAX_AV2_OBU_HEADER_SIZE);
+    if (peek_size == AVERROR_EOF)
+        return 0;
+    if (peek_size < 0)
+        return peek_size;
+
+    memset(peek + peek_size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+
+    total_size = parse_av2_obu(peek, peek_size, type);
+    if (total_size < 0) {
+        av_log(s, AV_LOG_ERROR, "Failed to parse AV2 OBU header\n");
+        return total_size;
+    }
+    av_log(s, AV_LOG_TRACE, "OBU type %d, size %d\n", *type, total_size);
+
+    seek_ret = avio_seek(s->pb, -peek_size, SEEK_CUR);
+    if (seek_ret < 0)
+        return (int)seek_ret;
+
+    return total_size;
+}
+
+static int av2_read_packet(AVFormatContext *s, AVPacket *pkt)
+{
+    int total_size, type, ret, key = 0;
+
+    for (int first = 1;; first = 0) {
+        total_size = peek_obu(s, &type);
+        if (total_size < 0)
+            return total_size;
+        if (!total_size) {
+            if (first)
+                return AVERROR_EOF;
+            break;
+        }
+
+        if (first) {
+            if (type != AV2_OBU_TEMPORAL_DELIMITER)
+                av_log(s, AV_LOG_WARNING,
+                       "Temporal unit does not start with a Temporal Delimiter\n");
+        } else if (type == AV2_OBU_TEMPORAL_DELIMITER) {
+            break; // belongs to the next temporal unit
+        }
+
+        // Only closed loop key frames are random access points without
+        // leading pictures.
+        if (type == AV2_OBU_CLOSED_LOOP_KF)
+            key = 1;
+
+        ret = first ? av_get_packet(s->pb, pkt, total_size)
+                    : av_append_packet(s->pb, pkt, total_size);
+        if (ret < 0)
+            return ret;
+        if (ret != total_size) {
+            av_log(s, AV_LOG_ERROR, "Short read for AV2 OBU\n");
+            return AVERROR_INVALIDDATA;
+        }
+    }
+
+    if (key)
+        pkt->flags |= AV_PKT_FLAG_KEY;
+    pkt->stream_index = 0;
+    return 0;
+}
+
+#define DEC AV_OPT_FLAG_DECODING_PARAM
+#define OFFSET(x) offsetof(AV2DemuxContext, x)
+static const AVOption av2_options[] = {
+    { "framerate", "set framerate", OFFSET(framerate), AV_OPT_TYPE_VIDEO_RATE,
+      {.str = "25"}, 0, INT_MAX, DEC },
+    { NULL },
+};
+#undef OFFSET
+
+static const AVClass av2_demuxer_class = {
+    .class_name = "AV2 low overhead OBU demuxer",
+    .item_name  = av_default_item_name,
+    .option     = av2_options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+const FFInputFormat ff_av2_demuxer = {
+    .p.name         = "av2",
+    .p.long_name    = NULL_IF_CONFIG_SMALL("AV2 low overhead OBU"),
+    .p.extensions   = "obu",
+    .p.flags        = AVFMT_GENERIC_INDEX | AVFMT_NO_BYTE_SEEK | AVFMT_NOTIMESTAMPS,
+    .p.priv_class   = &av2_demuxer_class,
+    .priv_data_size = sizeof(AV2DemuxContext),
+    .read_probe     = av2_probe,
+    .read_header    = av2_read_header,
+    .read_packet    = av2_read_packet,
+};
