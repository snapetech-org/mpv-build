+// OBU types (section 6.2.2).
+typedef enum {
+    // 0 reserved.
+    AV2_OBU_SEQUENCE_HEADER            = 1,
+    AV2_OBU_TEMPORAL_DELIMITER         = 2,
+    AV2_OBU_MULTI_FRAME_HDR            = 3,
+    AV2_OBU_CLOSED_LOOP_KF             = 4,
+    AV2_OBU_OPEN_LOOP_KF               = 5,
+    AV2_OBU_LEADING_TILE_GRP           = 6,
+    AV2_OBU_TILE_GRP                   = 7,
+    AV2_OBU_METADATA                   = 8,
+    AV2_OBU_METADATA_GRP               = 9,
+    AV2_OBU_SWITCH                     = 10,
+    AV2_OBU_LEADING_SEF                = 11,
+    AV2_OBU_REGULAR_SEF                = 12,
+    AV2_OBU_LEADING_TIP                = 13,
+    AV2_OBU_REGULAR_TIP                = 14,
+    AV2_OBU_BUFFER_REMOVAL_TIMING      = 15,
+    AV2_OBU_LAYER_CONFIGURATION_RECORD = 16,
+    AV2_OBU_ATLAS_SEG                  = 17,
+    AV2_OBU_OPERATING_POINT_SE         = 18,
+    AV2_OBU_BRIDGE_FRAME               = 19,
+    AV2_OBU_MSDO                       = 20,
+    AV2_OBU_RAS_FRAME                  = 21,
+    AV2_OBU_QUANTIZATION_MATRIX        = 22,
+    AV2_OBU_FILM_GRAIN                 = 23,
+    AV2_OBU_CONTENT_INTERPRETATION     = 24,
+    AV2_OBU_PADDING                    = 25,
+} AV2_OBU_Type;
+
+#endif /* AVCODEC_AV2_H */
