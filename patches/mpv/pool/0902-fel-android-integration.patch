+
+// --- mediacodec timing core
+
+struct mediacodec_timing {
+    uint64_t frame_id;
+    int64_t target_ns;
+    double frame_duration_ns;
+    int64_t vsync_hysteresis_offset_ns;
+};
+
+static void mediacodec_timing_reset(struct mediacodec_timing *timing)
+{
+    *timing = (struct mediacodec_timing){0};
+}
+
+static int64_t mediacodec_timing_predict(struct mediacodec_timing *timing,
+                                        int64_t raw_target_ns, uint64_t frame_id,
+                                        double frame_duration_ns)
+{
+    if (!frame_id || !isfinite(frame_duration_ns) || frame_duration_ns <= 0) {
+        mediacodec_timing_reset(timing);
+        return raw_target_ns;
+    }
+
+    int64_t target_ns = raw_target_ns;
+    bool predicted = false;
+    if (timing->frame_id && frame_id > timing->frame_id &&
+        fabs(frame_duration_ns - timing->frame_duration_ns) <= 1000000.0)
+    {
+        // vo_frame.duration already accounts for playback speed. The ID gap
+        // includes frames dropped by the VO, unlike a local frame counter.
+        double elapsed_ns = (frame_id - timing->frame_id) * frame_duration_ns;
+        // Bound the conversion and addition even after a very large ID gap.
+        if (elapsed_ns < 0x1p63) {
+            int64_t elapsed = (int64_t)elapsed_ns;
+            if (timing->target_ns <= INT64_MAX - elapsed) {
+                int64_t candidate = timing->target_ns + elapsed;
+                uint64_t deviation = candidate >= raw_target_ns
+                    ? (uint64_t)candidate - (uint64_t)raw_target_ns
+                    : (uint64_t)raw_target_ns - (uint64_t)candidate;
+                if (deviation <= 20000000) {
+                    target_ns = candidate;
+                    predicted = true;
+                }
+            }
+        }
+    }
+
+    if (!predicted)
+        mediacodec_timing_reset(timing);
+    timing->frame_id = frame_id;
+    timing->target_ns = target_ns;
+    timing->frame_duration_ns = frame_duration_ns;
+    return target_ns;
+}
+
+static int64_t mediacodec_timing_snap(struct mediacodec_timing *timing,
+                                     int64_t target_ns, int64_t sample_ns,
+                                     int64_t period_ns)
+{
+    if (period_ns <= 0) {
+        timing->vsync_hysteresis_offset_ns = 0;
+        return target_ns;
+    }
+
+    int64_t delta = target_ns - sample_ns;
+    int64_t count = delta / period_ns;
+    if (delta < 0 && delta % period_ns)
+        count--;
+    int64_t before = sample_ns + count * period_ns;
+    int64_t after = before + period_ns;
+    int64_t before_diff = target_ns - before;
+    int64_t after_diff = after - target_ns;
+    int64_t diff = after_diff >= before_diff
+                 ? after_diff - before_diff : before_diff - after_diff;
+
+    // Media3 1.11: retain the last ambiguous choice across clear matches
+    // (e.g. 60 fps on 90 Hz), but clear it in the intervening range.
+    if (diff < period_ns / 2) {
+        int64_t range = period_ns / 4;
+        if (diff < range) {
+            if (!timing->vsync_hysteresis_offset_ns)
+                timing->vsync_hysteresis_offset_ns =
+                    after_diff < before_diff ? -range : range;
+        } else {
+            timing->vsync_hysteresis_offset_ns = 0;
+        }
+    }
+
+    return after_diff + timing->vsync_hysteresis_offset_ns < before_diff
+         ? after : before;
+}
+
+// The period releases snap with. The phase comes from Choreographer frame
+// times, which run on SurfaceFlinger's vsync model: the clock it latches
+// buffers against. That model can disagree with the display mode: an Amlogic
+// box fits 15.71 ms to a 16.68 ms mode for whole sessions, and snapped with
+// the mode's period, every 500 ms resample moves the grid by ~2 ms and frames
+// land a vsync off in 3:2 pairs all session long. Media3 1.11 takes both
+// phase and period from the Choreographer's frame timelines; here spacing_ns
+// is the gap between the first two timelines' expected presentation times
+// (0 below API 33, or before the first), over the vsyncs nominal_ns (the
+// mode's period) says it spans, since an app render rate below the mode's
+// spaces them by several. Within 2% the mode's period stands, and this is a
+// deliberate departure from media3: a Pixel 7's panel runs at 11.057 ms
+// under its 90 Hz mode, and its timelines are spaced by the mode's 11.111 ms
+// on most samples and by SurfaceFlinger's ~11.05 ms model on the rest.
+// Following them sample by sample, as media3 does, showed 4 to 11 frames a
+// vsync early in 5 minutes there (media3 itself 0 to 12), against 0 to 1 on
+// the mode's period. It also stands for a gap that is not a whole number of
+// vsyncs within a quarter. Consecutive frame callback times are no
+// substitute for the timelines: a Pixel's and a Fire TV's jitter by more
+// than a millisecond.
+static int64_t mediacodec_grid_period(int64_t spacing_ns, int64_t nominal_ns)
+{
+    if (spacing_ns <= 0 || nominal_ns <= 0)
+        return nominal_ns;
+    int64_t vsyncs = (spacing_ns + nominal_ns / 2) / nominal_ns;
+    if (vsyncs < 1 || vsyncs > 3)
+        return nominal_ns;
+    int64_t measured = spacing_ns / vsyncs;
+    int64_t diff = measured > nominal_ns ? measured - nominal_ns
+                                         : nominal_ns - measured;
+    return diff * 50 <= nominal_ns || diff * 4 > nominal_ns ? nominal_ns : measured;
+}
+
+// Choreographer frame times come from SurfaceFlinger's vsync model, and the
+// model can step off its own grid for one resample and come back. On a
+// MediaTek projector (Plezy #2654), every few seconds one 500 ms resample
+// landed 0.4 to 0.5 of a vsync off the resamples on either side of it.
+// Snapped to it, every frame of that resample aimed at the other side of its
+// vsync, and the display's 24 fps holds went from 2.41/2.59 vsyncs to
+// 3.41/1.59 until the next resample put the grid back. A sample within a
+// quarter vsync of the grid moves the grid, as every sample used to. A
+// farther one is held back, and releases keep the grid's vsync nearest to it
+// until a later resample settles where the grid is: one back on the grid is
+// adopted, and so is one still off it. A one-resample excursion never
+// reaches a release, and a real step takes effect one resample late.
+//
+// The grid is extrapolated with the drift of the recent resamples rather
+// than held fixed. SurfaceFlinger's vsync can run off the period releases
+// snap with by less than mediacodec_grid_period corrects: a Pixel 7's
+// 11.057 ms panel moves about a quarter of its 11.111 ms mode's vsync
+// between resamples. The drift is the median move of the newest even count
+// of the last MEDIACODEC_PHASE_MOVES resamples. The median keeps an
+// excursion's move out and back from bending it, and an even count gives
+// moves that alternate between two values (jitter that flips sign every
+// resample) their midpoint rather than one of them.
+#define MEDIACODEC_PHASE_MOVES 8 // even, and at most OSD_MEDIAN_MAX
+#define MEDIACODEC_PHASE_MIN_MOVES 4
+// The sampler resamples every 500 ms, and its API 33 timeline callback
+// follows its frame callback by one vsync: two samples this far apart come
+// from different resamples.
+#define MEDIACODEC_PHASE_RESAMPLE_NS INT64_C(250000000)
+// Past this the grid is too old to extrapolate, and the sample is adopted.
+#define MEDIACODEC_PHASE_MAX_GAP_NS INT64_C(1000000000)
+// Beyond 2% mediacodec_grid_period snaps with the timelines' spacing.
+#define MEDIACODEC_PHASE_MAX_DRIFT_PPB INT64_C(20000000)
+
+struct mediacodec_phase {
+    int64_t period;   // the period the moves were measured against
+    int64_t anchor;   // the newest sample adopted, 0 when none
+    int64_t held;     // the first sample off its grid since then, 0 when none
+    int64_t resample; // the first sample seen of the newest resample
+    int64_t moves[MEDIACODEC_PHASE_MOVES]; // resample to resample, ppb
+    int count;
+    int next;
+};
+
+// delta's offset from the nearest multiple of period_ns.
+static int64_t mediacodec_phase_offset(int64_t delta, int64_t period_ns)
+{
+    int64_t half = period_ns / 2;
+    int64_t off = delta % period_ns;
+    if (off >= period_ns - half)
+        off -= period_ns;
+    else if (off < -half)
+        off += period_ns;
+    return off;
+}
+
+// The vsync sample releases snap to, given the newest fresh Choreographer
+// sample (0 for none) and the period releases snap with: that sample, or
+// while it is held back, the grid's vsync nearest to it.
+static int64_t mediacodec_phase_filter(struct mediacodec_phase *phase,
+                                       int64_t sample_ns, int64_t period_ns)
+{
+    if (!sample_ns || period_ns <= 0)
+        return sample_ns;
+    // Switching between the mode's period and the timelines' spacing is a
+    // new grid, not a refit: the moves were measured against the old one.
+    int64_t refit = period_ns > phase->period ? period_ns - phase->period
+                                              : phase->period - period_ns;
+    if (refit * 1000 > period_ns)
+        *phase = (struct mediacodec_phase){0};
+    phase->period = period_ns;
+
+    int64_t drift = 0;
+    if (phase->count >= MEDIACODEC_PHASE_MIN_MOVES) {
+        // An odd count only occurs before the ring wraps, where the oldest
+        // move is the first.
+        drift = osd_median_ns(phase->moves + (phase->count & 1),
+                              phase->count & ~1);
+        if (drift > MEDIACODEC_PHASE_MAX_DRIFT_PPB)
+            drift = MEDIACODEC_PHASE_MAX_DRIFT_PPB;
+        else if (drift < -MEDIACODEC_PHASE_MAX_DRIFT_PPB)
+            drift = -MEDIACODEC_PHASE_MAX_DRIFT_PPB;
+    }
+
+    // Every resample measures the drift, held ones included.
+    int64_t since = sample_ns - phase->resample;
+    if (!phase->resample || since < 0 || since > MEDIACODEC_PHASE_MAX_GAP_NS) {
+        phase->resample = sample_ns;
+    } else if (since >= MEDIACODEC_PHASE_RESAMPLE_NS) {
+        int64_t expect = drift * since / INT64_C(1000000000);
+        int64_t move = mediacodec_phase_offset(since - expect, period_ns) + expect;
+        phase->moves[phase->next] = move * INT64_C(1000000000) / since;
+        phase->next = (phase->next + 1) % MEDIACODEC_PHASE_MOVES;
+        if (phase->count < MEDIACODEC_PHASE_MOVES)
+            phase->count++;
+        phase->resample = sample_ns;
+    }
+
+    int64_t age = sample_ns - phase->anchor;
+    if (phase->anchor && age >= 0 && age <= MEDIACODEC_PHASE_MAX_GAP_NS) {
+        int64_t off = mediacodec_phase_offset(
+            age - drift * age / INT64_C(1000000000), period_ns);
+        bool settled = phase->held &&
+                       sample_ns - phase->held >= MEDIACODEC_PHASE_RESAMPLE_NS;
+        if ((off > period_ns / 4 || off < -(period_ns / 4)) && !settled) {
+            if (!phase->held)
+                phase->held = sample_ns;
+            return sample_ns - off;
+        }
+    }
+    phase->anchor = sample_ns;
+    phase->held = 0;
+    return sample_ns;
+}
+
+// Release timestamp, on now_ns's clock, for a frame due at raw_target_ns;
+// 0 releases untimed, i.e. at the next vsync. sample_ns is a vsync timestamp
+// on that clock, or 0 when none is fresh; period_ns is the display period, or
+// 0 when unknown. The surface presents a buffer at the first vsync at or after
+// its timestamp, so a timestamp in the near past still lands on the chosen
+// vsync: once cadence correction and snapping chose a vsync, the release is
+// that vsync minus 80% of a period even when the VO thread runs late. The
+// unsnapped target must never substitute for it: for half of all frames it
+// lies past its grid line and would round up to the following vsync. A late
+// raw deadline releases untimed but still advances the cadence anchor, so the
+// next frame predicts from cadence rather than a jittered raw deadline and
+// keeps its hysteresis choice (Media3 adjusts frames it then drops the same
+// way); only an unknown clock or a deadline beyond max_ahead_ns is a
+// discontinuity that resets.
+static int64_t mediacodec_timing_release(struct mediacodec_timing *timing,
+                                         int64_t raw_target_ns, int64_t now_ns,
+                                         uint64_t frame_id,
+                                         double frame_duration_ns,
+                                         int64_t sample_ns, int64_t period_ns,
+                                         int64_t max_ahead_ns)
+{
+    if (now_ns <= 0 || raw_target_ns > now_ns + max_ahead_ns) {
+        mediacodec_timing_reset(timing);
+        return 0;
+    }
+
+    int64_t target_ns = mediacodec_timing_predict(timing, raw_target_ns,
+                                                  frame_id, frame_duration_ns);
+    if (raw_target_ns <= now_ns)
+        return 0;
+    if (period_ns <= 0 || !sample_ns)
+        return target_ns;
+
+    int64_t snapped = mediacodec_timing_snap(timing, target_ns, sample_ns,
+                                             period_ns);
+    return snapped - period_ns * 8 / 10;
+}
+
+// How far before its release timestamp a frame is handed to the codec:
+// media3's early-scheduling threshold (MediaCodecVideoRenderer's
+// DEFAULT_EARLY_SCHEDULING_THRESHOLD_US), whatever the display period. media3
+// checks it about every 10 ms, so its handoffs spread over 40-50 ms; this VO
+// wakes at the threshold. Two display periods, the handoff the MediaCodec
+// documentation suggests, left a MediaTek Fire TV showing 7 frames a vsync
+// early in 35 minutes of 24p, against none at 50 ms. MediaCodec does not
+// return a buffer released with releaseOutputBuffer(int, long) to the
+// decoder until its timestamp passes, so the lead also bounds how many
+// decoded frames the surface holds.
+#define MEDIACODEC_CODEC_LEAD_NS INT64_C(50000000)
+
+// The timestamp mediacodec_timing_release would choose, evaluated without
+// committing the cadence anchor or the snap preference and without the
+// submission-time guards. Preparation needs the decision to know when the
+// codec may have the buffer; only the single release at flip commits it, so
+// repeated preparation wakeups cannot advance the anchor.
+static int64_t mediacodec_timing_preview(const struct mediacodec_timing *timing,
+                                        int64_t raw_target_ns, uint64_t frame_id,
+                                        double frame_duration_ns,
+                                        int64_t sample_ns, int64_t period_ns)
+{
+    struct mediacodec_timing scratch = *timing;
+    int64_t target_ns = mediacodec_timing_predict(&scratch, raw_target_ns,
+                                                  frame_id, frame_duration_ns);
+    if (period_ns <= 0 || !sample_ns)
+        return target_ns;
+    return mediacodec_timing_snap(&scratch, target_ns, sample_ns, period_ns)
+         - period_ns * 8 / 10;
+}
+
+// OSD work needs the current/next render plus composition time, and the core
+// has to wake early enough that the codec window is still reachable: one
+// codec lead, the 80% pull-back, and the cadence-correction bound.
+static int64_t mediacodec_prepare_lead(int64_t period_ns, double duration_ns)
+{
+    int64_t lead = MEDIACODEC_CODEC_LEAD_NS + period_ns + 20000000;
+    if (period_ns > 0 && isfinite(duration_ns) && duration_ns > 0) {
+        int64_t render = llround(fmin(2 * duration_ns + period_ns, 500000000));
+        if (render > lead)
+            lead = render;
+    }
+    return lead;
+}
+
+static bool mediacodec_synthetic_still(bool still, int64_t pts,
+                                      double duration)
+{
+    return still && pts == 0 && duration < 0;
+}
+
+// --- end mediacodec timing core
+
+// --- mediacodec stats core
+
+// Verbose statistics log sparsely. One line every OSD_STATS_INTERVAL_FRAMES
+// flips was the largest single contributor to an uploaded log (58% of an
+// hour of 24p), and the log relay trims uploads from the front at 1 MiB, so
+// a two-hour session lost its startup section. A tick logs when a failure
+// counter moved since the previous tick, on the first tick, and otherwise as
+// a heartbeat every STATS_HEARTBEAT_TICKS ticks. Failure counters only grow
+// between resets, so their sum moves exactly when one of them does.
+#define STATS_HEARTBEAT_TICKS 12 // 60 s of 24p at 120-frame ticks
+
+struct stats_cadence {
+    unsigned ticks;
+    unsigned logged_tick;
+    bool logged;
+    uint64_t failures;
+};
+
+// The reason this tick logs, or NULL when it stays silent.
+static const char *stats_due(struct stats_cadence *c, uint64_t failures)
+{
+    c->ticks++;
+    bool event = c->logged && failures != c->failures;
+    c->failures = failures;
+    if (!event && c->logged && c->ticks - c->logged_tick < STATS_HEARTBEAT_TICKS)
+        return NULL;
+    c->logged = true;
+    c->logged_tick = c->ticks;
+    return event ? "event" : "periodic";
+}
+
+// Video-plane presentation feedback. flip_page records the vsync each release
+// aimed at, keyed by the presentation time the codec attached to the buffer,
+// and matches the codec's frame-rendered reports (drained through the buffer
+// at the next flip) back to it: the video plane's twin of the OSD plane's
+// EGL present probes. Delivery is batched and may skip frames, so the ring is
+// deep, and a report without an intent or an intent without a report is
+// counted rather than trusted.
+#define PRESENT_INTENTS 32 // ~1.3 s of 24p
+
+struct present_intent {
+    int64_t media_us;
+    int64_t vsync;       // CLOCK_MONOTONIC vsync the release targeted, 0 untimed
+    double duration_ns;  // the frame's display duration, <= 0 unknown
+    uint64_t seq;        // release order, so a hold is only read between neighbours
+    bool live;
+};
+
+// Where a report lands relative to its vsync says which clock the platform
+// reports, not whether the frame was shown on time: Tensor and MediaTek
+// report the latch of the intended vsync, 0.8 of a period early, for every
+// frame; Amlogic latches one or two vsyncs before the timestamp and reports
+// that, alternating by frame. Which class a device is in is what the
+// histogram below names.
+
+// What the viewer can see is a hold: the time between two consecutive
+// frames' reports, in vsyncs. A frame of duration d on a display of period p
+// is legitimately held floor(d/p) or ceil(d/p) vsyncs -- 2 or 3 for 24p on
+// 60 Hz, 5 or 6 for 23.976 on 120 Hz, exactly 1 for 24p on 24 Hz --
+// whichever of the two the platform picks and however its report clock is
+// offset. A longer hold lost the viewer a slot: that is a miss. The short
+// hold that immediately follows it is the same event catching up and is not
+// counted again; a short hold on its own is.
+struct present_hold {
+    bool valid;
+    uint64_t seq;        // the intent the report answered
+    int64_t system_nano; // the report
+    double duration_ns;  // the frame's display duration
+    int64_t period_ns;   // the grid the frame was timed on
+    bool long_hold;      // the hold that ended at this report was too long
+};
+
+struct present_stats {
+    struct present_intent ring[PRESENT_INTENTS];
+    int next;
+    uint64_t seq;        // intents recorded
+    struct present_hold prev; // the newest matched, timed report
+    uint32_t measured;   // reports matched to a timed release
+    uint32_t untimed;    // reports matched to an untimed or unsnapped release
+    uint32_t unclocked;  // reports carrying a time not on the vsync clock
+    uint32_t unmatched;  // reports with no intent: stragglers across a reset
+    uint32_t overrun;    // intents overwritten before any report arrived
+    uint32_t hist[5];    // in vsyncs: <-1.5, <-0.5, <0.5, <1.5, >=1.5
+    int64_t err_last_ns, err_worst_ns;
+    uint32_t missed;     // holds off the frame's legitimate cadence
+    uint32_t late;       // releases due before they reached the codec
+    uint32_t unsnapped;  // releases timed without a fresh vsync sample
+};
+
+// Forget the intents and the hold in progress; the counters describe the
+// session.
+static void present_reset(struct present_stats *s)
+{
+    for (int n = 0; n < PRESENT_INTENTS; n++)
+        s->ring[n].live = false;
+    s->next = 0;
+    s->prev.valid = false;
+}
+
+static void present_record(struct present_stats *s, int64_t media_us,
+                           int64_t vsync, double duration_ns)
+{
+    struct present_intent *e = &s->ring[s->next];
+    if (e->live)
+        s->overrun++;
+    *e = (struct present_intent){.media_us = media_us, .vsync = vsync,
+                                 .duration_ns = duration_ns, .seq = ++s->seq,
+                                 .live = true};
+    s->next = (s->next + 1) % PRESENT_INTENTS;
+}
+
+// Whether the hold that ended at [report] -- the previous matched frame's
+// time on screen -- lost the viewer a slot. Only neighbouring releases on
+// one grid can be read as a hold: a report missing in between, a seek or a
+// refresh-rate switch each start over.
+static bool present_hold_missed(struct present_stats *s,
+                                const struct present_hold *report)
+{
+    const struct present_hold *prev = &s->prev;
+    bool missed = false;
+    bool long_hold = false;
+    if (prev->valid && prev->seq + 1 == report->seq &&
+        prev->period_ns == report->period_ns && prev->duration_ns > 0)
+    {
+        int64_t held = llround((double)(report->system_nano - prev->system_nano)
+                               / report->period_ns);
+        double due = prev->duration_ns / report->period_ns;
+        // A ratio a rounding away from a whole number is that whole number.
+        int64_t shortest = (int64_t)floor(due + 1e-6);
+        int64_t longest = (int64_t)ceil(due - 1e-6);
+        long_hold = held > longest;
+        missed = long_hold || (held < shortest && !prev->long_hold);
+    }
+    s->prev = *report;
+    s->prev.long_hold = long_hold;
+    return missed;
+}
+
+// A render time the platform did not actually take: Tegra on Android 9
+// answers the Java frame-rendered listener with system_nano 0 for every
+// frame. Read as a hold, that is one miss per frame and a drop count that
+// climbs at the frame rate for a picture that is perfectly smooth. Nothing
+// this VO releases can land a second from the vsync it targeted -- the
+// intent ring is not that deep -- so a report that far off is not a
+// measurement, and the pair it would have formed is not a hold. It is not
+// a failure either: the platform is unmeasurable, which the count names.
+#define PRESENT_REPORT_SANE_NS (1 * INT64_C(1000000000))
+
+// Returns whether the display held the previous frame off its cadence.
+static bool present_observe(struct present_stats *s, int64_t media_us,
+                            int64_t system_nano, int64_t period_ns)
+{
+    for (int n = 0; n < PRESENT_INTENTS; n++) {
+        struct present_intent *e = &s->ring[n];
+        if (!e->live || e->media_us != media_us)
+            continue;
+        e->live = false;
+        if (!e->vsync || period_ns <= 0) {
+            s->untimed++;
+            return false;
+        }
+        if (llabs(system_nano - e->vsync) > PRESENT_REPORT_SANE_NS) {
+            s->unclocked++;
+            return false;
+        }
+        int64_t err = system_nano - e->vsync;
+        s->measured++;
+        s->err_last_ns = err;
+        if (llabs(err) > llabs(s->err_worst_ns))
+            s->err_worst_ns = err;
+        double vsyncs = (double)err / period_ns;
+        s->hist[vsyncs < -1.5 ? 0 : vsyncs < -0.5 ? 1
+              : vsyncs < 0.5 ? 2 : vsyncs < 1.5 ? 3 : 4]++;
+        bool missed = present_hold_missed(s, &(struct present_hold){
+            .valid = true, .seq = e->seq, .system_nano = system_nano,
+            .duration_ns = e->duration_ns, .period_ns = period_ns,
+        });
+        if (missed)
+            s->missed++;
+        return missed;
+    }
+    s->unmatched++;
+    return false;
+}
+
+// What a video-present line exists to catch: a frame held off its cadence, a
+// release the VO could not time, a report that never came, or -- on every
+// source -- a release that was late or could not be snapped to a vsync.
+static uint64_t present_failures(const struct present_stats *s)
+{
+    return (uint64_t)s->untimed + s->overrun + s->missed + s->late +
+           s->unsnapped;
+}
+
+// --- end mediacodec stats core
