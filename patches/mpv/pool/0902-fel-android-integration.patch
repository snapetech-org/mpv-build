+// Bytes and count of the whole THD_GROUP_UNITS groups at the front of rawbuf.
+static int AudioTrack_thdGroup(struct priv *p, int *units)
+{
+    const uint8_t *buf = p->rawbuf;
+    *units = p->thd_complete / THD_GROUP_UNITS * THD_GROUP_UNITS;
+    int bytes = 0;
+    for (int n = 0; n < *units; n++)
+        bytes += ((buf[bytes] & 0xf) << 8 | buf[bytes + 1]) * 2;
+    return bytes;
+}
+
+// Drop units the track has taken from the front of rawbuf.
+static void AudioTrack_thdTake(struct priv *p, int bytes, int units)
+{
+    memmove(p->rawbuf, (uint8_t *)p->rawbuf + bytes, p->thd_fill - bytes);
+    p->thd_fill -= bytes;
+    p->thd_complete_end -= bytes;
+    p->thd_complete -= units;
+}
+
+// Unwraps IEC 61937 (LE words from libavformat's spdif muxer) back into the
+// codec byte stream; parser state persists across calls. Full-carrier DTS
+// arrives without a preamble, so the frame header supplies its length. A
+// DTS-HD burst carries its own header (DTSHD_BURST_HEADER) inside Pd, and
+// Pd is padded past the packet, so the header's size field bounds the copy.
+// dst needs len + sizeof(raw_dts_header) bytes. TrueHD bursts go to the unit
+// reassembly in rawbuf instead (AudioTrack_thdMatWord) and never touch dst.
+static int AudioTrack_unwrapIEC61937(struct ao *ao, uint8_t *dst,
+                                     const uint8_t *src, int len)
+{
+    struct priv *p = ao->priv;
+    int out = 0;
+
+    for (int i = 0; i < len;) {
+        if (!p->raw_have_byte) {
+            p->raw_byte = src[i++];
+            p->raw_have_byte = true;
+        }
+        if (i == len)
+            break;
+        const uint8_t lo = p->raw_byte, hi = src[i++];
+        p->raw_have_byte = false;
+
+        if (p->raw_state == RAW_PAYLOAD && p->raw_data_type == IEC61937_TRUEHD) {
+            AudioTrack_thdMatWord(ao, hi, lo);
+            p->raw_payload_left -= 2;
+            if (p->raw_payload_left <= 0) {
+                p->raw_payload_left = 0;
+                p->raw_state = RAW_SYNC_PA;
+            }
+            continue;
+        }
+
+        if (p->raw_state == RAW_PAYLOAD) {
+            // Payload words are byte-swapped; a lone final byte rides high.
+            dst[out++] = hi;
+            if (--p->raw_payload_left > 0) {
+                dst[out++] = lo;
+                p->raw_payload_left--;
+            }
+            if (p->raw_payload_left == 0)
+                p->raw_state = RAW_SYNC_PA;
+            continue;
+        }
+
+        if (p->raw_state == RAW_DTS_HEADER) {
+            uint8_t *h = p->raw_dts_header;
+            h[p->raw_dts_header_len++] = hi;
+            h[p->raw_dts_header_len++] = lo;
+            if (p->raw_dts_header_len < (int)sizeof(p->raw_dts_header))
+                continue;
+
+            int blocks = 0;
+            if (h[0] == 0x7f && h[1] == 0xfe && h[2] == 0x80 && h[3] == 0x01)
+                blocks = (((h[4] << 8 | h[5]) >> 2) & 0x7f) + 1;
+            else if (h[0] == 0x1f && h[1] == 0xff && h[2] == 0xe8 && h[3] == 0x00)
+                blocks = ((h[5] & 7) << 4 | (h[6] & 0x3f) >> 2) + 1;
+
+            p->raw_state = RAW_SYNC_PA;
+            p->raw_dts_header_len = 0;
+            if (blocks == 16 || blocks == 32 || blocks == 64) {
+                memcpy(dst + out, h, sizeof(p->raw_dts_header));
+                out += sizeof(p->raw_dts_header);
+                p->raw_payload_left = blocks * 128 - sizeof(p->raw_dts_header);
+                p->raw_state = RAW_PAYLOAD;
+            }
+            continue;
+        }
+
+        if (p->raw_state == RAW_DTSHD_HEADER) {
+            p->raw_dts_header_len += 2;
+            if (p->raw_dts_header_len < DTSHD_BURST_HEADER)
+                continue;
+            // The last word is the packet size, big-endian in the burst.
+            const int size = hi << 8 | lo;
+            p->raw_dts_header_len = 0;
+            if (size > 0 && size + DTSHD_BURST_HEADER <= p->raw_payload_left) {
+                p->raw_payload_left = size;
+                p->raw_state = RAW_PAYLOAD;
+            } else {
+                MP_WARN(ao, "DTS-HD burst header names %d bytes of a %d byte burst\n",
+                        size, p->raw_payload_left);
+                p->raw_payload_left = 0;
+                p->raw_state = RAW_SYNC_PA;
+            }
+            continue;
+        }
+
+        const uint16_t word = lo | (hi << 8);
+        switch (p->raw_state) {
+        case RAW_SYNC_PA:
+            if (word == 0xf872)
+                p->raw_state = RAW_SYNC_PB;
+            else if (ao->format == AF_FORMAT_S_DTS &&
+                     (word == 0x7ffe || word == 0x1fff)) {
+                p->raw_dts_header[0] = hi;
+                p->raw_dts_header[1] = lo;
+                p->raw_dts_header_len = 2;
+                p->raw_state = RAW_DTS_HEADER;
+            }
+            break;
+        case RAW_SYNC_PB:
+            if (word == 0x4e1f)
+                p->raw_state = RAW_PC;
+            else
+                p->raw_state = word == 0xf872 ? RAW_SYNC_PB : RAW_SYNC_PA;
+            break;
+        case RAW_PC:
+            p->raw_data_type = word & 0x7f;
+            p->raw_state = RAW_PD;
+            break;
+        case RAW_PD:
+            if ((ao->format == AF_FORMAT_S_TRUEHD) != (p->raw_data_type == IEC61937_TRUEHD)) {
+                MP_WARN(ao, "IEC 61937 data type 0x%x in a %s stream\n",
+                        p->raw_data_type, af_fmt_to_str(ao->format));
+                p->raw_state = RAW_SYNC_PA;
+                break;
+            }
+            switch (p->raw_data_type) {
+            case IEC61937_AC3:
+            case IEC61937_DTS1:
+            case IEC61937_DTS2:
+            case IEC61937_DTS3:
+                p->raw_payload_left = word >> 3; // Pd in bits
+                break;
+            case IEC61937_EAC3:
+            case IEC61937_DTSHD:
+                p->raw_payload_left = word; // Pd in bytes
+                break;
+            case IEC61937_TRUEHD:
+                // Pd in bytes: one whole MAT frame, the layout the unit
+                // parse depends on.
+                p->raw_payload_left = word == MAT_FRAME_SIZE ? word : 0;
+                if (!p->raw_payload_left)
+                    MP_WARN(ao, "TrueHD burst of %d bytes is not a MAT frame\n", word);
+                p->thd_mat_pos = 0;
+                break;
+            default:
+                MP_WARN(ao, "unexpected IEC 61937 data type 0x%x\n",
+                        p->raw_data_type);
+                p->raw_payload_left = 0;
+                break;
+            }
+            p->raw_state = p->raw_payload_left > 0 ? RAW_PAYLOAD : RAW_SYNC_PA;
+            if (p->raw_state == RAW_PAYLOAD && p->raw_data_type == IEC61937_DTSHD) {
+                p->raw_dts_header_len = 0;
+                p->raw_state = RAW_DTSHD_HEADER;
+            }
+            if (p->raw_payload_left > 0 && !p->raw_depth_logged) {
+                // Pd is the whole burst, so the depth is in codec frames
+                // (AC-3/E-AC-3: one 32 ms frame per burst).
+                p->raw_depth_logged = true;
+                MP_VERBOSE(ao, "raw burst of %d bytes: the track holds %d bursts\n",
+                           p->raw_payload_left, p->size / p->raw_payload_left);
+            }
+            break;
+        }
+    }
+
+    return out;
+}
+
+// The core rate named by a DTS-HD packet's leading core frame, or 0.
+static int dtshd_core_rate(const uint8_t *pkt, int len)
+{
+    // DTS core SFREQ codes (libavcodec dca.h); 0 marks the reserved ones.
+    static const int rates[16] = {
+        0, 8000, 16000, 32000, 0, 0, 11025, 22050,
+        44100, 0, 0, 12000, 24000, 48000, 96000, 192000,
+    };
+    if (len < 9 || pkt[0] != 0x7f || pkt[1] != 0xfe || pkt[2] != 0x80 || pkt[3] != 0x01)
+        return 0;
+    return rates[(pkt[8] >> 2) & 0xf];
+}
+
+static void AudioTrack_recreateOrFail(struct ao *ao);
+
+// ad_spdif does not expose the codec rate, so a raw DTS-HD track opens at
+// 48 kHz and the first unwrapped packet's core header confirms it. Another
+// rate that still divides the carrier reopens the track at that rate. The
+// replacement resets the clock, as any replacement does, but keeps the
+// unwrapped packet and the parser position the reset would drop: the caller
+// returns without writing, and the worker re-enters under the new generation
+// with the packet still pending. A rate the carrier cannot clock keeps the
+// track as opened, with a warning. p->lock held.
+static void AudioTrack_adoptDtsHdRate(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    p->raw_rate_verified = true;
+    const int rate = dtshd_core_rate(p->rawbuf, p->raw_pending);
+    if (!rate) {
+        MP_WARN(ao, "DTS-HD packet has no core header; keeping the raw track at %d Hz\n",
+                p->samplerate);
+        return;
+    }
+    if (rate == p->samplerate)
+        return;
+    if (ao->samplerate % rate) {
+        MP_WARN(ao, "%d Hz DTS-HD core does not divide the %d Hz carrier; "
+                "keeping the raw track at %d Hz\n",
+                rate, ao->samplerate, p->samplerate);
+        return;
+    }
+    MP_VERBOSE(ao, "DTS-HD core is %d Hz; reopening the raw track at that rate\n",
+               rate);
+    const int state = p->raw_state, data_type = p->raw_data_type,
+              header_len = p->raw_dts_header_len, pending = p->raw_pending,
+              input_len = p->raw_input_len, payload_left = p->raw_payload_left;
+    const uint8_t byte = p->raw_byte;
+    const bool have_byte = p->raw_have_byte;
+    p->samplerate = rate;
+    p->raw_rate_mult = ao->samplerate / rate;
+    AudioTrack_recreateOrFail(ao);
+    p->raw_state = state;
+    p->raw_data_type = data_type;
+    p->raw_dts_header_len = header_len;
+    p->raw_pending = pending;
+    p->raw_input_len = input_len;
+    p->raw_payload_left = payload_left;
+    p->raw_byte = byte;
+    p->raw_have_byte = have_byte;
+}
