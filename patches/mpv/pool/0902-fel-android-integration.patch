+static jobject normalizer_new_dynamics_processing(struct ao *ao, JNIEnv *env,
+                                                  jint session, int channels)
+{
+    if (!DynamicsProcessing.clazz || !DynamicsProcessingConfigBuilder.clazz ||
+        !DynamicsProcessingChannel.clazz || !DynamicsProcessingMbc.clazz ||
+        !DynamicsProcessingMbcBand.clazz || !DynamicsProcessingLimiter.clazz)
+        return NULL;
