+
+/*
+ * Timed MediaCodec Surface output with a sibling OSD plane.
+ *
+ * Decoded buffers go straight to the --wid Surface (no GPU pass, decoder
+ * dataspace intact) and are released with a presentation timestamp snapped
+ * to the Choreographer vsync grid when a fresh sample exists, and are handed
+ * to the codec 50 ms before that timestamp, as media3 hands them over.
+ * The embedder owns all geometry; software frames are
+ * refused so the Surface never becomes a CPU producer.
+ *
+ * OSD/subtitles go to the transparent --vo-mediacodec-osd-surface Surface,
+ * which the embedder stacks above the video, through a two-stage pipeline
+ * that never holds the video back:
+ *
+ *  - The render stage (thread "vo/osd-render") rasterizes the OSD for a
+ *    media pts. prepare_frame requests it as soon as the frame is admitted,
+ *    up to --video-timing-offset plus the preparation lead before the
+ *    frame is due, and between requests it pre-renders the next frame's pts
+ *    from the observed cadence so a regular request is served without
+ *    calling libass at all. Pre-rendering never runs past the subtitle
+ *    decoders' read horizon, where an undecoded event or a pending segment
+ *    switch would make the result wrong.
+ *  - The present stage (thread "vo/osd-present") uploads slots into a GL
+ *    texture on an EGL surface over the OSD Surface and swaps with
+ *    eglPresentationTimeANDROID set to the exact release timestamp the video
+ *    buffer got, so the compositor latches both on one vsync regardless of
+ *    how long the copy took. Swaps are scheduled half a frame before that
+ *    timestamp, and EGL_ANDROID_get_frame_timestamps reports where they
+ *    actually landed.
+ *
+ * Unserved requests are latest-wins under load, but completed frames enter a
+ * bounded FIFO and cannot replace one another while the presenter waits.
+ * Only the render stage waits for queue capacity; video keeps advancing.
+ * A pinned result is presented late rather than dropped. Dirty regions from
+ * skipped requests are folded into the next result. The render stage is
+ * the shared pipeline in osd_ahead.c; its scheduler core and this VO's swap
+ * lead are covered by scripts/test_mediacodec_osd.sh.
+ */
+
+#include <dlfcn.h>
+#include <limits.h>
+#include <math.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#include <time.h>
