+// Called for every new track (p->audiotrack set), which with the default
+// --audiotrack-session-id=0 is also a new audio session.
+static void AudioTrack_attachNormalizer(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
