+// ao.c takes device_buffer as the floor of the queue the core keeps in front
+// of this AO (max of it and --audio-buffer). The worker fills an empty track
+// - at start, after every seek and on resume - in one burst that takes a
+// whole track buffer from that queue, and the queue reports an underrun the
+// moment a read finds it short, so a queue no deeper than the track is
+// drained on the spot: a 500 ms PCM track tripped it at every start and seek
+// under the 200 ms default. Ask for twice the track so a burst leaves a full
+// track behind; the decoder has that long to refill before the next wake.
+//
+// A raw track's buffer is bitstream bytes, so the audio it holds moves with
+// the bitrate: the AC-3 budget is 640 ms of a 384 kb/s stream, against the
+// 320 ms queue its byte count used to ask for, and refilling it half at a
+// time emptied that queue mid-film (one to four times in five minutes on a
+// Google TV Streamer). No common bitrate puts more than 1.3 s in a raw budget
+// (raw_buffer_budget), so a refill takes at most ~0.7 s and a one-second
+// queue absorbs it. Only the first fill of a track under ~250 kb/s can still
+// find it short, and a track plays nothing until that fill completes.
+#define RAW_QUEUE_FLOOR_S 1.0
+static int AudioTrack_queueFloor(struct ao *ao, int frames)
+{
+    struct priv *p = ao->priv;
+    if (p->raw_passthrough)
+        return lrint(RAW_QUEUE_FLOOR_S * ao->samplerate);
+    return frames * 2;
+}
