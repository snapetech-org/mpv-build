+    jobject builder = NULL, config = NULL, tmp = NULL, effect = NULL;
+
+    band = MP_JNI_NEW(DynamicsProcessingMbcBand.clazz, DynamicsProcessingMbcBand.ctor,
+                      JNI_TRUE, NORM_MBC_CUTOFF_HZ, NORM_MBC_ATTACK_MS,
+                      NORM_MBC_RELEASE_MS, NORM_MBC_RATIO, NORM_MBC_THRESHOLD_DB,
+                      NORM_MBC_KNEE_DB, NORM_MBC_NOISE_GATE_DB,
+                      NORM_MBC_EXPANDER_RATIO, 0.0f /* preGain */,
+                      NORM_MBC_POST_GAIN_DB);
+    if (normalizer_failed(ao, env) || !band)
+        goto done;
+    mbc = MP_JNI_NEW(DynamicsProcessingMbc.clazz, DynamicsProcessingMbc.ctor,
+                     JNI_TRUE, JNI_TRUE, (jint)1);
+    if (normalizer_failed(ao, env) || !mbc)
+        goto done;
+    MP_JNI_CALL_VOID(mbc, DynamicsProcessingMbc.setBand, (jint)0, band);
+    if (normalizer_failed(ao, env))
+        goto done;
+    limiter = MP_JNI_NEW(DynamicsProcessingLimiter.clazz, DynamicsProcessingLimiter.ctor,
+                         JNI_TRUE, JNI_TRUE, (jint)0 /* linkGroup */,
+                         NORM_LIMITER_ATTACK_MS, NORM_LIMITER_RELEASE_MS,
+                         NORM_LIMITER_RATIO, NORM_LIMITER_THRESHOLD_DB,
+                         0.0f /* postGain */);
+    if (normalizer_failed(ao, env) || !limiter)
+        goto done;
+    // inputGain, preEq (off), one MBC band, postEq (off), limiter
+    channel = MP_JNI_NEW(DynamicsProcessingChannel.clazz, DynamicsProcessingChannel.ctor,
+                         0.0f, JNI_FALSE, (jint)0, JNI_TRUE, (jint)1,
+                         JNI_FALSE, (jint)0, JNI_TRUE);
+    if (normalizer_failed(ao, env) || !channel)
+        goto done;
+    MP_JNI_CALL_VOID(channel, DynamicsProcessingChannel.setMbc, mbc);
+    if (normalizer_failed(ao, env))
+        goto done;
+    MP_JNI_CALL_VOID(channel, DynamicsProcessingChannel.setLimiter, limiter);
+    if (normalizer_failed(ao, env))
+        goto done;
+    builder = MP_JNI_NEW(DynamicsProcessingConfigBuilder.clazz,
+                         DynamicsProcessingConfigBuilder.ctor,
+                         DynamicsProcessing.VARIANT_FAVOR_FREQUENCY_RESOLUTION,
+                         (jint)channels, JNI_FALSE, (jint)0, JNI_TRUE, (jint)1,
+                         JNI_FALSE, (jint)0, JNI_TRUE);
+    if (normalizer_failed(ao, env) || !builder)
+        goto done;
+    tmp = MP_JNI_CALL_OBJECT(builder, DynamicsProcessingConfigBuilder.setPreferredFrameDuration,
+                             NORM_FRAME_DURATION_MS);
+    MP_JNI_LOCAL_FREEP(&tmp);
+    if (normalizer_failed(ao, env))
+        goto done;
+    tmp = MP_JNI_CALL_OBJECT(builder, DynamicsProcessingConfigBuilder.setAllChannelsTo, channel);
+    MP_JNI_LOCAL_FREEP(&tmp);
+    if (normalizer_failed(ao, env))
+        goto done;
+    config = MP_JNI_CALL_OBJECT(builder, DynamicsProcessingConfigBuilder.build);
+    if (normalizer_failed(ao, env) || !config)
+        goto done;
+    effect = MP_JNI_NEW(DynamicsProcessing.clazz, DynamicsProcessing.ctor,
+                        (jint)NORM_EFFECT_PRIORITY, session, config);
+    if (normalizer_failed(ao, env))
+        MP_JNI_LOCAL_FREEP(&effect);
+
+done:
+    MP_JNI_LOCAL_FREEP(&config);
+    MP_JNI_LOCAL_FREEP(&builder);
+    MP_JNI_LOCAL_FREEP(&channel);
+    MP_JNI_LOCAL_FREEP(&limiter);
+    MP_JNI_LOCAL_FREEP(&mbc);
+    MP_JNI_LOCAL_FREEP(&band);
+    return normalizer_enable(ao, env, effect);
+}
