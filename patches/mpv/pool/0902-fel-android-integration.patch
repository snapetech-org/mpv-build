+            p->ka_unit_20_len = sizeof(silence_dts_20);
+            p->ka_unit_51 = silence_dts_51;
+            p->ka_unit_51_len = sizeof(silence_dts_51);
+            break;
+        default:
+            MP_WARN(ao, "stream silence: no silent %s frame for a raw track; "
+                    "the bitstream stops on pause\n", af_fmt_to_str(ao->format));
+            return;
+        }
+        p->ka_unit_frames = codec_frames * p->raw_rate_mult;
+        p->ka_unit_stereo = false;
+    } else {
+        p->ka_unit_frames = burst / ao->sstride;
+    }
+    p->ka_enabled = true;
+    p->ka_head_moved_ns = mp_time_ns();
+    p->chunksize = burst;
+    MP_VERBOSE(ao, "stream silence: %s on the %s track; %d byte reads; "
+               "%d s per pause\n",
+               p->raw_passthrough ? "silent frames" : "zero stuffing",
+               af_fmt_to_str(ao->format), burst, p->cfg_silence_limit);
+}
+
+// Audio is flowing again (or for the first time).
+static void AudioTrack_keepAliveAudio(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (!atomic_exchange(&p->ka_feeding, false))
+        return;
+    MP_VERBOSE(ao, "stream silence: audio is back after %u units of silence (%d ms)\n",
+               p->ka_feed_units,
+               (int)((mp_time_ns() - p->ka_feed_started_ns) / 1000000));
+}
+
+// Worker, p->lock held: end the feed and stand the track down until the core
+// has audio again; `why` says what ended it. The track is paused and flushed
+// as stop() does, so that the output goes to standby and the bitstream stops,
+// and so that the next audio finds the track empty: start() left it paused for
+// its first frame, and this leaves it paused for its next one
+// (AudioTrack_deferredPlay). The clock restarts with the flush, and the core
+// times the resumed audio off the delay it reads back.
+static void AudioTrack_keepAliveStop(struct ao *ao, const char *why)
+{
+    struct priv *p = ao->priv;
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    MP_VERBOSE(ao, "stream silence: %s after %u units of silence (%d ms); the "
+               "%s stops until the core has audio\n", why, p->ka_feed_units,
+               (int)((mp_time_ns() - p->ka_feed_started_ns) / 1000000),
+               p->ka_pad_silence ? "track" : "bitstream");
+    mp_mutex_lock(&p->track_lock);
+    if (p->audiotrack) {
+        MP_JNI_CALL_VOID(p->audiotrack, AudioTrack.pause);
+        MP_JNI_EXCEPTION_LOG(ao);
+        MP_JNI_CALL_VOID(p->audiotrack, AudioTrack.flush);
+        MP_JNI_EXCEPTION_LOG(ao);
+    }
+    mp_mutex_unlock(&p->track_lock);
+    AudioTrack_resetClock(p);
+    p->head_reset_pending = true;
+    p->ts_reset_pending = true;
+    p->ka_stood_down = true;
+    p->ka_wait_ns = KA_POLL_NS;
+    atomic_store(&p->write_outstanding, false);
+    atomic_store(&p->play_deferred, true);
+}
+
+// Worker, p->lock held: a padded PCM read copied nothing, so the chunk about
+// to be written is the core's silence. It counts as feeding for the monitor's
+// stall verdict and for a write that fails (ao_thread), not for the limit.
+static void AudioTrack_keepAlivePad(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (!atomic_exchange(&p->ka_feeding, true)) {
+        p->ka_feed_started_ns = mp_time_ns();
+        p->ka_feed_units = 0;
+        MP_VERBOSE(ao, "stream silence: the core has no audio; writing its padding\n");
+    }
+    p->ka_feed_units++;
+}
+
+// Worker, p->lock held, the track paused for its first audio or its next
+// after a stand-down, and the core without any: wait for it, a little longer
+// each time up to KA_IDLE_NS.
+static void AudioTrack_waitForAudio(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    const int64_t wait = MPCLAMP(p->ka_wait_ns, KA_POLL_NS, KA_IDLE_NS);
+    mp_cond_timedwait(&p->wakeup, &p->lock, wait);
+    p->ka_wait_ns = MPMIN(wait * 2, KA_IDLE_NS);
+}
+
+// One unit of silence to the track, blocking and whole. p->lock is held for
+// the bookkeeping and dropped around the JNI write, as in AudioTrack_write.
+// Returns the unit's credit in carrier bytes, 0 if the track was replaced
+// meanwhile or the write came up short, <0 on error.
+static int AudioTrack_writeSilence(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    jobject buffer;
+    int count, credit;
+    const bool raw = p->raw_passthrough;
+    if (raw) {
+        const uint8_t *unit = p->ka_unit_stereo ? p->ka_unit_20 : p->ka_unit_51;
+        count = p->ka_unit_stereo ? p->ka_unit_20_len : p->ka_unit_51_len;
+        memcpy(p->rawbuf, unit, count);
+        jobject bbuf = MP_JNI_CALL_OBJECT(p->bbuf, ByteBuffer.clear);
+        if (MP_JNI_EXCEPTION_LOG(ao) < 0)
+            return -1;
+        MP_JNI_LOCAL_FREEP(&bbuf);
+        buffer = p->bbuf;
+        credit = p->ka_unit_frames * ao->sstride;
+    } else {
+        // The rest of a cut burst, else a whole one, of zero words.
+        int bytes = p->iec_burst ? p->iec_burst : p->chunksize;
+        if (!p->iec_lost && p->iec_burst && p->iec_pos)
+            bytes = p->iec_burst - p->iec_pos;
+        bytes = MPMIN(bytes, p->chunksize) / ao->sstride * ao->sstride;
+        memset(p->chunk, 0, bytes);
+        (*env)->SetShortArrayRegion(env, p->shortarray, 0, bytes / 2, p->chunk);
+        if (MP_JNI_EXCEPTION_LOG(ao) < 0)
+            return -1;
+        buffer = p->shortarray;
+        count = bytes / 2;
+        credit = bytes;
+    }
+
+    jobject track = (*env)->NewLocalRef(env, p->audiotrack);
+    if (MP_JNI_EXCEPTION_LOG(ao) < 0 || !track)
+        return -1;
+    const uint64_t generation = p->write_generation;
+    mp_mutex_unlock(&p->lock);
+    jint ret = 0;
+    int done = 0;
+    while (done < count) {
+        if (raw) {
+            // A short write leaves ByteBuffer.position on the unwritten tail.
+            ret = MP_JNI_CALL_INT(track, AudioTrack.writeBufferV21, buffer,
+                                  count - done, AudioTrack.WRITE_BLOCKING);
+        } else {
+            ret = MP_JNI_CALL_INT(track, AudioTrack.writeShortV23, buffer, done,
+                                  count - done, AudioTrack.WRITE_BLOCKING);
+        }
+        if (MP_JNI_EXCEPTION_LOG(ao) < 0)
+            ret = -1;
+        if (ret <= 0)
+            break;
+        done += ret;
+    }
+    MP_JNI_LOCAL_FREEP(&track);
+    mp_mutex_lock(&p->lock);
+    if (generation != p->write_generation)
+        return 0;
+    if (ret < 0)
+        return ret;
+    if (!raw && !p->iec_lost && p->iec_burst && p->iec_pos) {
+        // Zero words completing a cut burst keep its place on the grid; zero
+        // words between bursts are not a burst and leave the grid alone.
+        p->iec_pos += done * 2;
+        if (p->iec_pos >= p->iec_burst)
+            p->iec_pos = 0;
+    }
+    if (done < count) {
+        MP_WARN(ao, "stream silence: the track took %d of %d\n", done, count);
+        return raw ? 0 : done * 2;
+    }
+    return credit;
+}
+
+// p->lock held, the track playing and the core out of audio. Feeds one unit
+// of silence when one is due and returns its credit in carrier bytes (what
+// AudioTrack_write returns for audio); 0 after waiting instead, <0 on a
+// write error.
+static int AudioTrack_keepAlive(struct ao *ao, double delay)
+{
+    struct priv *p = ao->priv;
+    const int64_t now = mp_time_ns();
+    const bool feeding = atomic_load(&p->ka_feeding);
+    if (feeding && p->cfg_silence_limit > 0 &&
+        now - p->ka_feed_started_ns >= MP_TIME_S_TO_NS(p->cfg_silence_limit))
+    {
+        AudioTrack_keepAliveStop(ao, "the time limit is up");
+        return 0;
+    }
+    // Until the head has stood still for KA_HEAD_STILL_NS, or 0 once it has.
+    const int64_t still_in = KA_HEAD_STILL_NS - (now - p->ka_head_moved_ns);
+    const bool head_still = still_in <= 0;
+    if (!head_still && delay * 1e9 >= KA_AHEAD_NS) {
+        // Sleep half the way to the queue draining to KA_AHEAD_NS, or to
+        // the head counting as still, whichever comes first: the queue is
+        // judged from the smoothed head, which can lag the real one, and
+        // a wait of the whole way would be a bet on that estimate.
+        const int64_t drained_in = (int64_t)(delay * 1e9) - KA_AHEAD_NS;
+        mp_cond_timedwait(&p->wakeup, &p->lock,
+                          MPMAX(MPMIN(drained_in, still_in) / 2, KA_POLL_NS));
+        return 0;
+    }
+    if (!feeding) {
+        atomic_store(&p->ka_feeding, true);
+        p->ka_feed_started_ns = now;
+        p->ka_feed_units = 0;
+        MP_VERBOSE(ao, "stream silence: the core has no audio; feeding %s "
+                   "(%d ms queued, head %s)\n",
+                   p->raw_passthrough ? (p->ka_unit_stereo ? "2.0 frames" : "5.1 frames")
+                                      : "zero words",
+                   (int)(delay * 1000), head_still ? "still" : "moving");
+    }
+    if (p->raw_passthrough && (p->raw_state != RAW_SYNC_PA || p->raw_have_byte)) {
+        // A burst was cut and its tail will not come while the core is
+        // paused; the frame in the track is lost to concealment either way.
+        // Forget the burst, so the tail is skipped as garbage when it does
+        // come instead of being written after the silence.
+        MP_VERBOSE(ao, "stream silence: a cut frame precedes the silence\n");
+        p->raw_state = RAW_SYNC_PA;
+        p->raw_payload_left = 0;
+        p->raw_have_byte = false;
+        p->raw_dts_header_len = 0;
+    }
+    p->ka_feed_units++;
+    if (!atomic_load(&p->write_outstanding)) {
+        atomic_store(&p->write_progress_ns, now);
+        atomic_store(&p->write_outstanding, true);
+    }
+    return AudioTrack_writeSilence(ao);
+}
+
+// Enter and return with p->lock held. Preparation and completion mutate the
+// parser/accounting; only the blocking JNI write runs outside that lock.
+static int AudioTrack_write(struct ao *ao, int len)
+{
+    struct priv *p = ao->priv;
+    if (!p->audiotrack)
+        return -1;
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    void *buf = p->chunk;
+    jobject buffer;
+    jmethodID method;
+    int count = len, sample_size = 1;
+
+    if (p->raw_passthrough && ao->format == AF_FORMAT_S_TRUEHD) {
+        if (!p->raw_pending) {
+            AudioTrack_unwrapIEC61937(ao, NULL, buf, len);
+            // Credit the audio the completed units hold, 1/1200 s each, not
+            // the carrier they came in: units dropped before a major sync
+            // were never queued, and counting them would offset A/V sync by
+            // their length for the rest of the epoch.
+            const int credit = p->thd_credit *
+                (ao->samplerate / THD_UNITS_PER_S) * ao->sstride;
+            p->thd_credit = 0;
+            int units;
+            const int bytes = AudioTrack_thdGroup(p, &units);
+            if (!bytes)
+                return credit; // held until a whole group is complete
+            p->raw_pending = bytes;
+            p->raw_input_len = credit;
+            p->thd_group_bytes = bytes;
+            p->thd_group_units = units;
+            jobject bbuf = MP_JNI_CALL_OBJECT(p->bbuf, ByteBuffer.clear);
+            if (MP_JNI_EXCEPTION_LOG(ao) < 0) return -1;
+            MP_JNI_LOCAL_FREEP(&bbuf);
+        }
+        buffer = p->bbuf;
+        method = AudioTrack.writeBufferV21;
+        count = p->raw_pending;
+    } else if (p->raw_passthrough) {
+        if (!p->raw_pending) {
+            p->raw_pending = AudioTrack_unwrapIEC61937(ao, p->rawbuf, buf, len);
+            if (p->ka_enabled) {
+                AudioTrack_trackBurst(ao, buf, len);
+                if (p->raw_pending)
+                    AudioTrack_noteLayout(ao, p->rawbuf, p->raw_pending);
+            }
+            if (!p->raw_pending)
+                return len; // only header/padding: consumed, nothing to write
+            p->raw_input_len = len;
+            jobject bbuf = MP_JNI_CALL_OBJECT(p->bbuf, ByteBuffer.clear);
+            if (MP_JNI_EXCEPTION_LOG(ao) < 0) return -1;
+            MP_JNI_LOCAL_FREEP(&bbuf);
+            if (ao->format == AF_FORMAT_S_DTSHD && !p->raw_rate_verified) {
+                const uint64_t generation = p->write_generation;
+                AudioTrack_adoptDtsHdRate(ao);
+                if (generation != p->write_generation)
+                    return 0; // reopened: the worker writes the packet next
+            }
+        }
+        // A short write leaves ByteBuffer.position on the unwritten tail.
+        buffer = p->bbuf;
+        method = AudioTrack.writeBufferV21;
+        count = p->raw_pending;
+    } else if (p->format == AudioFormat.ENCODING_IEC61937) {
+        sample_size = 2;
+        count = len / sample_size;
+        (*env)->SetShortArrayRegion(env, p->shortarray, 0, count, buf);
+        if (MP_JNI_EXCEPTION_LOG(ao) < 0) return -1;
+        buffer = p->shortarray;
+        method = AudioTrack.writeShortV23;
+    } else if (AudioTrack.writeBufferV21) {
+        jobject bbuf = MP_JNI_CALL_OBJECT(p->bbuf, ByteBuffer.clear);
+        if (MP_JNI_EXCEPTION_LOG(ao) < 0) return -1;
+        MP_JNI_LOCAL_FREEP(&bbuf);
+        buffer = p->bbuf;
+        method = AudioTrack.writeBufferV21;
+    } else if (p->format == AudioFormat.ENCODING_PCM_FLOAT) {
+        sample_size = sizeof(float);
+        count = len / sample_size;
+        (*env)->SetFloatArrayRegion(env, p->floatarray, 0, count, buf);
+        if (MP_JNI_EXCEPTION_LOG(ao) < 0) return -1;
+        buffer = p->floatarray;
+        method = AudioTrack.writeFloat;
+    } else {
+        (*env)->SetByteArrayRegion(env, p->bytearray, 0, count, buf);
+        if (MP_JNI_EXCEPTION_LOG(ao) < 0) return -1;
+        buffer = p->bytearray;
+        method = AudioTrack.write;
+    }
+
+    // Retain the track before dropping the accounting lock. Buffer globals
+    // and their backing memory live until uninit joins this single writer;
+    // stop/recreate only reset metadata, never reuse the in-flight storage.
+    jobject track = (*env)->NewLocalRef(env, p->audiotrack);
+    if (MP_JNI_EXCEPTION_LOG(ao) < 0 || !track)
+        return -1;
+    uint64_t generation = p->write_generation;
+    mp_mutex_unlock(&p->lock);
+    jint ret;
+    if (method == AudioTrack.writeBufferV21) {
+        ret = MP_JNI_CALL_INT(track, method, buffer, count, AudioTrack.WRITE_BLOCKING);
+    } else if (method == AudioTrack.write) {
+        ret = MP_JNI_CALL_INT(track, method, buffer, 0, count);
+    } else {
+        ret = MP_JNI_CALL_INT(track, method, buffer, 0, count, AudioTrack.WRITE_BLOCKING);
+    }
+    if (MP_JNI_EXCEPTION_LOG(ao) < 0)
+        ret = -1;
+    MP_JNI_LOCAL_FREEP(&track);
+    mp_mutex_lock(&p->lock);
+    if (generation != p->write_generation)
+        return 0; // caller also discards stale errors/progress/frame credit
+    if (ret < 0)
+        return ret;
+    if (p->raw_passthrough) {
+        p->raw_pending -= ret;
+        if (p->raw_pending)
+            return 0;
+        if (ao->format == AF_FORMAT_S_TRUEHD)
+            AudioTrack_thdTake(p, p->thd_group_bytes, p->thd_group_units);
+        return p->raw_input_len;
+    }
+    if (p->ka_enabled && p->format == AudioFormat.ENCODING_IEC61937)
+        AudioTrack_trackBurst(ao, buf, ret * sample_size);
+    return ret * sample_size;
+}
+
+static void uninit_jni(struct ao *ao)
+{
+    mp_mutex_lock(&jni_static_lock);
+    jni_static_use_count--;
+    if (jni_static_use_count == 0) {
+        JNIEnv *env = MP_JNI_GET_ENV(ao);
+        for (int i = 0; i < MP_ARRAY_SIZE(jclass_list); i++) {
+            mp_jni_reset_jfields(env, jclass_list[i].fields,
+                                jclass_list[i].mapping, 1, ao->log);
+        }
+    }
+    mp_mutex_unlock(&jni_static_lock);
+}
+
+static int init_jni(struct ao *ao)
+{
+    mp_mutex_lock(&jni_static_lock);
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    if (jni_static_use_count == 0) {
+        for (int i = 0; i < MP_ARRAY_SIZE(jclass_list); i++) {
+            if (mp_jni_init_jfields(env, jclass_list[i].fields,
+                                    jclass_list[i].mapping, 1, ao->log) < 0 &&
+                !jclass_list[i].optional) {
+                goto error;
+            }
+        }
+    }
+    jni_static_use_count++;
+    mp_mutex_unlock(&jni_static_lock);
+    return 0;
+
+error:
+    for (int i = 0; i < MP_ARRAY_SIZE(jclass_list); i++) {
+        mp_jni_reset_jfields(env, jclass_list[i].fields,
+                            jclass_list[i].mapping, 1, ao->log);
+    }
+    mp_mutex_unlock(&jni_static_lock);
     return -1;
 }
 
+static jint AudioTrack_getRoutedDeviceId(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    if (!AudioTrack.getRoutedDevice || !AudioDeviceInfo.getId || !p->audiotrack)
+        return 0;
+    jobject device = MP_JNI_CALL_OBJECT(p->audiotrack, AudioTrack.getRoutedDevice);
+    if (MP_JNI_EXCEPTION_LOG(ao) < 0 || !device)
+        return 0;
+    jint id = MP_JNI_CALL_INT(device, AudioDeviceInfo.getId);
+    if (MP_JNI_EXCEPTION_LOG(ao) < 0)
+        id = 0;
+    MP_JNI_LOCAL_FREEP(&device);
+    return id;
+}
+
+// An HDMI mode switch can rebind the route under a live passthrough track,
+// which then drains into silence; reload the AO like media3 does.
+static void AudioTrack_checkRouteChange(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (!p->cfg_route_reload || p->routing_reload_requested)
+        return;
+    if (!p->raw_passthrough && p->format != AudioFormat.ENCODING_IEC61937)
+        return;
+    int64_t now = mp_time_ns();
+    if (p->routing_checked && now - p->routing_checked < MP_TIME_MS_TO_NS(250))
+        return;
+    p->routing_checked = now;
+    jint id = AudioTrack_getRoutedDeviceId(ao);
+    if (!id) {
+        // Unrouted (not started, or mid-renegotiation) is not a change yet.
+        if (p->routed_device)
+            p->routing_lost = true;
+        return;
+    }
+    if (!p->routed_device) {
+        p->routed_device = id;
+        return;
+    }
+    if (id != p->routed_device || p->routing_lost) {
+        MP_WARN(ao, "audio route changed under a passthrough track "
+                "(device %d -> %d), reloading AO\n",
+                (int)p->routed_device, (int)id);
+        p->routing_reload_requested = true;
+        ao_request_reload(ao);
+    }
+}
+
+// Charge one recovery against the current failure episode. Returns false
+// once the budget is spent, after asking the core to end playback.
+static bool AudioTrack_beginRecovery(struct ao *ao, const char *why)
+{
+    struct priv *p = ao->priv;
+    if (atomic_load(&p->failed))
+        return false;
+    int attempt = atomic_fetch_add(&p->recovery_attempts, 1) + 1;
+    if (attempt > STALL_MAX_RECREATES) {
+        MP_ERR(ao, "%s after recreating the AudioTrack; giving up\n", why);
+        atomic_store(&p->failed, true);
+        ao_request_failure(ao);
+        return false;
+    }
+    MP_WARN(ao, "%s; recreating the AudioTrack (attempt %d/%d)\n",
+            why, attempt, STALL_MAX_RECREATES);
+    return true;
+}
+
+// Worker, p->lock held. A replacement that cannot be created is retried
+// every RECREATE_RETRY_NS for RECREATE_GRACE_NS (the output device may be
+// mid-replug, see the constants) before the AO gives up. The retry is the
+// worker's, from the top of its loop: this also runs inside a write, which
+// must not wait here, and the caller finds the track gone meanwhile.
+static void AudioTrack_recreateOrFail(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    if (AudioTrack_Recreate(ao) == 0) {
+        if (p->recreate_deadline_ns)
+            MP_WARN(ao, "AudioTrack recreated once the output device was back\n");
+        p->recreate_deadline_ns = 0;
+        p->recreate_retry_ns = 0;
+        atomic_store(&p->recreate_requested, false);
+        return;
+    }
+    const int64_t now = mp_time_ns();
+    if (!p->recreate_deadline_ns) {
+        p->recreate_deadline_ns = now + RECREATE_GRACE_NS;
+        MP_WARN(ao, "AudioTrack_Recreate failed; the output device may be away, "
+                "retrying for %d ms\n", (int)(RECREATE_GRACE_NS / 1000000));
+    }
+    if (now < p->recreate_deadline_ns) {
+        p->recreate_retry_ns = now + RECREATE_RETRY_NS;
+        atomic_store(&p->recreate_requested, true);
+        return;
+    }
+    p->recreate_deadline_ns = 0;
+    p->recreate_retry_ns = 0;
+    atomic_store(&p->recreate_requested, false);
+    MP_ERR(ao, "AudioTrack_Recreate failed; giving up\n");
+    atomic_store(&p->failed, true);
+    ao_request_failure(ao);
+}
+
+// Worker, p->lock held, the first audio written: start the track that
+// start() left paused (see there), primed instead of empty.
+static void AudioTrack_deferredPlay(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    JNIEnv *env = MP_JNI_GET_ENV(ao);
+    MP_JNI_CALL_VOID(p->audiotrack, AudioTrack.play);
+    MP_JNI_EXCEPTION_LOG(ao);
+    atomic_store(&p->play_deferred, false);
+    MP_VERBOSE(ao, "stream silence: the track starts primed with its %s audio\n",
+               p->ka_stood_down ? "next" : "first");
+    p->ka_stood_down = false;
+    p->ka_wait_ns = KA_POLL_NS;
+}
+
+// Worker, p->lock held: a feed step that began at `since` has ended. While
+// silence is being fed, a step that took KA_STALL_LOG_NS or longer is
+// logged, since the feed only keeps KA_AHEAD_NS queued (see the constants).
+static void AudioTrack_kaStep(struct ao *ao, const char *step, int64_t since)
+{
+    struct priv *p = ao->priv;
+    const int64_t took = mp_time_ns() - since;
+    if (p->ka_feeding && took >= KA_STALL_LOG_NS)
+        MP_WARN(ao, "stream silence: %s took %d ms during the feed\n", step,
+                (int)(took / 1000000));
+}
+
 static MP_THREAD_VOID ao_thread(void *arg)
 {
     struct ao *ao = arg;
     struct priv *p = ao->priv;
     JNIEnv *env = MP_JNI_GET_ENV(ao);
     mp_thread_set_name("ao/audiotrack");
+    // Only the device buffer outlives a stalled worker, and at default
