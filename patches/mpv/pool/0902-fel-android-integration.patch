+// --audiotrack-normalize: loudness normalization by a platform audio effect on
+// the track's audio session, approximating loudnorm=I=-14:TP=-3:LRA=4 (the
+// same effect and parameters as Plezy's ExoPlayer backend). The effect runs
+// in AudioFlinger's mixer, so it costs the player nothing. loudnorm in --af
+// runs on the core thread at f64/192 kHz; on 32-bit TV boxes that pass took
+// long enough to make the video frames the same thread hands to
+// vo_mediacodec late.
+//
+// API 28+: DynamicsProcessing, one full-band compressor as a slow AGC with
+// makeup gain toward -14 LUFS, then a limiter at the -3 dB peak ceiling. Older
+// platforms, or a device without its effect HAL: LoudnessEnhancer, a fixed
+// boost with built-in limiting. Effects only process mixed PCM; bitstream
+// tracks are left alone.
+#define NORM_EFFECT_PRIORITY 0
+#define NORM_FRAME_DURATION_MS 10.0f
+#define NORM_MBC_CUTOFF_HZ 20000.0f
+#define NORM_MBC_ATTACK_MS 30.0f
+#define NORM_MBC_RELEASE_MS 300.0f
+#define NORM_MBC_RATIO 4.0f
+#define NORM_MBC_THRESHOLD_DB (-34.0f)
+#define NORM_MBC_KNEE_DB 6.0f
+#define NORM_MBC_NOISE_GATE_DB (-90.0f) // effectively off
+#define NORM_MBC_EXPANDER_RATIO 1.0f    // no downward expansion
+#define NORM_MBC_POST_GAIN_DB 15.0f
+#define NORM_LIMITER_ATTACK_MS 1.0f
+#define NORM_LIMITER_RELEASE_MS 60.0f
+#define NORM_LIMITER_RATIO 10.0f
+#define NORM_LIMITER_THRESHOLD_DB (-3.0f)
+#define NORM_LOUDNESS_ENHANCER_GAIN_MB 900 // +9 dB
+
+// A failed effect means a fallback, not a broken AO: clear and log the
+// pending exception, if any, at warn level.
+static bool normalizer_failed(struct ao *ao, JNIEnv *env)
+{
+    if (!(*env)->ExceptionCheck(env))
+        return false;
+    jthrowable exception = (*env)->ExceptionOccurred(env);
+    (*env)->ExceptionClear(env);
+    char *message = NULL;
+    if (mp_jni_exception_get_summary(env, exception, &message, ao->log) >= 0)
+        MP_WARN(ao, "normalization: %s\n", message);
+    talloc_free(message);
+    MP_JNI_LOCAL_FREEP(&exception);
+    return true;
+}
