+// A JNI call of a retried replacement (AudioTrack_recreateOrFail) threw:
+// the output device is expected to be away, so the exception is cleared and
+// its summary noted at verbose level, where MP_JNI_EXCEPTION_LOG would log
+// an error every RECREATE_RETRY_NS and MP_JNI_EXCEPTION_CHECK would clear
+// it unseen. Returns -1 with the exception cleared, 0 if there was none.
+static int AudioTrack_pendingAttemptThrew(struct ao *ao, JNIEnv *env, const char *what)
+{
+    if (!(*env)->ExceptionCheck(env))
+        return 0;
+    jthrowable exception = (*env)->ExceptionOccurred(env);
+    (*env)->ExceptionClear(env);
+    char *message = NULL;
+    if (mp_jni_exception_get_summary(env, exception, &message, ao->log) >= 0) {
+        MP_VERBOSE(ao, "%s; the replacement is pending: %s\n", what, message);
+    } else {
+        MP_VERBOSE(ao, "%s; the replacement is pending\n", what);
+    }
+    talloc_free(message);
+    MP_JNI_LOCAL_FREEP(&exception);
+    return -1;
+}
