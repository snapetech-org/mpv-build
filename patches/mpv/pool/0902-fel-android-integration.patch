+// Enables a freshly created effect; releases it and returns NULL on failure.
+static jobject normalizer_enable(struct ao *ao, JNIEnv *env, jobject effect)
+{
+    if (!effect)
+        return NULL;
+    jint ret = MP_JNI_CALL_INT(effect, AudioEffect.setEnabled, JNI_TRUE);
+    if (!normalizer_failed(ao, env) && ret == 0) // AudioEffect.SUCCESS
+        return effect;
+    MP_WARN(ao, "normalization: effect could not be enabled (%d)\n", (int)ret);
+    MP_JNI_CALL_VOID(effect, AudioEffect.release);
+    normalizer_failed(ao, env);
+    MP_JNI_LOCAL_FREEP(&effect);
+    return NULL;
+}
