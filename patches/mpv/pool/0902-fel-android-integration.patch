+static jobject normalizer_new_loudness_enhancer(struct ao *ao, JNIEnv *env,
+                                                jint session)
+{
+    if (!LoudnessEnhancer.clazz)
+        return NULL;
+    jobject effect = MP_JNI_NEW(LoudnessEnhancer.clazz, LoudnessEnhancer.ctor, session);
+    if (normalizer_failed(ao, env) || !effect) {
+        MP_JNI_LOCAL_FREEP(&effect);
+        return NULL;
+    }
+    MP_JNI_CALL_VOID(effect, LoudnessEnhancer.setTargetGain,
+                     (jint)NORM_LOUDNESS_ENHANCER_GAIN_MB);
+    if (normalizer_failed(ao, env)) {
+        MP_JNI_CALL_VOID(effect, AudioEffect.release);
+        normalizer_failed(ao, env);
+        MP_JNI_LOCAL_FREEP(&effect);
+        return NULL;
+    }
+    return normalizer_enable(ao, env, effect);
