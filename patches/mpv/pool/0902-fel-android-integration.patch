+// Pa Pb as the little-endian words lie on the wire.
+static const uint8_t iec_preamble[4] = {0x72, 0xf8, 0x1f, 0x4e};
+// --- end stream-silence-data
+
+// What one burst of a data type occupies on the carrier: spdifenc's
+// repetition period (pkt_offset), payload and zero padding together. Pc is
+// the whole word; DTS-HD keeps its period in the subtype bits.
+static int iec_burst_bytes(int pc)
+{
+    switch (pc & 0x7f) {
+    case IEC61937_AC3:    return 1536 * 4;
+    case IEC61937_EAC3:   return 6144 * 4;
+    case IEC61937_TRUEHD: return MAT_BURST_SIZE;
+    case IEC61937_DTS1:   return 512 * 4;
+    case IEC61937_DTS2:   return 1024 * 4;
+    case IEC61937_DTS3:   return 2048 * 4;
+    case IEC61937_DTSHD:  return (512 << ((pc >> 8) & 0x1f)) * 4;
+    default:              return 0;
+    }
+}
+
+// The largest burst a format produces: the read size until the stream's own
+// is known, so that reads hold whole bursts from the first one.
+static int ka_default_burst(int format)
+{
+    switch (format) {
+    case AF_FORMAT_S_AC3:    return 1536 * 4;
+    case AF_FORMAT_S_EAC3:   return 6144 * 4;
+    case AF_FORMAT_S_TRUEHD: return MAT_BURST_SIZE;
+    case AF_FORMAT_S_DTS:    return 2048 * 4;
+    case AF_FORMAT_S_DTSHD:  return (512 << 5) * 4;
+    default:                 return 0;
+    }
+}
+
+// Follow the bursts in the carrier bytes as they go to the track, so that
+// silence starts only where one ends. A burst opens with Pa Pb Pc Pd
+// (little-endian words on the wire) and runs for the period its Pc names;
+// bytes that do not open with a preamble mean the stream was cut mid-burst
+// (a seek dropped a tail), and the tracker scans for the next preamble.
+static void AudioTrack_trackBurst(struct ao *ao, const uint8_t *buf, int len)
+{
+    struct priv *p = ao->priv;
+    for (int i = 0; i < len;) {
+        if (p->iec_lost) {
+            memmove(p->iec_header, p->iec_header + 1, 3);
+            p->iec_header[3] = buf[i++];
+            if (!memcmp(p->iec_header, iec_preamble, sizeof(iec_preamble))) {
+                p->iec_lost = false;
+                p->iec_pos = 4;
+            }
+            continue;
+        }
+        if (p->iec_pos < 8) {
+            p->iec_header[p->iec_pos++] = buf[i++];
+            if (p->iec_pos == 4 &&
+                memcmp(p->iec_header, iec_preamble, sizeof(iec_preamble)))
+            {
+                MP_VERBOSE(ao, "stream silence: off the burst grid, scanning for a preamble\n");
+                p->iec_lost = true;
+            } else if (p->iec_pos == 8) {
+                const int pc = p->iec_header[4] | p->iec_header[5] << 8;
+                const int burst = iec_burst_bytes(pc);
+                if (!burst) {
+                    if (!p->ka_unsupported_logged) {
+                        p->ka_unsupported_logged = true;
+                        MP_WARN(ao, "stream silence: no burst period for IEC 61937 "
+                                "data type 0x%x; zero stuffing only\n", pc & 0x7f);
+                    }
+                    p->iec_lost = true;
+                } else if (burst != p->iec_burst) {
+                    MP_VERBOSE(ao, "stream silence: %d byte bursts\n", burst);
+                    p->iec_burst = burst;
+                }
+            }
+            continue;
+        }
+        const int step = MPMIN(len - i, p->iec_burst - p->iec_pos);
+        p->iec_pos += step;
+        i += step;
+        if (p->iec_pos >= p->iec_burst)
+            p->iec_pos = 0;
+    }
+}
+
+// Pick the 2.0 or the 5.1 silent frame after the layout the real frames
+// carry, read off the header of each frame the raw track gets.
+static void AudioTrack_noteLayout(struct ao *ao, const uint8_t *f, int len)
+{
+    struct priv *p = ao->priv;
+    bool stereo = p->ka_unit_stereo;
+    if (len >= 9 && f[0] == 0x0b && f[1] == 0x77) {
+        // AC-3 (bsid <= 8) carries acmod after the syncinfo; E-AC-3 (bsid
+        // 11-16) in its fourth header byte.
+        const int bsid = f[5] >> 3;
+        const int acmod = bsid <= 8 ? f[6] >> 5 : (f[4] >> 1) & 7;
+        stereo = acmod <= 2; // 1+1, 1/0, 2/0
+    } else if (len >= 9 && f[0] == 0x7f && f[1] == 0xfe &&
+               f[2] == 0x80 && f[3] == 0x01)
+    {
+        const int amode = (f[7] & 0x0f) << 2 | f[8] >> 6;
+        stereo = amode <= 4; // mono, dual mono, L/R, (L+R)/(L-R), Lt/Rt
+    }
+    if (stereo != p->ka_unit_stereo) {
+        p->ka_unit_stereo = stereo;
+        MP_VERBOSE(ao, "stream silence: the stream is %s, so is the silence\n",
+                   stereo ? "2.0" : "5.1");
+    }
+}
+
+// Decide at init whether this track can stream silence and with what, and
+// size the reads to whole bursts. Runs once the transport and the track
+// buffer are chosen, before the chunk is allocated.
+static void AudioTrack_initKeepAlive(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    p->ka_enabled = false;
