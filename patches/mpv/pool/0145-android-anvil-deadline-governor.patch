-    record_deadline_miss(p, p->pend[slot].t_total,
-                         p->pend[slot].pts_prev, p->pend[slot].pts_curr);
+    const bool missed_deadline = record_deadline_miss(
+        p, f, p->pend[slot].t_total,
+        p->pend[slot].pts_prev, p->pend[slot].pts_curr,
+        p->pend[slot].neural_probe);
+    if (missed_deadline || p->neural_bypass_until_ms > get_time_ms()) {
+        p->last_qnn_success = false;
+        mp_image_unrefp(&out);
+    }
+    if (p->pend[slot].neural_probe) {
+        finish_neural_probe(p, f, p->last_qnn_success && out != NULL);
+        p->pend[slot].neural_probe = false;
+    }
 
     if (p->frame_count % p->log_interval == 0)
         MP_INFO(f, "ANVIL[GPU/async]: total=%.1fms  P1a=%.1f  GPU=%.1f  copy=%.1f  P3=%.1f  P4%s=%.1f\n",
@@ -2986,7 +3055,13 @@
         out->pts = (prev->pts + curr->pts) / 2.0;
         double t_p4 = get_time_ms() - t_phase;
         double t_all = get_time_ms() - t_total;
-        record_deadline_miss(p, t_total, prev->pts, curr->pts);
+        const bool missed_deadline = record_deadline_miss(
+            p, f, t_total, prev->pts, curr->pts, p->neural_probe_in_flight);
+        if (missed_deadline || p->neural_bypass_until_ms > get_time_ms()) {
+            p->last_qnn_success = false;
+            mp_image_unrefp(&out);
+            return NULL;
+        }
 
         if (p->frame_count % p->log_interval == 0)
             MP_INFO(f, "ANVIL[GPU%s]: total=%.1fms  P1a=%.1f  GPU=%.1f  copy=%.1f  P3=%.1f  P4%s=%.1f\n",
@@ -3116,7 +3191,13 @@
         out->pts = (prev->pts + curr->pts) / 2.0;
         double t_p4 = get_time_ms() - t_phase;
         double t_all = get_time_ms() - t_total;
-        record_deadline_miss(p, t_total, prev->pts, curr->pts);
+        const bool missed_deadline = record_deadline_miss(
+            p, f, t_total, prev->pts, curr->pts, p->neural_probe_in_flight);
+        if (missed_deadline || p->neural_bypass_until_ms > get_time_ms()) {
+            p->last_qnn_success = false;
+            mp_image_unrefp(&out);
+            return NULL;
+        }
 
         if (p->frame_count % p->log_interval == 0)
             MP_INFO(f, "ANVIL[CPU]: total=%.1fms  P1=%.1f  P2=%.1f  P3=%.1f  P4=%.1f\n",
@@ -3177,6 +3258,37 @@
     return mean_difference >= 44 && changed_samples * 100 >= total_samples * 68;
 }
 
+static void bypass_current_frame(struct mp_filter *f, struct priv *p,
+                                 struct mp_frame frame, struct mp_image *mpi)
+{
+    for (int slot = 0; slot < 2; slot++) {
+        if (p->pend[slot].active) {
+            struct mp_image *orphan = finish_interpolation(p, f, slot);
+            mp_image_unrefp(&orphan);
+        }
+    }
+
+    p->pend_cur = 0;
+    p->last_qnn_success = false;
+    p->last_frame_generated = false;
+    p->overlap_active = 0;
+    p->deadline_bypass_frames++;
+    mp_image_unrefp(&p->prev);
+    p->prev = mp_image_new_ref(mpi);
+
+    if (p->stored_curr.type == MP_FRAME_VIDEO) {
+        mp_pin_in_write(f->ppins[1], p->stored_curr);
+        p->stored_curr = (struct mp_frame){0};
+        p->overlap_curr = frame;
+        p->overlap_active = 1;
+        p->state = STATE_HAVE_CURR;
+        mp_filter_internal_mark_progress(f);
+        return;
+    }
+
+    mp_pin_in_write(f->ppins[1], frame);
+}
+
 static void f_process(struct mp_filter *f)
 {
     struct priv *p = f->priv;
@@ -3194,7 +3306,7 @@
             out = p->interp;
             p->interp = NULL;
         }
-        if (p->opts->require_neural && !p->last_qnn_success) {
+        if (!out || (p->opts->require_neural && !p->last_qnn_success)) {
             mp_image_unrefp(&out);
             p->last_frame_generated = false;
             mp_pin_in_write(f->ppins[1], p->stored_curr);
@@ -3256,6 +3368,17 @@
     struct mp_image *mpi = frame.data;
     p->frame_count++;
     int W = mpi->w, H = mpi->h;
+
+    const double now_ms = get_time_ms();
+    if (p->neural_bypass_until_ms > now_ms) {
+        bypass_current_frame(f, p, frame, mpi);
+        return;
+    }
+    if (p->neural_bypass_until_ms > 0.0) {
+        p->neural_bypass_until_ms = 0.0;
+        p->neural_probe_pending = true;
+        MP_INFO(f, "ANVIL: Neural cooldown ended; probing one pair before resuming interpolation\n");
+    }
 
     // Qualcomm contexts are generated at either 1280x720 or 1920x1080. The
     // shader/CPU stages consume planar YUV420 at the selected shape. Do not
@@ -3410,14 +3533,25 @@
             // Step 2: Finish PREVIOUS interpolation (wait for its accelerator job).
             struct mp_image *prev_interp = finish_interpolation(p, f, prev_slot);
 
-            // Submit the prepared pair after the worker has released the prior
-            // slot. Its inference now overlaps output of the previous pair.
-            htp_kick_async(p, new_slot);
+            // A deadline storm may have armed the governor while the new pair
+            // was being prepared. Do not launch accelerator work after that
+            // transition; the following source frame will continue through
+            // the normal MPV fallback path.
+            if (p->neural_bypass_until_ms > get_time_ms()) {
+                p->deadline_bypass_frames++;
+                mp_image_unrefp(&p->pend[new_slot].out);
+                p->pend[new_slot].active = 0;
+                p->pend[new_slot].neural_probe = false;
+            } else {
+                // Submit after the worker has released the prior slot. Its
+                // inference now overlaps output of the previous pair.
+                htp_kick_async(p, new_slot);
+            }
 
             // Step 3: Output the previous pair. A failed HTP inference is a
             // passthrough, not a classical MV-blend substitute.
             bool inference_ok = p->last_qnn_success;
-            if (p->opts->require_neural && !inference_ok) {
