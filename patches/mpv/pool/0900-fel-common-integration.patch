     av_packet_free(pkt);
 }
 
+// Profile name for an H.264 or HEVC stream from its decoder configuration
+// record (MKV CodecPrivate, MP4 stsd), as the decoder names it once it has
+// parsed the SPS the record was written from. Demuxers use this to publish
+// codec_profile before any decoder ran, so a client can decide the decode
+// path at file load (e.g. route H.264 High 10 or HEVC Main 10 to software on
+// hardware that has no such profile) instead of after a failed hardware
+// init. NULL if unknown.
+const char *mp_codec_profile_from_extradata(const char *codec,
+                                            const unsigned char *extradata,
+                                            int extradata_size)
+{
+    if (!codec || !extradata)
+        return NULL;
+    if (strcmp(codec, "h264") == 0) {
+        // avcC: configurationVersion, profile_idc, then the constraint_set
+        // flags (set0 in the top bit). The decoder refines the profile with
+        // two of them, as ff_h264_get_profile() does.
+        if (extradata_size < 7 || extradata[0] != 1)
+            return NULL;
+        int profile = extradata[1];
+        bool set1 = extradata[2] & 0x40, set3 = extradata[2] & 0x10;
+        if (profile == AV_PROFILE_H264_BASELINE && set1)
+            profile |= AV_PROFILE_H264_CONSTRAINED;
+        if ((profile == AV_PROFILE_H264_HIGH_10 ||
+             profile == AV_PROFILE_H264_HIGH_422 ||
+             profile == AV_PROFILE_H264_HIGH_444_PREDICTIVE) && set3)
+            profile |= AV_PROFILE_H264_INTRA;
+        return avcodec_profile_name(AV_CODEC_ID_H264, profile);
+    }
+    if (strcmp(codec, "hevc") == 0) {
+        // hvcC: configurationVersion, then general_profile_space (2 bits),
+        // general_tier_flag (1) and general_profile_idc (5), then the 32
+        // general_profile_compatibility_flags (flag 0 in the top bit); 23
+        // bytes precede the parameter set arrays. A profile_idc of 0 takes
+        // the first compatible profile, as the decoder's PTL parsing does.
+        if (extradata_size < 23 || extradata[0] != 1)
+            return NULL;
+        int profile = extradata[1] & 0x1f;
+        for (int i = 1; !profile && i < 32; i++) {
+            if (extradata[2 + i / 8] & (0x80 >> (i % 8)))
+                profile = i;
+        }
+        return avcodec_profile_name(AV_CODEC_ID_HEVC, profile);
+    }
+    return NULL;
+}
+
 void mp_codec_info_from_av(const AVCodecContext *avctx, struct mp_codec_params *c)
 {
     c->codec_profile = av_get_profile_name(avctx->codec, avctx->profile);
