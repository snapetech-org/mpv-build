diff --git a/video/out/osd_ahead.c b/video/out/osd_ahead.c
new file mode 100644
index 0000000000000000000000000000000000000000..69dfb8dcce430e2d081f6b5b2b677dea0076ac23
--- /dev/null
+++ b/video/out/osd_ahead.c
@@ -0,0 +1,874 @@
