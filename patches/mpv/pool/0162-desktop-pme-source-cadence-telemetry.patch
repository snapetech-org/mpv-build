-static bool frame_pair_matches_supported_cadence(const struct mp_image *previous,
-                                                  const struct mp_image *current)
+static int frame_pair_supported_cadence_fps(const struct mp_image *previous,
+                                            const struct mp_image *current)
 {
     if (!previous || !current || !isfinite(previous->pts) || !isfinite(current->pts) ||
         previous->pts == MP_NOPTS_VALUE || current->pts == MP_NOPTS_VALUE ||
         current->pts <= previous->pts)
-        return false;
+        return 0;
 
     const double duration = current->pts - previous->pts;
     const double tolerance = 0.002; // 2 ms; rejects VFR and discontinuous pairs.
-    return fabs(duration - 1.0 / 24.0) <= tolerance ||
-           fabs(duration - 1.0 / 30.0) <= tolerance;
+    if (fabs(duration - 1.0 / 24.0) <= tolerance)
+        return 24;
+    if (fabs(duration - 1.0 / 30.0) <= tolerance)
+        return 30;
+    return 0;
+}
+
+static int observe_source_cadence(struct priv *p,
+                                  const struct mp_image *previous,
+                                  const struct mp_image *current)
+{
+    if (!previous) {
+        reset_source_cadence(p, PME_SOURCE_CADENCE_UNKNOWN);
+        return 0;
+    }
+    if (!current || !isfinite(previous->pts) || !isfinite(current->pts) ||
+        previous->pts == MP_NOPTS_VALUE || current->pts == MP_NOPTS_VALUE ||
+        current->pts <= previous->pts) {
+        reset_source_cadence(p, PME_SOURCE_CADENCE_DISCONTINUITY);
+        return 0;
+    }
+
+    const int fps = frame_pair_supported_cadence_fps(previous, current);
+    if (!fps) {
+        reset_source_cadence(p, PME_SOURCE_CADENCE_NON_UNIFORM);
+        return 0;
+    }
+
+    if (p->source_cadence_candidate_fps != fps) {
+        p->source_cadence_candidate_fps = fps;
+        p->source_cadence_samples = 1;
+        p->source_cadence_state = PME_SOURCE_CADENCE_PROBING;
+    } else if (p->source_cadence_samples < PME_SOURCE_CADENCE_CONFIRMATION_PAIRS) {
+        p->source_cadence_samples++;
+    }
+
+    if (p->source_cadence_samples >= PME_SOURCE_CADENCE_CONFIRMATION_PAIRS) {
+        p->source_cadence_state = fps == 24 ? PME_SOURCE_CADENCE_CFR_24 :
+                                             PME_SOURCE_CADENCE_CFR_30;
+    }
+    publish_source_cadence(p);
+    return p->source_cadence_state == PME_SOURCE_CADENCE_CFR_24 ||
+           p->source_cadence_state == PME_SOURCE_CADENCE_CFR_30 ? fps : 0;
+}
+
+static const char *source_cadence_state_name(int state)
+{
+    switch (state) {
+    case PME_SOURCE_CADENCE_PROBING: return "probing";
+    case PME_SOURCE_CADENCE_CFR_24: return "cfr-24";
+    case PME_SOURCE_CADENCE_CFR_30: return "cfr-30";
+    case PME_SOURCE_CADENCE_NON_UNIFORM: return "non-uniform-pts";
+    case PME_SOURCE_CADENCE_DISCONTINUITY: return "pts-discontinuity";
+    default: return "unknown";
+    }
 }
 
