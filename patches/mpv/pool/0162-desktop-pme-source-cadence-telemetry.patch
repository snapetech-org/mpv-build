+static void publish_source_cadence(struct priv *p)
+{
+    const bool lock_initialized = p->pme_worker_sync_initialized;
+    if (lock_initialized)
+        pthread_mutex_lock(&p->pme_worker_mutex);
+    p->published_stats.source_cadence_state = p->source_cadence_state;
+    p->published_stats.source_cadence_samples = p->source_cadence_samples;
+    p->published_stats.source_cadence_fps =
+        p->source_cadence_state == PME_SOURCE_CADENCE_CFR_24 ? 24 :
+        p->source_cadence_state == PME_SOURCE_CADENCE_CFR_30 ? 30 : 0;
+    if (lock_initialized)
+        pthread_mutex_unlock(&p->pme_worker_mutex);
+}
+
+static void reset_source_cadence(struct priv *p,
+                                 enum pme_source_cadence_state state)
+{
+    p->source_cadence_state = state;
+    p->source_cadence_candidate_fps = 0;
+    p->source_cadence_samples = 0;
+    publish_source_cadence(p);
+}
