+// ====================================================================
+// Section 4: Inline bilinear YUV sampling helpers
+// ====================================================================
+
+// Bilinear sample a single uint8 plane with float coords.
+// Clamps to image bounds. Used for Y, U, V planes independently.
+static inline float sample_plane_bilinear(const uint8_t *plane, int stride,
+                                           int W, int H, float sx, float sy)
+{
+    int x0 = (int)floorf(sx), y0 = (int)floorf(sy);
+    int x1 = x0 + 1, y1 = y0 + 1;
+    float wx = sx - x0, wy = sy - y0;
+    if (x0 < 0) x0 = 0; if (x0 >= W) x0 = W - 1;
+    if (x1 < 0) x1 = 0; if (x1 >= W) x1 = W - 1;
+    if (y0 < 0) y0 = 0; if (y0 >= H) y0 = H - 1;
+    if (y1 < 0) y1 = 0; if (y1 >= H) y1 = H - 1;
+    float v00 = (float)plane[y0 * stride + x0];
+    float v10 = (float)plane[y0 * stride + x1];
+    float v01 = (float)plane[y1 * stride + x0];
+    float v11 = (float)plane[y1 * stride + x1];
+    return (1 - wx) * (1 - wy) * v00 + wx * (1 - wy) * v10
+         + (1 - wx) * wy * v01       + wx * wy * v11;
+}
+
+// Sample a YUV420P pixel at fractional coords, convert to RGB [0,1].
+// Handles Y at full res, U/V at half res.
+static inline void sample_yuv_to_rgb(const uint8_t *Y, int y_stride,
+                                      const uint8_t *U, int u_stride,
+                                      const uint8_t *V, int v_stride,
+                                      int W, int H,
+                                      float sx, float sy,
+                                      float *out_r, float *out_g, float *out_b)
+{
+    float yv = sample_plane_bilinear(Y, y_stride, W, H, sx, sy);
+    // Chroma planes are half resolution
+    int cW = W >> 1, cH = H >> 1;
+    float csx = sx * 0.5f, csy = sy * 0.5f;
+    float uv = sample_plane_bilinear(U, u_stride, cW, cH, csx, csy);
+    float vv = sample_plane_bilinear(V, v_stride, cW, cH, csx, csy);
+
+    float yf = 1.164f * (yv - 16.0f);
+    float uf = uv - 128.0f;
+    float vf = vv - 128.0f;
+    *out_r = (yf + 1.793f * vf) / 255.0f;
+    *out_g = (yf - 0.213f * uf - 0.533f * vf) / 255.0f;
+    *out_b = (yf + 2.112f * uf) / 255.0f;
+}
+
+// ====================================================================
+// Section 5: Multi-threaded fused Phase 2 — warp+yuv2rgb+blend+pack+quant
+// ====================================================================
+
+struct phase2_args {
+    int y_start, y_end;
+    int W, H;
+    const uint8_t *prev_Y, *prev_U, *prev_V;
+    int prev_ys, prev_us, prev_vs;
+    const uint8_t *curr_Y, *curr_U, *curr_V;
+    int curr_ys, curr_us, curr_vs;
+    const float *flow_x, *flow_y;
+    float *input_buf;
+    float *blend_r, *blend_g, *blend_b;
+};
+
+static void *phase2_thread_fn(void *arg)
+{
+    struct phase2_args *a = arg;
+    const int W = a->W, H = a->H;
+    const size_t plane = (size_t)W * H;
+
+    for (int y = a->y_start; y < a->y_end; y++) {
+        for (int x = 0; x < W; x++) {
+            const int idx = y * W + x;
+            const float fxx = a->flow_x[idx] * 0.5f;
+            const float fyy = a->flow_y[idx] * 0.5f;
+            float r0, g0, b0, r1, g1, b1;
+            sample_yuv_to_rgb(a->prev_Y, a->prev_ys, a->prev_U, a->prev_us,
+                              a->prev_V, a->prev_vs, W, H,
+                              (float)x - fxx, (float)y - fyy, &r0, &g0, &b0);
+            sample_yuv_to_rgb(a->curr_Y, a->curr_ys, a->curr_U, a->curr_us,
+                              a->curr_V, a->curr_vs, W, H,
+                              (float)x + fxx, (float)y + fyy, &r1, &g1, &b1);
+            a->blend_r[idx] = (r0 + r1) * 0.5f;
+            a->blend_g[idx] = (g0 + g1) * 0.5f;
+            a->blend_b[idx] = (b0 + b1) * 0.5f;
+            a->input_buf[0 * plane + idx] = r0;
+            a->input_buf[1 * plane + idx] = g0;
+            a->input_buf[2 * plane + idx] = b0;
+            a->input_buf[3 * plane + idx] = r1;
+            a->input_buf[4 * plane + idx] = g1;
+            a->input_buf[5 * plane + idx] = b1;
+        }
+    }
+    return NULL;
+}
+
+// ====================================================================
+// Section 6: Multi-threaded fused Phase 4 — dequant+residual+clamp+rgb2yuv
+// ====================================================================
+
+struct phase4_args {
+    int y_start, y_end;
+    int W, H;
+    const float *blend_r, *blend_g, *blend_b;
+    const float *output_buf;
+    int pme_ok;
+    uint8_t *out_Y, *out_U, *out_V;
+    int out_ys, out_us, out_vs;
+};
+
+#ifdef __ARM_NEON
+static inline void rgb_to_y_row_neon(const float *r_row, const float *g_row,
+                                      const float *b_row, uint8_t *y_out,
+                                      int W)
+{
+    const float32x4_t v_yr = vdupq_n_f32(BT709_YR);
+    const float32x4_t v_yg = vdupq_n_f32(BT709_YG);
+    const float32x4_t v_yb = vdupq_n_f32(BT709_YB);
+    const float32x4_t v_16 = vdupq_n_f32(16.0f);
+    const float32x4_t v_half = vdupq_n_f32(0.5f);
+    const float32x4_t v_0 = vdupq_n_f32(0.0f);
+    const float32x4_t v_255 = vdupq_n_f32(255.0f);
+    int x = 0;
+    for (; x + 3 < W; x += 4) {
+        float32x4_t r = vld1q_f32(r_row + x);
+        float32x4_t g = vld1q_f32(g_row + x);
+        float32x4_t b = vld1q_f32(b_row + x);
+        float32x4_t yv = vmlaq_f32(v_16, r, v_yr);
+        yv = vmlaq_f32(yv, g, v_yg);
+        yv = vmlaq_f32(yv, b, v_yb);
+        yv = vaddq_f32(yv, v_half);
+        yv = vmaxq_f32(yv, v_0);
+        yv = vminq_f32(yv, v_255);
+        uint32x4_t yi = vcvtq_u32_f32(yv);
+        uint16x4_t yi16 = vmovn_u32(yi);
+        uint8x8_t yi8 = vmovn_u16(vcombine_u16(yi16, yi16));
+        vst1_lane_u32((uint32_t *)(y_out + x), vreinterpret_u32_u8(yi8), 0);
+    }
+    for (; x < W; x++) {
+        float yv = BT709_YR * r_row[x] + BT709_YG * g_row[x] + BT709_YB * b_row[x] + 16.0f;
+        int iv = (int)(yv + 0.5f);
+        y_out[x] = (uint8_t)(iv < 0 ? 0 : (iv > 255 ? 255 : iv));
+    }
+}
+#endif
+
+static inline float clamp_unit(float value)
+{
+    return value < 0.0f ? 0.0f : value > 1.0f ? 1.0f : value;
+}
+
+static inline void pme_rgb_at(const struct phase4_args *a, int x, int y,
+                              float *r, float *g, float *b)
+{
+    const size_t idx = (size_t)y * a->W + x;
+    const size_t plane = (size_t)a->W * a->H;
+    *r = a->blend_r[idx];
+    *g = a->blend_g[idx];
+    *b = a->blend_b[idx];
+    if (a->pme_ok && a->output_buf) {
+        *r += a->output_buf[0 * plane + idx];
+        *g += a->output_buf[1 * plane + idx];
+        *b += a->output_buf[2 * plane + idx];
+    }
+    *r = clamp_unit(*r);
+    *g = clamp_unit(*g);
+    *b = clamp_unit(*b);
+}
+
+static void *phase4_thread_fn(void *arg)
+{
+    struct phase4_args *a = arg;
+    const int W = a->W;
+    for (int y = a->y_start; y < a->y_end; y++) {
+        float r_stack[1920], g_stack[1920], b_stack[1920];
+        float *rr = W <= 1920 ? r_stack : malloc((size_t)W * sizeof(float));
+        float *gg = W <= 1920 ? g_stack : malloc((size_t)W * sizeof(float));
+        float *bb = W <= 1920 ? b_stack : malloc((size_t)W * sizeof(float));
+        if (!rr || !gg || !bb) {
+            if (W > 1920) { free(rr); free(gg); free(bb); }
+            return NULL;
+        }
+
+        for (int x = 0; x < W; x++)
+            pme_rgb_at(a, x, y, &rr[x], &gg[x], &bb[x]);
+
+        uint8_t *yrow = a->out_Y + y * a->out_ys;
+#ifdef __ARM_NEON
+        rgb_to_y_row_neon(rr, gg, bb, yrow, W);
+#else
+        for (int x = 0; x < W; x++) {
+            float yv = BT709_YR * rr[x] + BT709_YG * gg[x] + BT709_YB * bb[x] + 16.0f;
+            int iv = (int)(yv + 0.5f);
+            yrow[x] = (uint8_t)(iv < 0 ? 0 : (iv > 255 ? 255 : iv));
+        }
+#endif
+
+        if ((y & 1) && y >= a->y_start + 1) {
+            uint8_t *urow = a->out_U + (y >> 1) * a->out_us;
+            uint8_t *vrow = a->out_V + (y >> 1) * a->out_vs;
+            const int prev_y = y - 1;
+            for (int cx = 0; cx < W / 2; cx++) {
+                float ru = 0.0f, gu = 0.0f, bu = 0.0f;
+                for (int dy = 0; dy < 2; dy++) {
+                    for (int dx = 0; dx < 2; dx++) {
+                        float r, g, b;
+                        pme_rgb_at(a, cx * 2 + dx, prev_y + dy, &r, &g, &b);
+                        ru += r; gu += g; bu += b;
+                    }
+                }
+                ru *= 255.0f / 4.0f;
+                gu *= 255.0f / 4.0f;
+                bu *= 255.0f / 4.0f;
+                int iu = (int)(-0.101f * ru - 0.339f * gu + 0.439f * bu + 128.0f + 0.5f);
+                int iv = (int)( 0.439f * ru - 0.399f * gu - 0.040f * bu + 128.0f + 0.5f);
+                urow[cx] = (uint8_t)(iu < 0 ? 0 : iu > 255 ? 255 : iu);
+                vrow[cx] = (uint8_t)(iv < 0 ? 0 : iv > 255 ? 255 : iv);
+            }
+        }
+        if (W > 1920) { free(rr); free(gg); free(bb); }
+    }
+    return NULL;
+}
+
+// ====================================================================
+// Section 7: PME runtime loader (stable C ABI)
+// ====================================================================
+
+struct pme_api {
+#ifdef _WIN32
+    HMODULE library;
+#else
+    void *library;
+#endif
+    int (*open_from_manifest)(const pme_runtime_config *, const char *, pme_runtime_session **, char *, size_t);
+    int (*get_info)(const pme_runtime_session *, pme_runtime_info *);
+    int (*run)(pme_runtime_session *, const float *, uint64_t, float *, uint64_t, uint64_t *, char *, size_t);
+    void (*close)(pme_runtime_session *);
+};
+
+struct pme_state {
+    struct pme_api api;
+    pme_runtime_session *session;
+    pme_runtime_info info;
+    char provider_name[64];
+    char provider_vendor[64];
+    pme_device_kind device_kind;
+    float *input_buf;
+    float *output_buf;
+    uint64_t in_elems, out_elems;
+    int ready;
+};
+
+static void *pme_resolve_symbol(struct pme_api *api, const char *name)
+{
+#ifdef _WIN32
+    return (void *)GetProcAddress(api->library, name);
+#else
+    return dlsym(api->library, name);
+#endif
+}
+
+#ifdef _WIN32
+static wchar_t *pme_utf8_to_wide(const char *value)
+{
+    if (!value || !value[0]) return NULL;
+    int length = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, value, -1, NULL, 0);
+    if (length <= 0) return NULL;
+    wchar_t *wide = calloc((size_t)length, sizeof(*wide));
+    if (!wide || MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, value, -1, wide, length) <= 0) {
+        free(wide);
+        return NULL;
+    }
+    return wide;
+}
+#endif
+
+static int pme_load_api(struct pme_api *api, const char *library_path, struct mp_filter *f)
+{
+#ifdef _WIN32
+    wchar_t *wide_path = pme_utf8_to_wide(library_path);
+    if (library_path && library_path[0] && !wide_path) {
+        MP_WARN(f, "PME: runtime library path is not valid UTF-8\n");
+        return -1;
+    }
+    api->library = LoadLibraryW(wide_path ? wide_path : L"plezy_motion_engine.dll");
+    free(wide_path);
+#else
+    api->library = dlopen(library_path && library_path[0]
+                              ? library_path : "libplezy_motion_engine.so",
+                          RTLD_NOW | RTLD_GLOBAL);
+#endif
+    if (!api->library) {
+        MP_WARN(f, "PME: could not load the motion runtime library\n");
+        return -1;
+    }
+
+    api->open_from_manifest = (void *)pme_resolve_symbol(api, "pme_runtime_open_from_manifest");
+    api->get_info = (void *)pme_resolve_symbol(api, "pme_runtime_get_info");
+    api->run = (void *)pme_resolve_symbol(api, "pme_runtime_run");
+    api->close = (void *)pme_resolve_symbol(api, "pme_runtime_close");
+    if (!api->open_from_manifest || !api->get_info || !api->run || !api->close) {
+        MP_WARN(f, "PME: motion runtime library is missing a required C ABI function\n");
+#ifdef _WIN32
+        FreeLibrary(api->library);
+#else
+        dlclose(api->library);
+#endif
+        api->library = NULL;
+        return -1;
+    }
+    return 0;
+}
+
+static const char *htp_mode_for_preset(const char *preset)
+{
+    if (preset && strcmp(preset, "performance") == 0)
+        return "burst";
+    if (preset && strcmp(preset, "quality") == 0)
+        return "sustained_high_performance";
+    return "balanced";
+}
+
+static int pme_cancelled(void *context);
+
+static int pme_init(struct pme_state *pme, struct mp_filter *f, int w, int h,
+                    const char *model_path, const char *pme_library_path,
+                    const char *ort_library_path, const char *provider_manifest,
+                    const char *preset, bool allow_cpu)
+{
+    memset(pme, 0, sizeof(*pme));
+    if (!model_path || !model_path[0] || !provider_manifest || !provider_manifest[0]) {
+        MP_WARN(f, "PME: model path or provider manifest is missing\n");
+        return -1;
+    }
+    if (pme_load_api(&pme->api, pme_library_path, f) < 0)
+        return -1;
+
+    pme_runtime_config config = {0};
+    config.struct_size = sizeof(config);
+    config.abi_version = PME_RUNTIME_ABI_VERSION;
+    config.runtime_library_path = ort_library_path;
+    config.model_path = model_path;
+    config.intra_op_threads = 0;
+    config.allow_cpu_provider = allow_cpu ? 1 : 0;
+    config.htp_performance_mode = htp_mode_for_preset(preset);
+    config.is_cancelled = pme_cancelled;
+    config.cancel_context = f->priv;
+
+    char error[512] = {0};
+    if (pme->api.open_from_manifest(&config, provider_manifest, &pme->session,
+                                    error, sizeof(error)) != 0) {
+        MP_WARN(f, "PME: provider session could not open: %s\n", error);
+        return -1;
+    }
+
+    pme->info.struct_size = sizeof(pme->info);
+    if (pme->api.get_info(pme->session, &pme->info) != 0 ||
+        pme->info.abi_version != PME_RUNTIME_ABI_VERSION ||
+        pme->info.input.rank != 4 || pme->info.output.rank != 4 ||
+        pme->info.input.dimensions[0] != 1 || pme->info.output.dimensions[0] != 1 ||
+        pme->info.input.dimensions[1] != 6 || pme->info.output.dimensions[1] != 3 ||
+        pme->info.input.dimensions[2] != h || pme->info.output.dimensions[2] != h ||
+        pme->info.input.dimensions[3] != w || pme->info.output.dimensions[3] != w ||
+        pme->info.input.element_count != (uint64_t)w * h * 6 ||
+        pme->info.output.element_count != (uint64_t)w * h * 3) {
+        MP_WARN(f, "PME: model tensor schema must be NCHW [1,6,%d,%d] -> [1,3,%d,%d]\n", h, w, h, w);
+        return -1;
+    }
+
+    pme->in_elems = pme->info.input.element_count;
+    pme->out_elems = pme->info.output.element_count;
+    pme->input_buf = calloc((size_t)pme->in_elems, sizeof(float));
+    pme->output_buf = calloc((size_t)pme->out_elems, sizeof(float));
+    if (!pme->input_buf || !pme->output_buf) {
+        MP_WARN(f, "PME: could not allocate model input/output buffers\n");
+        return -1;
+    }
+    pme->device_kind = pme->info.device_kind;
+    snprintf(pme->provider_name, sizeof(pme->provider_name), "%s", pme->info.provider_name);
+    snprintf(pme->provider_vendor, sizeof(pme->provider_vendor), "%s", pme->info.provider_vendor);
+    pme->ready = 1;
+    MP_INFO(f, "PME: %s on %s ready (%dx%d)\n",
+            pme->provider_name, pme->provider_vendor[0] ? pme->provider_vendor : "accelerator", w, h);
+    return 0;
+}
+
+static int pme_execute(struct pme_state *pme)
+{
+    if (!pme || !pme->ready || !pme->session)
+        return -1;
+    char error[256] = {0};
+    uint64_t output_count = 0;
+    if (pme->api.run(pme->session, pme->input_buf, pme->in_elems,
+                     pme->output_buf, pme->out_elems, &output_count,
+                     error, sizeof(error)) != 0 || output_count != pme->out_elems)
+        return -1;
+    return 0;
+}
+
+static void pme_cleanup(struct pme_state *pme)
+{
+    if (!pme) return;
+    if (pme->session && pme->api.close)
+        pme->api.close(pme->session);
+    free(pme->input_buf);
+    free(pme->output_buf);
+#ifdef _WIN32
+    if (pme->api.library) FreeLibrary(pme->api.library);
+#else
+    if (pme->api.library) dlclose(pme->api.library);
+#endif
+    memset(pme, 0, sizeof(*pme));
+}
+
+// ====================================================================
+// Section 8: Filter state and workspace
+// ====================================================================
+
+enum pme_state_machine {
+    STATE_NEED_INPUT,
+    STATE_HAVE_INTERP,
+    STATE_HAVE_CURR,
+};
+
+struct pme_opts {
+    char *model;
+    char *runtime;
+    char *provider_manifest;
+    char *pme_library;
+    char *preset;
+    bool allow_cpu;
+    bool require_neural;
+};
+
+#define OPT_BASE_STRUCT struct pme_opts
+static const struct m_option vf_opts_fields[] = {
+    {"model", OPT_STRING(model)},
+    {"runtime", OPT_STRING(runtime)},
+    {"providers", OPT_STRING(provider_manifest)},
+    {"pme-library", OPT_STRING(pme_library)},
+    {"preset", OPT_STRING(preset)},
+    {"allow-cpu", OPT_BOOL(allow_cpu)},
+    {"require-neural", OPT_BOOL(require_neural)},
+    {0}
+};
+
+static const struct pme_opts vf_opts_defaults = {
+    .preset = "balanced",
+    .require_neural = true,
+};
+
+struct pme_stats_snapshot {
+    bool last_pme_success;
+    bool last_frame_generated;
+    double last_inference_ms;
+    double inference_p95_ms;
+    unsigned long long generated_frames;
+    unsigned long long scene_cut_bypasses;
+    unsigned long long deadline_misses;
+    unsigned long long neural_backoffs;
+    unsigned long long deadline_bypass_frames;
+    double neural_bypass_until_ms;
+    bool neural_probe_pending;
+};
+
+enum pme_worker_result_state {
+    PME_WORKER_RESULT_NONE,
+    PME_WORKER_RESULT_PENDING,
+    PME_WORKER_RESULT_READY,
+    PME_WORKER_RESULT_DISCARDED,
+};
+
+struct priv {
+    struct pme_opts *opts;
+    struct mp_filter *filter;
+    bool last_pme_success;
+    bool last_frame_generated;
+    double last_inference_ms;
+    unsigned long long generated_frames;
+    unsigned long long scene_cut_bypasses;
+    double inference_samples[PME_INFERENCE_WINDOW];
+    unsigned int inference_sample_count;
+    unsigned int inference_sample_next;
+    unsigned long long deadline_misses;
+    double recent_deadline_misses[3];
+    unsigned int recent_deadline_miss_count;
+    unsigned int recent_deadline_miss_next;
+    double neural_bypass_until_ms;
+    bool neural_probe_pending;
+    unsigned long long neural_backoffs;
+    unsigned long long deadline_bypass_frames;
+    enum pme_state_machine state;
+    int frame_count;
+
+    // Previous frame for interpolation
+    struct mp_image *prev;
+
+    // Stored interpolated frame (output in HAVE_INTERP state)
+    struct mp_image *interp;
+
+    // Stored original curr frame (output in HAVE_CURR state)
+    struct mp_frame stored_curr;
+
+    // Prealign workspace (CPU fallback path)
+    int alloc_w, alloc_h;
+    float *flow_x, *flow_y;
+    float *sm_a, *sm_b, *sm_tmp;
+    int sH, sW;
+
+    // Float RGB blend workspace (3 planes, for Phase 2 -> Phase 4)
+    // When Vulkan active, Phase 4 reads from vk.blend_*_ptr instead
+    float *blend_rgb[3];   // R, G, B blend = (warp0 + warp1) / 2
+
+    // Vulkan compute state (GPU P1b + P2)
+    struct vk_compute vk;
+    // Cached NHWC buffer for uncached SSBO -> cached copy
+    float *nhwc_cached;
+    size_t nhwc_cached_size;
+
+    // Neural runtime state
+    struct pme_state pme;
+    int pme_checked;
+    int pme_init_started;
+    int pme_init_thread_created;
+    int pme_init_sync_initialized;
+    int pme_init_width, pme_init_height;
+    pthread_t pme_init_thread;
+    pthread_mutex_t pme_init_mutex;
+    int pme_cancel_requested; // guarded by pme_init_mutex
+
+    // The provider inference and image reconstruction run off mpv's filter
+    // callback. Only one pair is submitted at a time; reset marks its result
+    // stale and lets source frames pass through until the worker drains.
+    pthread_t pme_worker_thread;
+    pthread_mutex_t pme_worker_mutex;
+    pthread_cond_t pme_worker_start_cond;
+    int pme_worker_sync_initialized;
+    int pme_worker_thread_created;
+    int pme_worker_shutdown;
+    int pme_worker_pending;
+    int pme_worker_active;
+    int pme_worker_done;
+    int pme_worker_discard;
+    int pme_async_pair;
+    struct mp_image *pme_worker_prev;
+    struct mp_image *pme_worker_curr;
+    const AVMotionVector *pme_worker_mvs;
+    int pme_worker_n_mvs;
+    struct pme_stats_snapshot published_stats;
+
+
+};
+
+static void record_inference_sample(struct priv *p, double duration_ms)
+{
+    if (!isfinite(duration_ms) || duration_ms < 0.0)
+        return;
+    p->inference_samples[p->inference_sample_next] = duration_ms;
+    p->inference_sample_next = (p->inference_sample_next + 1) % PME_INFERENCE_WINDOW;
+    if (p->inference_sample_count < PME_INFERENCE_WINDOW)
+        p->inference_sample_count++;
+}
+
+static double inference_p95_ms(const struct priv *p)
+{
+    if (p->inference_sample_count == 0)
+        return 0.0;
+
+    double sorted[PME_INFERENCE_WINDOW];
+    memcpy(sorted, p->inference_samples,
+           p->inference_sample_count * sizeof(sorted[0]));
+    for (unsigned int i = 1; i < p->inference_sample_count; i++) {
+        double value = sorted[i];
+        unsigned int j = i;
+        while (j > 0 && sorted[j - 1] > value) {
+            sorted[j] = sorted[j - 1];
+            j--;
+        }
+        sorted[j] = value;
+    }
+
+    unsigned int index = (p->inference_sample_count * 95 + 99) / 100 - 1;
+    if (index >= p->inference_sample_count)
+        index = p->inference_sample_count - 1;
+    return sorted[index];
+}
+
+static double get_time_ms(void);
+
+static void start_neural_bypass(struct priv *p, struct mp_filter *f,
+                                double now_ms, const char *reason)
+{
+    p->neural_bypass_until_ms = now_ms + 10000.0;
+    p->neural_probe_pending = true;
+    p->neural_backoffs++;
+    p->recent_deadline_miss_count = 0;
+    p->recent_deadline_miss_next = 0;
+    MP_WARN(f, "PME: %s; using MPV smoothing for 10 seconds before a Neural recovery probe\n",
+            reason);
+}
+
+static bool record_deadline_miss(struct priv *p, struct mp_filter *f,
+                                 double started_ms, double previous_pts,
+                                 double current_pts)
+{
+    if (!isfinite(previous_pts) || !isfinite(current_pts) ||
+        previous_pts == MP_NOPTS_VALUE || current_pts == MP_NOPTS_VALUE ||
+        current_pts <= previous_pts)
+        return false;
+    double budget_ms = (current_pts - previous_pts) * 1000.0 - 2.0;
+    const double now_ms = get_time_ms();
+    if (budget_ms <= 0.0 || now_ms - started_ms <= budget_ms)
+        return false;
+
+    p->deadline_misses++;
+    p->recent_deadline_misses[p->recent_deadline_miss_next] = now_ms;
+    p->recent_deadline_miss_next = (p->recent_deadline_miss_next + 1) % 3;
+    if (p->recent_deadline_miss_count < 3)
+        p->recent_deadline_miss_count++;
+
+    const bool miss_storm = p->recent_deadline_miss_count == 3 &&
+        now_ms - p->recent_deadline_misses[p->recent_deadline_miss_next] <= 2000.0;
+    if (p->neural_probe_pending || miss_storm)
+        start_neural_bypass(p, f, now_ms,
+                            p->neural_probe_pending ? "Neural recovery probe missed its deadline" :
+                                                      "three Neural deadlines were missed within two seconds");
+    return true;
+}
+
+// Context creation may include model loading and graph finalization. Run it
+// off the filter thread: source frames pass through until the context is
+// ready, then interpolation starts from the latest decoded frame pair.
+static int pme_cancelled(void *context)
+{
+    struct priv *p = context;
+    if (!p || !p->pme_init_sync_initialized)
+        return 0;
+    pthread_mutex_lock(&p->pme_init_mutex);
+    const int cancelled = p->pme_cancel_requested;
+    pthread_mutex_unlock(&p->pme_init_mutex);
+    return cancelled;
+}
+
+static void *pme_init_thread_fn(void *arg)
+{
+    struct priv *p = arg;
+    pme_init(&p->pme, p->filter, p->pme_init_width, p->pme_init_height,
+             p->opts->model, p->opts->pme_library, p->opts->runtime,
+             p->opts->provider_manifest, p->opts->preset, p->opts->allow_cpu);
+    // Vulkan initialization is also asynchronous: creating the instance,
+    // buffers, and shader pipelines must not delay the first decoded frame.
+    if (p->pme.ready && !pme_cancelled(p))
+        vk_init(&p->vk, p->filter, p->pme_init_width, p->pme_init_height);
+    pthread_mutex_lock(&p->pme_init_mutex);
+    p->pme_checked = 1;
+    pthread_mutex_unlock(&p->pme_init_mutex);
+    return NULL;
+}
+
+static void start_pme_init(struct priv *p, struct mp_filter *f, int W, int H)
+{
+    if (!p->pme_init_sync_initialized) {
+        MP_WARN(f, "PME: runtime initialization synchronization is unavailable; passing source frames through\n");
+        p->pme_checked = 1;
+        return;
+    }
+
+    pthread_mutex_lock(&p->pme_init_mutex);
+    if (p->pme_init_started) {
+        pthread_mutex_unlock(&p->pme_init_mutex);
+        return;
+    }
+    p->pme_init_started = 1;
+    p->pme_init_width = W;
+    p->pme_init_height = H;
+    p->filter = f;
+    pthread_mutex_unlock(&p->pme_init_mutex);
+
+    if (pthread_create(&p->pme_init_thread, NULL, pme_init_thread_fn, p) == 0) {
+        p->pme_init_thread_created = 1;
+        return;
+    }
+
+    MP_WARN(f, "PME: could not start asynchronous runtime initialization; passing source frames through\n");
+    pthread_mutex_lock(&p->pme_init_mutex);
+    p->pme_checked = 1;
+    pthread_mutex_unlock(&p->pme_init_mutex);
+}
+
+static void pme_init_status(struct priv *p, int *checked, int *ready)
+{
+    *checked = 0;
+    *ready = 0;
+    if (!p->pme_init_sync_initialized) {
+        *checked = p->pme_checked;
+        return;
+    }
+    pthread_mutex_lock(&p->pme_init_mutex);
+    *checked = p->pme_checked;
+    *ready = p->pme.ready;
+    pthread_mutex_unlock(&p->pme_init_mutex);
+}
+
+static void free_workspace(struct priv *p)
+{
+    free(p->flow_x);  free(p->flow_y);
+    free(p->sm_a);    free(p->sm_b);    free(p->sm_tmp);
+    p->flow_x = p->flow_y = p->sm_a = p->sm_b = p->sm_tmp = NULL;
+
+    for (int c = 0; c < 3; c++) {
+        free(p->blend_rgb[c]); p->blend_rgb[c] = NULL;
+    }
+
+    free(p->nhwc_cached); p->nhwc_cached = NULL;
+    p->nhwc_cached_size = 0;
+
+    p->alloc_w = p->alloc_h = 0;
+}
+
+static void alloc_workspace(struct priv *p, int w, int h)
+{
+    if (p->alloc_w == w && p->alloc_h == h) return;
+    free_workspace(p);
+
+    int px = w * h;
+    p->sH = h / PA_DS; p->sW = w / PA_DS;
+    int spx = p->sH * p->sW;
+
+    p->flow_x  = calloc(px, sizeof(float));
+    p->flow_y  = calloc(px, sizeof(float));
+    p->sm_a    = malloc(spx * sizeof(float));
+    p->sm_b    = malloc(spx * sizeof(float));
+    p->sm_tmp  = malloc(spx * sizeof(float));
+
+    for (int c = 0; c < 3; c++)
+        p->blend_rgb[c] = malloc(px * sizeof(float));
+
+    // Cached NHWC buffer for SSBO->cached copy (only used when Vulkan active)
+    p->nhwc_cached_size = (size_t)px * 6 * sizeof(float);
+    p->nhwc_cached = malloc(p->nhwc_cached_size);
+
+    if (!p->flow_x || !p->flow_y || !p->sm_a || !p->sm_b || !p->sm_tmp ||
+        !p->blend_rgb[0] || !p->blend_rgb[1] || !p->blend_rgb[2] ||
+        !p->nhwc_cached) {
+        free_workspace(p);
+        return;
+    }
+    p->alloc_w = w; p->alloc_h = h;
+}
+
+// ====================================================================
+// Section 9: Optimized interpolation pipeline
+// ====================================================================
+
+// Run prealign v2 on the flow field (modifies flow_x/flow_y in place)
+static void run_prealign_v2(struct priv *p, int W, int H)
+{
+    int dH, dW;
+    downsample(p->flow_x, p->sm_a, H, W, PA_DS, &dH, &dW);
+    downsample(p->flow_y, p->sm_b, H, W, PA_DS, &dH, &dW);
+    median_2d(p->sm_a, p->sm_tmp, dH, dW, PA_MED_K);
+    median_2d(p->sm_b, p->sm_a,   dH, dW, PA_MED_K);
+    // sm_tmp = filtered fx at 1/4, sm_a = filtered fy at 1/4
+    gauss_sep(p->sm_tmp, p->sm_b, dH, dW, PA_GAUSS_S);
+    gauss_sep(p->sm_a,   p->sm_b, dH, dW, PA_GAUSS_S);
+    upsample(p->sm_tmp, p->flow_x, dH, dW, H, W);
+    upsample(p->sm_a,   p->flow_y, dH, dW, H, W);
+}
+
+// Get monotonic time in milliseconds
+static double get_time_ms(void)
+{
+    return mp_time_ns() / 1e6;
+}
+
+// ====================================================================
+// Section 9c: Synchronous interpolation pipeline
+// ====================================================================
+
+// Compute prealigned blend + PME neural residual -> full interpolated frame.
+// Returns a new mp_image (YUV420P) with PTS set to midpoint.
+//
+// GPU pipeline (when Vulkan available):
+//   Phase 1a (CPU): ZOH + downsample -> SSBO
+//   Phase 1b (GPU): median5 x2 + gauss_sep x4 on 1/4 res flow
+//   Phase 2  (GPU): warp_pack (upsample + warp YUV + yuv2rgb + blend + NHWC)
+//   Phase 3  (PME): selected ONNX Runtime provider inference
+//   Phase 4  (CPU, 4 threads): residual + clamp + rgb2yuv
+//
+// CPU fallback (when Vulkan unavailable):
+//   Phase 1 (single thread): ZOH + prealign v2
+//   Phase 2 (4 threads): fused warp + YUV->RGB + blend + pack six-channel float input
+//   Phase 3 (PME): selected ONNX Runtime provider inference
+//   Phase 4 (4 threads): residual + clamp + rgb2yuv
+static struct mp_image *compute_interpolated(struct priv *p, struct mp_filter *f,
+                                              struct mp_image *prev,
+                                              struct mp_image *curr,
+                                              const AVMotionVector *mvs, int n_mvs)
+{
+    const int W = curr->w, H = curr->h;
+    const size_t pixels = (size_t)W * H;
+    p->last_pme_success = false;
+    p->last_frame_generated = false;
+    alloc_workspace(p, W, H);
+    if (!p->flow_x || !p->flow_y || !p->sm_a || !p->sm_b || !p->sm_tmp ||
+        !p->blend_rgb[0] || !p->blend_rgb[1] || !p->blend_rgb[2] ||
+        !p->nhwc_cached || !p->pme.input_buf || !p->pme.output_buf)
+        return NULL;
+    const double started = get_time_ms();
+#ifdef PLEZY_HAVE_PME_VULKAN
+    const bool use_vk = p->vk.ready && p->vk.W == W && p->vk.H == H;
+
+    if (use_vk) {
+        zoh_fill(mvs, n_mvs, p->flow_x, p->flow_y, H, W);
+        int dH, dW;
+        downsample(p->flow_x, p->vk.sm_fx_a_ptr, H, W, PA_DS, &dH, &dW);
+        downsample(p->flow_y, p->vk.sm_fy_a_ptr, H, W, PA_DS, &dH, &dW);
+
+        int y_stride, uv_stride, u_off, v_off;
+        vk_pack_yuv(p->vk.prev_yuv_ptr,
+                    prev->planes[0], prev->stride[0], prev->planes[1], prev->stride[1],
+                    prev->planes[2], prev->stride[2], W, H,
+                    &y_stride, &uv_stride, &u_off, &v_off);
+        vk_pack_yuv(p->vk.curr_yuv_ptr,
+                    curr->planes[0], curr->stride[0], curr->planes[1], curr->stride[1],
+                    curr->planes[2], curr->stride[2], W, H,
+                    &y_stride, &uv_stride, &u_off, &v_off);
+        vk_dispatch(&p->vk, y_stride, uv_stride, u_off, v_off, false, 0.0f, 0);
+        memcpy(p->nhwc_cached, p->vk.nhwc_ptr, pixels * 6 * sizeof(float));
+        for (size_t i = 0; i < pixels; i++) {
+            for (int c = 0; c < 6; c++)
+                p->pme.input_buf[(size_t)c * pixels + i] = p->nhwc_cached[i * 6 + c];
+        }
+        memcpy(p->blend_rgb[0], p->vk.blend_r_ptr, pixels * sizeof(float));
+        memcpy(p->blend_rgb[1], p->vk.blend_g_ptr, pixels * sizeof(float));
+        memcpy(p->blend_rgb[2], p->vk.blend_b_ptr, pixels * sizeof(float));
+    } else
+#endif
+    {
+        zoh_fill(mvs, n_mvs, p->flow_x, p->flow_y, H, W);
+        run_prealign_v2(p, W, H);
+        pthread_t threads[N_THREADS - 1];
+        struct phase2_args args[N_THREADS];
+        const int rows_per = H / N_THREADS;
+        for (int t = 0; t < N_THREADS; t++) {
+            args[t].y_start = t * rows_per;
+            args[t].y_end = t == N_THREADS - 1 ? H : (t + 1) * rows_per;
+            args[t].W = W; args[t].H = H;
+            args[t].prev_Y = prev->planes[0]; args[t].prev_ys = prev->stride[0];
+            args[t].prev_U = prev->planes[1]; args[t].prev_us = prev->stride[1];
+            args[t].prev_V = prev->planes[2]; args[t].prev_vs = prev->stride[2];
+            args[t].curr_Y = curr->planes[0]; args[t].curr_ys = curr->stride[0];
+            args[t].curr_U = curr->planes[1]; args[t].curr_us = curr->stride[1];
+            args[t].curr_V = curr->planes[2]; args[t].curr_vs = curr->stride[2];
+            args[t].flow_x = p->flow_x; args[t].flow_y = p->flow_y;
+            args[t].input_buf = p->pme.input_buf;
+            args[t].blend_r = p->blend_rgb[0];
+            args[t].blend_g = p->blend_rgb[1];
+            args[t].blend_b = p->blend_rgb[2];
+        }
+        for (int t = 0; t < N_THREADS - 1; t++)
+            pthread_create(&threads[t], NULL, phase2_thread_fn, &args[t]);
+        phase2_thread_fn(&args[N_THREADS - 1]);
+        for (int t = 0; t < N_THREADS - 1; t++)
+            pthread_join(threads[t], NULL);
+    }
+
+    const double inference_started = get_time_ms();
+    const int pme_ok = pme_execute(&p->pme) == 0;
+    p->last_inference_ms = get_time_ms() - inference_started;
+    record_inference_sample(p, p->last_inference_ms);
+    p->last_pme_success = pme_ok;
+    if (!pme_ok) {
+        if (p->neural_probe_pending)
+            start_neural_bypass(p, f, get_time_ms(), "Neural recovery probe failed");
+        MP_WARN(f, "PME inference failed; source cadence will continue\n");
+        return NULL;
+    }
+
+    struct mp_image *out = mp_image_new_copy(curr);
+    if (!out)
+        return NULL;
+    pthread_t threads[N_THREADS - 1];
+    struct phase4_args args[N_THREADS];
+    const int rows_per = (H / N_THREADS) & ~1;
+    for (int t = 0; t < N_THREADS; t++) {
+        args[t].y_start = t * rows_per;
+        args[t].y_end = t == N_THREADS - 1 ? H : (t + 1) * rows_per;
+        args[t].W = W; args[t].H = H;
+        args[t].blend_r = p->blend_rgb[0];
+        args[t].blend_g = p->blend_rgb[1];
+        args[t].blend_b = p->blend_rgb[2];
+        args[t].output_buf = p->pme.output_buf;
+        args[t].pme_ok = 1;
+        args[t].out_Y = out->planes[0]; args[t].out_ys = out->stride[0];
+        args[t].out_U = out->planes[1]; args[t].out_us = out->stride[1];
+        args[t].out_V = out->planes[2]; args[t].out_vs = out->stride[2];
+    }
+    for (int t = 0; t < N_THREADS - 1; t++)
+        pthread_create(&threads[t], NULL, phase4_thread_fn, &args[t]);
+    phase4_thread_fn(&args[N_THREADS - 1]);
+    for (int t = 0; t < N_THREADS - 1; t++)
+        pthread_join(threads[t], NULL);
+
+    const double source_duration = curr->pts - prev->pts;
+    out->pts = prev->pts + source_duration / 2.0;
+    out->pkt_duration = source_duration / 2.0;
+    out->nominal_fps = 2.0 / source_duration;
+    const bool missed_deadline = record_deadline_miss(p, f, started, prev->pts, curr->pts);
+    if (missed_deadline) {
+        p->last_pme_success = false;
+        mp_image_unrefp(&out);
+        return NULL;
+    }
+    if (p->neural_probe_pending) {
+        p->neural_probe_pending = false;
+        p->neural_bypass_until_ms = 0.0;
+        MP_INFO(f, "PME: Neural recovery probe met its frame deadline; resuming Neural output\n");
+    }
+    return out;
+}
+
+static void publish_pme_stats_locked(struct priv *p)
+{
+    p->published_stats.last_pme_success = p->last_pme_success;
+    p->published_stats.last_frame_generated = p->last_frame_generated;
+    p->published_stats.last_inference_ms = p->last_inference_ms;
+    p->published_stats.inference_p95_ms = inference_p95_ms(p);
+    p->published_stats.generated_frames = p->generated_frames;
+    p->published_stats.scene_cut_bypasses = p->scene_cut_bypasses;
+    p->published_stats.deadline_misses = p->deadline_misses;
+    p->published_stats.neural_backoffs = p->neural_backoffs;
+    p->published_stats.deadline_bypass_frames = p->deadline_bypass_frames;
+    p->published_stats.neural_bypass_until_ms = p->neural_bypass_until_ms;
+    p->published_stats.neural_probe_pending = p->neural_probe_pending;
+}
+
+static void *pme_worker_thread_fn(void *arg)
+{
+    struct priv *p = arg;
+    pthread_mutex_lock(&p->pme_worker_mutex);
+    while (!p->pme_worker_shutdown) {
+        while (!p->pme_worker_pending && !p->pme_worker_shutdown)
+            pthread_cond_wait(&p->pme_worker_start_cond, &p->pme_worker_mutex);
+        if (p->pme_worker_shutdown)
+            break;
+
+        p->pme_worker_pending = 0;
+        struct mp_image *prev = p->pme_worker_prev;
+        struct mp_image *curr = p->pme_worker_curr;
+        const AVMotionVector *mvs = p->pme_worker_mvs;
+        const int n_mvs = p->pme_worker_n_mvs;
+        pthread_mutex_unlock(&p->pme_worker_mutex);
+
+        p->interp = compute_interpolated(p, p->filter, prev, curr, mvs, n_mvs);
+        mp_image_unrefp(&prev);
+        mp_image_unrefp(&curr);
+
+        pthread_mutex_lock(&p->pme_worker_mutex);
+        p->pme_worker_prev = NULL;
+        p->pme_worker_curr = NULL;
+        p->pme_worker_mvs = NULL;
+        p->pme_worker_n_mvs = 0;
+        if (p->pme_worker_discard || p->pme_worker_shutdown) {
+            mp_image_unrefp(&p->interp);
+            p->last_pme_success = false;
+            p->last_frame_generated = false;
+            p->neural_bypass_until_ms = 0.0;
+            p->neural_probe_pending = false;
+            p->recent_deadline_miss_count = 0;
+            p->recent_deadline_miss_next = 0;
+            p->pme_worker_discard = 0;
+            p->pme_worker_done = 0;
+            p->pme_async_pair = 0;
+        } else {
+            p->pme_worker_done = 1;
+        }
+        p->pme_worker_active = 0;
+        publish_pme_stats_locked(p);
+        pthread_mutex_unlock(&p->pme_worker_mutex);
+
+        mp_filter_wakeup(p->filter);
+        pthread_mutex_lock(&p->pme_worker_mutex);
+    }
+    pthread_mutex_unlock(&p->pme_worker_mutex);
+    return NULL;
+}
+
+static bool ensure_pme_worker(struct priv *p, struct mp_filter *f)
+{
+    if (!p->pme_worker_sync_initialized) {
+        if (pthread_mutex_init(&p->pme_worker_mutex, NULL) != 0) {
+            MP_WARN(f, "PME: worker synchronization is unavailable; bypassing Neural for this pair\n");
+            return false;
+        }
+        if (pthread_cond_init(&p->pme_worker_start_cond, NULL) != 0) {
+            pthread_mutex_destroy(&p->pme_worker_mutex);
+            MP_WARN(f, "PME: worker start condition is unavailable; bypassing Neural for this pair\n");
+            return false;
+        }
+        p->pme_worker_sync_initialized = 1;
+    }
+
+    if (!p->pme_worker_thread_created) {
+        if (pthread_create(&p->pme_worker_thread, NULL, pme_worker_thread_fn, p) != 0) {
+            MP_WARN(f, "PME: worker thread could not start; bypassing Neural for this pair\n");
+            return false;
+        }
+        p->pme_worker_thread_created = 1;
+    }
+    return true;
+}
+
+static bool pme_submit_pair(struct priv *p, struct mp_filter *f,
+                            struct mp_image *prev, struct mp_image *curr,
+                            const AVMotionVector *mvs, int n_mvs)
+{
+    if (!ensure_pme_worker(p, f))
+        return false;
+
+    struct mp_image *prev_ref = mp_image_new_ref(prev);
+    struct mp_image *curr_ref = mp_image_new_ref(curr);
+    if (!prev_ref || !curr_ref) {
+        mp_image_unrefp(&prev_ref);
+        mp_image_unrefp(&curr_ref);
+        return false;
+    }
+
+    pthread_mutex_lock(&p->pme_worker_mutex);
+    if (p->pme_worker_active || p->pme_worker_pending || p->pme_worker_shutdown) {
+        pthread_mutex_unlock(&p->pme_worker_mutex);
+        mp_image_unrefp(&prev_ref);
+        mp_image_unrefp(&curr_ref);
+        return false;
+    }
+    publish_pme_stats_locked(p);
+    p->pme_worker_prev = prev_ref;
+    p->pme_worker_curr = curr_ref;
+    p->pme_worker_mvs = mvs;
+    p->pme_worker_n_mvs = n_mvs;
+    p->pme_worker_discard = 0;
+    p->pme_worker_done = 0;
+    p->pme_async_pair = 1;
+    p->pme_worker_active = 1;
+    p->pme_worker_pending = 1;
+    pthread_cond_signal(&p->pme_worker_start_cond);
+    pthread_mutex_unlock(&p->pme_worker_mutex);
+    return true;
+}
+
+static enum pme_worker_result_state pme_worker_take_result(struct priv *p)
+{
+    if (!p->pme_worker_sync_initialized)
+        return PME_WORKER_RESULT_NONE;
+    pthread_mutex_lock(&p->pme_worker_mutex);
+    if (!p->pme_async_pair) {
+        pthread_mutex_unlock(&p->pme_worker_mutex);
+        return PME_WORKER_RESULT_NONE;
+    }
+    if (!p->pme_worker_done) {
+        pthread_mutex_unlock(&p->pme_worker_mutex);
+        return PME_WORKER_RESULT_PENDING;
+    }
+    const bool ready = !p->pme_worker_discard;
+    p->pme_worker_done = 0;
+    p->pme_async_pair = 0;
+    pthread_mutex_unlock(&p->pme_worker_mutex);
+    return ready ? PME_WORKER_RESULT_READY : PME_WORKER_RESULT_DISCARDED;
+}
+
+static bool pme_worker_busy(struct priv *p)
+{
+    if (!p->pme_worker_sync_initialized)
+        return false;
+    pthread_mutex_lock(&p->pme_worker_mutex);
+    const bool busy = p->pme_worker_active || p->pme_worker_pending;
+    pthread_mutex_unlock(&p->pme_worker_mutex);
+    return busy;
+}
+
+static bool pme_worker_cancel_for_reset(struct priv *p)
+{
+    if (!p->pme_worker_sync_initialized)
+        return false;
+    pthread_mutex_lock(&p->pme_worker_mutex);
+    const bool busy = p->pme_worker_active || p->pme_worker_pending;
+    if (busy) {
+        p->pme_worker_discard = 1;
+        p->pme_async_pair = 0;
+    } else {
+        p->pme_worker_pending = 0;
+        p->pme_worker_done = 0;
+        p->pme_worker_discard = 0;
+        p->pme_async_pair = 0;
+        mp_image_unrefp(&p->interp);
+        p->last_pme_success = false;
+        p->last_frame_generated = false;
+        p->neural_bypass_until_ms = 0.0;
+        p->neural_probe_pending = false;
+        p->recent_deadline_miss_count = 0;
+        p->recent_deadline_miss_next = 0;
+        publish_pme_stats_locked(p);
+    }
+    pthread_mutex_unlock(&p->pme_worker_mutex);
+    return busy;
+}
+
+// ====================================================================
+// Section 10: Frame doubling state machine
+// ====================================================================
+
+// Sample the YUV420 frame pair on a coarse grid. A cut-like, nearly global
+// change bypasses the model and drains any pending result, so a high-energy
+// transition is never warped into the following scene. This deliberately
+// favors a missed interpolation over a visible cross-scene morph.
+static bool frame_pair_looks_like_scene_cut(const struct mp_image *previous,
+                                             const struct mp_image *current)
+{
+    if (!previous || !current || previous->w != current->w ||
+        previous->h != current->h || previous->imgfmt != IMGFMT_420P ||
+        current->imgfmt != IMGFMT_420P || !previous->planes[0] ||
+        !previous->planes[1] || !previous->planes[2] ||
+        !current->planes[0] || !current->planes[1] || !current->planes[2])
+        return false;
+
+    const int grid_w = 32;
+    const int grid_h = 18;
+    int changed_samples = 0;
+    int64_t difference_sum = 0;
+
+    for (int gy = 0; gy < grid_h; gy++) {
+        int y = ((2 * gy + 1) * current->h) / (2 * grid_h);
+        int cy = y / 2;
+        const uint8_t *prev_y = previous->planes[0] + y * previous->stride[0];
+        const uint8_t *curr_y = current->planes[0] + y * current->stride[0];
+        const uint8_t *prev_u = previous->planes[1] + cy * previous->stride[1];
+        const uint8_t *curr_u = current->planes[1] + cy * current->stride[1];
+        const uint8_t *prev_v = previous->planes[2] + cy * previous->stride[2];
+        const uint8_t *curr_v = current->planes[2] + cy * current->stride[2];
+
+        for (int gx = 0; gx < grid_w; gx++) {
+            int x = ((2 * gx + 1) * current->w) / (2 * grid_w);
+            int cx = x / 2;
+            int y_diff = abs((int)prev_y[x] - (int)curr_y[x]);
+            int u_diff = abs((int)prev_u[cx] - (int)curr_u[cx]);
+            int v_diff = abs((int)prev_v[cx] - (int)curr_v[cx]);
+            int diff = (2 * y_diff + u_diff + v_diff) / 4;
+            difference_sum += diff;
+            if (diff >= 64)
+                changed_samples++;
+        }
+    }
+
+    const int total_samples = grid_w * grid_h;
+    int mean_difference = (int)(difference_sum / total_samples);
+    return mean_difference >= 44 && changed_samples * 100 >= total_samples * 68;
+}
+
+static bool frame_pair_matches_supported_cadence(const struct mp_image *previous,
+                                                  const struct mp_image *current)
+{
+    if (!previous || !current || !isfinite(previous->pts) || !isfinite(current->pts) ||
+        previous->pts == MP_NOPTS_VALUE || current->pts == MP_NOPTS_VALUE ||
+        current->pts <= previous->pts)
+        return false;
+
+    const double duration = current->pts - previous->pts;
+    const double tolerance = 0.002; // 2 ms; rejects VFR and discontinuous pairs.
+    return fabs(duration - 1.0 / 24.0) <= tolerance ||
+           fabs(duration - 1.0 / 30.0) <= tolerance;
+}
+
+static void f_process(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+
+    if (!mp_pin_in_needs_data(f->ppins[1]))
+        return;
+
+    if (p->state == STATE_HAVE_INTERP) {
+        const enum pme_worker_result_state worker_result = pme_worker_take_result(p);
+        if (worker_result == PME_WORKER_RESULT_PENDING)
+            return;
+        if (worker_result == PME_WORKER_RESULT_DISCARDED) {
+            mp_image_unrefp(&p->interp);
+            mp_pin_in_write(f->ppins[1], p->stored_curr);
+            p->stored_curr = (struct mp_frame){0};
+            p->state = STATE_NEED_INPUT;
+            mp_filter_internal_mark_progress(f);
+            return;
+        }
+        struct mp_image *out = p->interp;
+        p->interp = NULL;
+        if (!out || (p->opts->require_neural && !p->last_pme_success)) {
+            mp_image_unrefp(&out);
+            p->last_frame_generated = false;
+            mp_pin_in_write(f->ppins[1], p->stored_curr);
+            p->stored_curr = (struct mp_frame){0};
+            p->state = STATE_NEED_INPUT;
+            mp_filter_internal_mark_progress(f);
+            return;
+        }
+        p->last_frame_generated = p->last_pme_success;
+        if (p->last_frame_generated)
+            p->generated_frames++;
+        mp_pin_in_write(f->ppins[1], MAKE_FRAME(MP_FRAME_VIDEO, out));
+        p->state = STATE_HAVE_CURR;
+        mp_filter_internal_mark_progress(f);
+        return;
+    }
+
+    if (p->state == STATE_HAVE_CURR) {
+        mp_pin_in_write(f->ppins[1], p->stored_curr);
+        p->stored_curr = (struct mp_frame){0};
+        p->state = STATE_NEED_INPUT;
+        return;
+    }
+
+    if (!mp_pin_can_transfer_data(f->ppins[1], f->ppins[0]))
+        return;
+
+    struct mp_frame frame = mp_pin_out_read(f->ppins[0]);
+    if (mp_frame_is_signaling(frame)) {
+        mp_image_unrefp(&p->prev);
+        p->state = STATE_NEED_INPUT;
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    if (frame.type != MP_FRAME_VIDEO) {
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    struct mp_image *mpi = frame.data;
+    p->frame_count++;
+    // A reset can arrive while the inference worker is draining an old pair.
+    // Keep the new stream on its source cadence until that worker releases the
+    // shared model/workspace, then resume from the newest decoded frame.
+    if (pme_worker_busy(p)) {
+        mp_image_unrefp(&p->prev);
+        p->prev = mp_image_new_ref(mpi);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    const int w = mpi->w, h = mpi->h;
+    const bool supported = w == 1920 && h == 1080 && mpi->imgfmt == IMGFMT_420P &&
+                           !(mpi->fields & MP_IMGFIELD_INTERLACED);
+    if (!supported) {
+        p->last_pme_success = false;
+        p->last_frame_generated = false;
+        mp_image_unrefp(&p->prev);
+        p->prev = mp_image_new_ref(mpi);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    start_pme_init(p, f, w, h);
+    int pme_checked, pme_ready;
+    pme_init_status(p, &pme_checked, &pme_ready);
+    if (!pme_checked || !pme_ready || !p->prev || p->prev->w != w || p->prev->h != h ||
+        p->prev->imgfmt != mpi->imgfmt || (p->prev->fields & MP_IMGFIELD_INTERLACED)) {
+        p->last_pme_success = false;
+        p->last_frame_generated = false;
+        mp_image_unrefp(&p->prev);
+        p->prev = mp_image_new_ref(mpi);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    if (frame_pair_looks_like_scene_cut(p->prev, mpi)) {
+        p->scene_cut_bypasses++;
+        p->last_pme_success = false;
+        mp_image_unrefp(&p->prev);
+        p->prev = mp_image_new_ref(mpi);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    // Stream metadata can claim 24/30 fps while individual timestamps are
+    // variable. Only synthesize on pairs that satisfy the actual supported
+    // cadence; otherwise preserve the decoded source frame unchanged.
+    if (!frame_pair_matches_supported_cadence(p->prev, mpi)) {
+        p->last_pme_success = false;
+        p->last_frame_generated = false;
+        mp_image_unrefp(&p->prev);
+        p->prev = mp_image_new_ref(mpi);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    const AVMotionVector *mvs = NULL;
+    int n_mvs = 0;
+    for (int n = 0; n < mpi->num_ff_side_data; n++) {
+        if (mpi->ff_side_data[n].type == AV_FRAME_DATA_MOTION_VECTORS) {
+            AVBufferRef *buf = mpi->ff_side_data[n].buf;
+            if (buf && buf->data) {
+                mvs = (const AVMotionVector *)buf->data;
+                n_mvs = buf->size / sizeof(AVMotionVector);
+            }
+            break;
+        }
+    }
+    if (n_mvs <= 0) {
+        p->last_pme_success = false;
+        mp_image_unrefp(&p->prev);
+        p->prev = mp_image_new_ref(mpi);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    // After three recent deadline misses, leave the expensive model path idle
+    // while MPV's display-resample path continues. Retry one pair after the
+    // cooldown; a successful deadline probe re-enables Neural processing.
+    if (p->neural_bypass_until_ms > get_time_ms()) {
+        p->last_pme_success = false;
+        p->last_frame_generated = false;
+        p->deadline_bypass_frames++;
+        mp_image_unrefp(&p->prev);
+        p->prev = mp_image_new_ref(mpi);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+
+    if (!pme_submit_pair(p, f, p->prev, mpi, mvs, n_mvs)) {
+        p->last_pme_success = false;
+        p->last_frame_generated = false;
+        mp_image_unrefp(&p->prev);
+        p->prev = mp_image_new_ref(mpi);
+        mp_pin_in_write(f->ppins[1], frame);
+        return;
+    }
+    mp_image_unrefp(&p->prev);
+    p->prev = mp_image_new_ref(mpi);
+    p->stored_curr = frame;
+    p->state = STATE_HAVE_INTERP;
+    mp_filter_internal_mark_progress(f);
+}
+
+static void f_reset(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    const bool worker_busy = pme_worker_cancel_for_reset(p);
+    mp_image_unrefp(&p->prev);
+    if (!worker_busy)
+        mp_image_unrefp(&p->interp);
+    mp_frame_unref(&p->stored_curr);
+    p->state = STATE_NEED_INPUT;
+    if (!worker_busy) {
+        p->last_pme_success = false;
+        p->last_frame_generated = false;
+        p->recent_deadline_miss_count = 0;
+        p->recent_deadline_miss_next = 0;
+        p->neural_bypass_until_ms = 0.0;
+        p->neural_probe_pending = false;
+    }
+}
+
+static void f_destroy(struct mp_filter *f)
+{
+    struct priv *p = f->priv;
+    if (p->pme_init_thread_created) {
+        pthread_mutex_lock(&p->pme_init_mutex);
+        p->pme_cancel_requested = 1;
+        pthread_mutex_unlock(&p->pme_init_mutex);
+        pthread_join(p->pme_init_thread, NULL);
+        p->pme_init_thread_created = 0;
+    }
+    if (p->pme_worker_thread_created) {
+        pthread_mutex_lock(&p->pme_worker_mutex);
+        p->pme_worker_shutdown = 1;
+        p->pme_worker_discard = 1;
+        pthread_cond_broadcast(&p->pme_worker_start_cond);
+        pthread_mutex_unlock(&p->pme_worker_mutex);
+        pthread_join(p->pme_worker_thread, NULL);
+        p->pme_worker_thread_created = 0;
+    }
+    mp_image_unrefp(&p->pme_worker_prev);
+    mp_image_unrefp(&p->pme_worker_curr);
+    mp_image_unrefp(&p->prev);
+    mp_image_unrefp(&p->interp);
+    mp_frame_unref(&p->stored_curr);
+    free_workspace(p);
+    vk_cleanup(&p->vk);
+    pme_cleanup(&p->pme);
+    if (p->pme_worker_sync_initialized) {
+        pthread_cond_destroy(&p->pme_worker_start_cond);
+        pthread_mutex_destroy(&p->pme_worker_mutex);
+        p->pme_worker_sync_initialized = 0;
+    }
+    if (p->pme_init_sync_initialized) {
+        pthread_mutex_destroy(&p->pme_init_mutex);
+        p->pme_init_sync_initialized = 0;
+    }
+}
+
+static bool f_command(struct mp_filter *f, struct mp_filter_command *cmd)
+{
+    struct priv *p = f->priv;
+    if (cmd->type != MP_FILTER_COMMAND_GET_META)
+        return false;
+
+    struct mp_tags *tags = talloc_zero(NULL, struct mp_tags);
+    int checked, ready;
+    pme_init_status(p, &checked, &ready);
+    struct pme_stats_snapshot stats;
+    bool worker_busy = false;
+    bool worker_discard = false;
+    if (p->pme_worker_sync_initialized) {
+        pthread_mutex_lock(&p->pme_worker_mutex);
+        worker_busy = p->pme_worker_active || p->pme_worker_pending;
+        worker_discard = p->pme_worker_discard;
+        if (!worker_busy)
+            publish_pme_stats_locked(p);
+        stats = p->published_stats;
+        pthread_mutex_unlock(&p->pme_worker_mutex);
+    } else {
+        publish_pme_stats_locked(p);
+        stats = p->published_stats;
+    }
+    if (worker_busy && worker_discard) {
+        stats.last_pme_success = false;
+        stats.last_frame_generated = false;
+    }
+    const char *provider = stats.last_pme_success ? p->pme.provider_name :
+                           (ready ? mp_tprintf(128, "%s-ready", p->pme.provider_name) :
+                            (checked ? "unavailable" : "initializing"));
+    mp_tags_set_str(tags, "provider", provider);
+    mp_tags_set_str(tags, "provider-vendor", p->pme.provider_vendor);
+    mp_tags_set_str(tags, "power-mode",
+                    strcmp(p->pme.provider_name, "QNNExecutionProvider") == 0
+                        ? htp_mode_for_preset(p->opts->preset)
+                        : "not-applicable");
+    mp_tags_set_str(tags, "device-kind", p->pme.device_kind == PME_DEVICE_NPU ? "npu" :
+                    p->pme.device_kind == PME_DEVICE_GPU ? "gpu" :
+                    p->pme.device_kind == PME_DEVICE_CPU ? "cpu" : "unknown");
+    mp_tags_set_str(tags, "active", stats.last_frame_generated ? "yes" : "no");
+    mp_tags_set_str(tags, "gpu", p->vk.ready ? "vulkan" : "cpu");
+    mp_tags_set_str(tags, "inference-ms", mp_tprintf(32, "%.3f", stats.last_inference_ms));
+    mp_tags_set_str(tags, "inference-p95-ms", mp_tprintf(32, "%.3f", stats.inference_p95_ms));
+    mp_tags_set_str(tags, "generated-frames", mp_tprintf(32, "%llu", stats.generated_frames));
+    mp_tags_set_str(tags, "source-frames", mp_tprintf(32, "%d", p->frame_count));
+    mp_tags_set_str(tags, "scene-cut-bypasses", mp_tprintf(32, "%llu", stats.scene_cut_bypasses));
+    mp_tags_set_str(tags, "deadline-misses", mp_tprintf(32, "%llu", stats.deadline_misses));
+    const double now_ms = get_time_ms();
+    mp_tags_set_str(tags, "deadline-governor",
+                    worker_discard || stats.neural_bypass_until_ms > now_ms ? "mpv-bypass" :
+                    stats.neural_probe_pending ? "recovery-probe" : "neural");
+    mp_tags_set_str(tags, "deadline-backoffs", mp_tprintf(32, "%llu", stats.neural_backoffs));
+    mp_tags_set_str(tags, "deadline-bypass-frames",
+                    mp_tprintf(32, "%llu", stats.deadline_bypass_frames));
+    *(struct mp_tags **)cmd->res = tags;
+    return true;
+}
+
+static const struct mp_filter_info filter = {
+    .name = "plezy-pme",
+    .process = f_process,
+    .command = f_command,
+    .reset = f_reset,
+    .destroy = f_destroy,
+    .priv_size = sizeof(struct priv),
+};
+
+// ====================================================================
+// Section 11: Filter registration
+// ====================================================================
+
+static struct mp_filter *f_create(struct mp_filter *parent, void *options)
+{
+    struct mp_filter *f = mp_filter_create(parent, &filter);
+    if (!f) {
+        talloc_free(options);
+        return NULL;
+    }
+
+    struct priv *p = f->priv;
+    p->opts = talloc_steal(p, options);
+    if (!p->opts) {
+        p->opts = talloc_zero(p, struct pme_opts);
+        p->opts->require_neural = true;
+    }
+    p->filter = f;
+    p->pme_init_sync_initialized = pthread_mutex_init(&p->pme_init_mutex, NULL) == 0;
+    if (!p->pme_init_sync_initialized)
+        MP_WARN(f, "PME: runtime initialization mutex unavailable; neural processing will pass through\n");
+
+    p->state = STATE_NEED_INPUT;
+
+    // Timing log interval: 30 = log every 30th frame (~1/s, normal use)
+    // Change to 1 to log every frame for paper-grade e2e statistics.
+    // Full-frame logging adds ~4°C thermal overhead; see paper Sec. IV-F.
+    mp_filter_add_pin(f, MP_PIN_IN, "in");
+    mp_filter_add_pin(f, MP_PIN_OUT, "out");
+
+    MP_INFO(f, "Plezy Motion Engine neural interpolation filter initialized\n");
+    return f;
+}
+
+const struct mp_user_filter_entry vf_plezy_pme = {
+    .desc = {
+        .description = "Plezy Motion Engine neural frame interpolation",
+        .name = "plezy-pme",
+        .priv_size = sizeof(OPT_BASE_STRUCT),
+        .priv_defaults = &vf_opts_defaults,
+        .options = vf_opts_fields,
+    },
+    .create = f_create,
+};
