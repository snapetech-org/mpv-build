+ * Hybrid CPU/Vulkan preprocessing and ONNX Runtime inference for
+ * 1080p frame interpolation using exported codec motion vectors.
+ * Usage: --vf=plezy-pme
+ */
+
+// ====================================================================
+// Section 1: Includes
+// ====================================================================
+
+#include <math.h>
+#include <string.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <time.h>
+#include <pthread.h>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
