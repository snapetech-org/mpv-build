diff --git a/video/out/avfoundation_motion.m b/video/out/avfoundation_motion.m
new file mode 100644
index 0000000..e67dbcc
--- /dev/null
+++ b/video/out/avfoundation_motion.m
@@ -0,0 +1,554 @@
+/*
+ * This file is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#import <Foundation/Foundation.h>
+#import <TargetConditionals.h>
+#import <VideoToolbox/VTFrameProcessor.h>
+#import <VideoToolbox/VTFrameProcessor_LowLatencyFrameInterpolation.h>
+#if !TARGET_OS_TV && !TARGET_OS_MACCATALYST && !TARGET_OS_VISION && !TARGET_OS_SIMULATOR
+#import <VideoToolbox/VTFrameProcessor_FrameRateConversion.h>
+#endif
+#import <CoreVideo/CoreVideo.h>
+
+#include <stdlib.h>
+#include <time.h>
+
+#include "avfoundation_motion.h"
+
+enum motion_state {
+    MOTION_OFF,
+    MOTION_INITIALIZING,
+    MOTION_READY,
+    MOTION_ACTIVE,
+    MOTION_UNAVAILABLE,
+};
+
+@interface MPVAVFMotionSession : NSObject {
+@public
+    dispatch_queue_t queue;
+    VTFrameProcessor *processor;
+    CVPixelBufferPoolRef output_pool;
+    NSArray *supported_formats;
+    NSUInteger generation;
+    int width;
+    int height;
+    int frame_count;
+    int state;
+    int64_t worst_process_ns;
+    bool requested;
+    bool stream_eligible;
+    bool sequential_submission;
+    bool uses_frame_rate_conversion;
+}
+- (void)configureEnabled:(bool)enabled width:(int)frameWidth
+                  height:(int)frameHeight frameCount:(int)frames;
+- (void)setStreamEligible:(bool)eligible;
+- (const char *)statusName;
+- (int)processPrevious:(CVPixelBufferRef)previous source:(CVPixelBufferRef)source
+        previousTime:(int64_t)previousPTS sourceTime:(int64_t)sourcePTS
+          deadlineNs:(int64_t)deadline displaySlots:(int)displaySlots
+            outputs:(CVPixelBufferRef[7])outputs
+          timestamps:(int64_t[7])timestamps;
+@end
+
+static int64_t monotonic_time_ns(void)
+{
+    struct timespec now = {0};
+    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+        return 0;
+    return (int64_t)now.tv_sec * 1000000000LL + now.tv_nsec;
+}
+
+@implementation MPVAVFMotionSession
+
+- (instancetype)init
+{
+    self = [super init];
+    if (self) {
+        queue = dispatch_queue_create("mpv avfoundation motion", DISPATCH_QUEUE_SERIAL);
+        state = MOTION_OFF;
+        // Do not attempt the first expensive inference with no scheduling
+        // history. This value is deliberately conservative and is raised to
+        // the slowest recent successful call.
+        worst_process_ns = 30000000;
+    }
+    return self;
+}
+
+- (void)dealloc
+{
+    if (processor) {
+        [processor endSession];
+        [processor release];
+    }
+    if (output_pool)
+        CVPixelBufferPoolRelease(output_pool);
+    [supported_formats release];
+    if (queue)
+        dispatch_release(queue);
+    [super dealloc];
+}
+
+- (void)configureEnabled:(bool)enabled width:(int)frameWidth
+                  height:(int)frameHeight frameCount:(int)frames
+{
+    frames = frames == 3 || frames == 7 ? frames : 1;
+    int configurationDepth = frames == 7 ? 3 : frames == 3 ? 2 : 1;
+    NSUInteger requestGeneration;
+
+    @synchronized (self) {
+        if (requested == enabled && (!enabled ||
+            (width == frameWidth && height == frameHeight && frame_count == frames &&
+             (state == MOTION_INITIALIZING || state == MOTION_READY || state == MOTION_ACTIVE))))
+            return;
+
+        generation++;
+        requestGeneration = generation;
+        requested = enabled;
+        width = frameWidth;
+        height = frameHeight;
+        frame_count = frames;
+        stream_eligible = false;
+        sequential_submission = false;
+        uses_frame_rate_conversion = false;
+        state = enabled ? MOTION_INITIALIZING : MOTION_OFF;
+    }
+
+    if (!enabled || frameWidth < 1 || frameHeight < 1) {
+        @synchronized (self) {
+            if (generation == requestGeneration) {
+                requested = false;
+                state = enabled ? MOTION_UNAVAILABLE : MOTION_OFF;
+            }
+        }
+    }
+
+    dispatch_async(queue, ^{
+        @autoreleasepool {
+            if (!enabled || frameWidth < 1 || frameHeight < 1) {
+                VTFrameProcessor *oldProcessor = nil;
+                CVPixelBufferPoolRef oldPool = NULL;
+                NSArray *oldFormats = nil;
+                @synchronized (self) {
+                    if (generation == requestGeneration) {
+                        oldProcessor = processor;
+                        processor = nil;
+                        oldPool = output_pool;
+                        output_pool = NULL;
+                        oldFormats = supported_formats;
+                        supported_formats = nil;
+                    }
+                }
+                if (oldProcessor) {
+                    [oldProcessor endSession];
+                    [oldProcessor release];
+                }
+                if (oldPool)
+                    CVPixelBufferPoolRelease(oldPool);
+                [oldFormats release];
+                return;
+            }
+
+            if (@available(macOS 15.4, iOS 26.0, tvOS 26.0,
+                           macCatalyst 26.0, visionOS 26.0, *)) {
+                id configuration = nil;
+                bool usesFrameRateConversion = false;
+#if !TARGET_OS_TV && !TARGET_OS_MACCATALYST && !TARGET_OS_VISION && !TARGET_OS_SIMULATOR
+                if ([VTFrameRateConversionConfiguration isSupported]) {
+                    VTFrameRateConversionConfigurationQualityPrioritization priority =
+                        frames == 7
+                            ? VTFrameRateConversionConfigurationQualityPrioritizationQuality
+                            : VTFrameRateConversionConfigurationQualityPrioritizationNormal;
+                    VTFrameRateConversionConfiguration *frameRateConfiguration =
+                        [[VTFrameRateConversionConfiguration alloc]
+                            initWithFrameWidth:frameWidth
+                            frameHeight:frameHeight
+                            usePrecomputedFlow:NO
+                            qualityPrioritization:priority
+                            revision:VTFrameRateConversionConfigurationRevision1];
+                    if (frameRateConfiguration) {
+                        configuration = frameRateConfiguration;
+                        usesFrameRateConversion = true;
+                    }
+                }
+#endif
+                if (!configuration &&
+                    [VTLowLatencyFrameInterpolationConfiguration isSupported]) {
+                    VTLowLatencyFrameInterpolationConfiguration *lowLatencyConfiguration =
+                        [[VTLowLatencyFrameInterpolationConfiguration alloc]
+                            initWithFrameWidth:frameWidth
+                            frameHeight:frameHeight
+                            numberOfInterpolatedFrames:configurationDepth];
+                    configuration = lowLatencyConfiguration;
+                }
+
+                VTFrameProcessor *newProcessor = [[VTFrameProcessor alloc] init];
+                CVPixelBufferPoolRef newPool = NULL;
+                NSError *error = nil;
+                bool ok = configuration && newProcessor &&
+                    [newProcessor startSessionWithConfiguration:configuration error:&error];
+#if !TARGET_OS_TV && !TARGET_OS_MACCATALYST && !TARGET_OS_VISION && !TARGET_OS_SIMULATOR
+                if (!ok && usesFrameRateConversion) {
+                    [newProcessor endSession];
+                    [newProcessor release];
+                    newProcessor = [[VTFrameProcessor alloc] init];
+                    [configuration release];
+                    configuration = nil;
+                    usesFrameRateConversion = false;
+                    error = nil;
+                    if ([VTLowLatencyFrameInterpolationConfiguration isSupported]) {
+                        VTLowLatencyFrameInterpolationConfiguration *lowLatencyConfiguration =
+                            [[VTLowLatencyFrameInterpolationConfiguration alloc]
+                                initWithFrameWidth:frameWidth
+                                frameHeight:frameHeight
+                                numberOfInterpolatedFrames:configurationDepth];
+                        configuration = lowLatencyConfiguration;
+                        ok = configuration && newProcessor &&
+                            [newProcessor startSessionWithConfiguration:configuration error:&error];
+                    }
+                }
+#endif
+                NSArray *newFormats = nil;
+#if !TARGET_OS_TV && !TARGET_OS_MACCATALYST && !TARGET_OS_VISION && !TARGET_OS_SIMULATOR
+                if (usesFrameRateConversion) {
+                    newFormats = [((VTFrameRateConversionConfiguration *)configuration).supportedPixelFormats copy];
+                } else
+#endif
+                {
+                    newFormats = [((VTLowLatencyFrameInterpolationConfiguration *)configuration).supportedPixelFormats copy];
+                }
+                ok = ok && newFormats;
+                if (ok) {
+                    NSDictionary *attributes = [configuration destinationPixelBufferAttributes];
+                    ok = attributes && CVPixelBufferPoolCreate(
+                        kCFAllocatorDefault, NULL, (CFDictionaryRef)attributes,
+                        &newPool) == kCVReturnSuccess;
+                }
+
+                if (configuration)
+                    [configuration release];
+
+                VTFrameProcessor *oldProcessor = nil;
+                CVPixelBufferPoolRef oldPool = NULL;
+                NSArray *oldFormats = nil;
+                @synchronized (self) {
+                    if (generation == requestGeneration && requested && ok) {
+                        oldProcessor = processor;
+                        processor = newProcessor;
+                        newProcessor = nil;
+                        oldPool = output_pool;
+                        output_pool = newPool;
+                        newPool = NULL;
+                        oldFormats = supported_formats;
+                        supported_formats = newFormats;
+                        newFormats = nil;
+                        sequential_submission = false;
+                        uses_frame_rate_conversion = usesFrameRateConversion;
+                        state = MOTION_READY;
+                        worst_process_ns = 30000000;
+                    } else if (generation == requestGeneration && requested) {
+                        state = MOTION_UNAVAILABLE;
+                        uses_frame_rate_conversion = false;
+                        oldProcessor = processor;
+                        processor = nil;
+                        oldPool = output_pool;
+                        output_pool = NULL;
+                        oldFormats = supported_formats;
+                        supported_formats = nil;
+                    }
+                }
+
+                if (oldProcessor) {
+                    [oldProcessor endSession];
+                    [oldProcessor release];
+                }
+                if (oldPool)
+                    CVPixelBufferPoolRelease(oldPool);
+                [oldFormats release];
+                if (newProcessor) {
+                    [newProcessor endSession];
+                    [newProcessor release];
+                }
+                if (newPool)
+                    CVPixelBufferPoolRelease(newPool);
+                [newFormats release];
+                if (!ok && error)
+                    NSLog(@"VideoToolbox frame interpolation session failed: %@", error);
+            } else {
+                @synchronized (self) {
+                    if (generation == requestGeneration)
+                        state = MOTION_UNAVAILABLE;
+                }
+            }
+        }
+    });
+}
+
+- (const char *)statusName
+{
+    @synchronized (self) {
+        if ((state == MOTION_READY || state == MOTION_ACTIVE) && !stream_eligible)
+            return "unavailable";
+        switch (state) {
+        case MOTION_INITIALIZING: return "initializing";
+        case MOTION_READY: return "ready";
+        case MOTION_ACTIVE: return "active";
+        case MOTION_UNAVAILABLE: return "unavailable";
+        default: return "off";
+        }
+    }
+}
+
+- (void)setStreamEligible:(bool)eligible
+{
+    @synchronized (self) {
+        if (!eligible && state == MOTION_ACTIVE)
+            state = MOTION_READY;
+        if (!eligible)
+            sequential_submission = false;
+        stream_eligible = eligible;
+    }
+}
+
+- (int)processPrevious:(CVPixelBufferRef)previous source:(CVPixelBufferRef)source
+        previousTime:(int64_t)previousPTS sourceTime:(int64_t)sourcePTS
+          deadlineNs:(int64_t)deadline displaySlots:(int)displaySlots
+            outputs:(CVPixelBufferRef[7])outputs
+          timestamps:(int64_t[7])timestamps
+{
+    for (int i = 0; i < 7; i++) {
+        outputs[i] = NULL;
+        timestamps[i] = 0;
+    }
+    if (!previous || !source || sourcePTS <= previousPTS)
+        return 0;
+
+    @synchronized (self) {
+        if (!requested || (state != MOTION_READY && state != MOTION_ACTIVE) ||
+            !processor || !output_pool)
+            return 0;
+
+        if (deadline <= 0 || deadline < worst_process_ns * 2 + 3000000) {
+            state = MOTION_READY;
+            return 0;
+        }
+
+        OSType previousFormat = CVPixelBufferGetPixelFormatType(previous);
+        OSType sourceFormat = CVPixelBufferGetPixelFormatType(source);
+        if (previousFormat != sourceFormat ||
+            CVPixelBufferGetWidth(previous) != width ||
+            CVPixelBufferGetHeight(previous) != height ||
+            CVPixelBufferGetWidth(source) != width ||
+            CVPixelBufferGetHeight(source) != height) {
+            if (state == MOTION_ACTIVE)
+                state = MOTION_READY;
+            stream_eligible = false;
+            return 0;
+        }
+
+        NSNumber *pixelFormat = [NSNumber numberWithUnsignedInt:sourceFormat];
+        if (!supported_formats || ![supported_formats containsObject:pixelFormat]) {
+            if (state == MOTION_ACTIVE)
+                state = MOTION_READY;
+            stream_eligible = false;
+            return 0;
+        }
+
+        int outputCount = frame_count;
+#if !TARGET_OS_TV && !TARGET_OS_MACCATALYST && !TARGET_OS_VISION && !TARGET_OS_SIMULATOR
+        if (uses_frame_rate_conversion && displaySlots > 0) {
+            int candidates = displaySlots > 0 ? displaySlots - 1 : 0;
+            outputCount = candidates < frame_count ? candidates : frame_count;
+        }
+#endif
+        if (outputCount <= 0)
+            return 0;
+
+        NSMutableArray *phases = [NSMutableArray arrayWithCapacity:outputCount];
+        NSMutableArray *destinationFrames = [NSMutableArray arrayWithCapacity:outputCount];
+        CVPixelBufferRef allocated[7] = {0};
+        VTFrameProcessorFrame *previousFrame = nil;
+        VTFrameProcessorFrame *sourceFrame = nil;
+        id<VTFrameProcessorParameters> parameters = nil;
+        NSError *error = nil;
+        int64_t started = monotonic_time_ns();
+        int resultCount = 0;
+
+        previousFrame = [[VTFrameProcessorFrame alloc]
+            initWithBuffer:previous
+            presentationTimeStamp:CMTimeMake(previousPTS, 1000000000)];
+        sourceFrame = [[VTFrameProcessorFrame alloc]
+            initWithBuffer:source
+            presentationTimeStamp:CMTimeMake(sourcePTS, 1000000000)];
+
+        bool ok = previousFrame && sourceFrame;
+        for (int i = 0; ok && i < outputCount; i++) {
+            CVReturn poolResult = CVPixelBufferPoolCreatePixelBuffer(
+                kCFAllocatorDefault, output_pool, &allocated[i]);
+            if (poolResult != kCVReturnSuccess || !allocated[i]) {
+                ok = false;
+                break;
+            }
+            float phase;
+#if !TARGET_OS_TV && !TARGET_OS_MACCATALYST && !TARGET_OS_VISION && !TARGET_OS_SIMULATOR
+            if (uses_frame_rate_conversion && displaySlots > 0) {
+                int candidates = displaySlots - 1;
+                int candidateIndex;
+                if (outputCount == 1) {
+                    candidateIndex = candidates / 2;
+                } else if (outputCount == candidates) {
+                    candidateIndex = i;
+                } else {
+                    candidateIndex = (i * (candidates - 1) + (outputCount - 1) / 2) /
+                                     (outputCount - 1);
+                }
+                phase = (float)(candidateIndex + 1) / (float)displaySlots;
+            } else {
+                phase = (float)(i + 1) / (float)(outputCount + 1);
+            }
+#else
+            phase = (float)(i + 1) / (float)(outputCount + 1);
+#endif
+            int64_t pts = previousPTS + (int64_t)((sourcePTS - previousPTS) * phase);
+            VTFrameProcessorFrame *destination = [[VTFrameProcessorFrame alloc]
+                initWithBuffer:allocated[i]
+                presentationTimeStamp:CMTimeMake(pts, 1000000000)];
+            if (!destination) {
+                ok = false;
+                break;
+            }
+            [phases addObject:[NSNumber numberWithFloat:phase]];
+            [destinationFrames addObject:destination];
+            [destination release];
+            timestamps[i] = pts;
+        }
+
+        if (ok) {
+#if !TARGET_OS_TV && !TARGET_OS_MACCATALYST && !TARGET_OS_VISION && !TARGET_OS_SIMULATOR
+            if (uses_frame_rate_conversion) {
+                parameters = [[VTFrameRateConversionParameters alloc]
+                    initWithSourceFrame:previousFrame
+                    nextFrame:sourceFrame
+                    opticalFlow:nil
+                    interpolationPhase:phases
+                    submissionMode:sequential_submission
+                        ? VTFrameRateConversionParametersSubmissionModeSequential
+                        : VTFrameRateConversionParametersSubmissionModeRandom
+                    destinationFrames:destinationFrames];
+            } else
+#endif
+            {
+                parameters = [[VTLowLatencyFrameInterpolationParameters alloc]
+                    initWithSourceFrame:sourceFrame
+                    previousFrame:previousFrame
+                    interpolationPhase:phases
+                    destinationFrames:destinationFrames];
+            }
+            ok = parameters && [processor processWithParameters:parameters error:&error];
+        }
+
+        int64_t elapsed = monotonic_time_ns() - started;
+        if (elapsed > worst_process_ns)
+            worst_process_ns = elapsed;
+        if (ok) {
+            resultCount = outputCount;
+            for (int i = 0; i < resultCount; i++)
+                outputs[i] = CVPixelBufferRetain(allocated[i]);
+            sequential_submission = true;
+            state = MOTION_READY;
+        } else {
+            sequential_submission = false;
+            state = MOTION_READY;
+        }
+
+        for (int i = 0; i < 7; i++) {
+            if (allocated[i])
+                CVPixelBufferRelease(allocated[i]);
+        }
+        [parameters release];
+        [previousFrame release];
+        [sourceFrame release];
+        return resultCount;
+    }
+}
+
+- (void)markPresented
+{
+    @synchronized (self) {
+        if (requested && state == MOTION_READY)
+            state = MOTION_ACTIVE;
+    }
+}
+
+@end
+
+struct avf_motion_interpolator {
+    MPVAVFMotionSession *session;
+};
+
+struct avf_motion_interpolator *avf_motion_create(void)
+{
+    struct avf_motion_interpolator *motion = calloc(1, sizeof(*motion));
+    if (motion)
+        motion->session = [[MPVAVFMotionSession alloc] init];
+    return motion;
+}
+
+void avf_motion_destroy(struct avf_motion_interpolator *motion)
+{
+    if (!motion)
+        return;
+    [motion->session release];
+    free(motion);
+}
+
+void avf_motion_configure(struct avf_motion_interpolator *motion, bool enabled,
+                          int width, int height, int interpolated_frames)
+{
+    if (motion)
+        [motion->session configureEnabled:enabled width:width height:height
+                               frameCount:interpolated_frames];
+}
+
+void avf_motion_set_stream_eligible(struct avf_motion_interpolator *motion, bool eligible)
+{
+    if (motion)
+        [motion->session setStreamEligible:eligible];
+}
+
+const char *avf_motion_status(struct avf_motion_interpolator *motion)
+{
+    return motion ? [motion->session statusName] : "off";
+}
+
+int avf_motion_process(struct avf_motion_interpolator *motion,
+                       CVPixelBufferRef previous, CVPixelBufferRef source,
+                       int64_t previous_pts_ns, int64_t source_pts_ns,
+                       int64_t deadline_budget_ns, int display_slots,
+                       CVPixelBufferRef outputs[7], int64_t output_pts_ns[7])
+{
+    if (!motion) {
+        for (int i = 0; i < 7; i++) {
+            outputs[i] = NULL;
+            output_pts_ns[i] = 0;
+        }
+        return 0;
+    }
+    return [motion->session processPrevious:previous source:source
+                               previousTime:previous_pts_ns sourceTime:source_pts_ns
+                                 deadlineNs:deadline_budget_ns displaySlots:display_slots
+                                   outputs:outputs
+                                 timestamps:output_pts_ns];
+}
+
+void avf_motion_mark_presented(struct avf_motion_interpolator *motion)
+{
+    if (motion)
+        [motion->session markPresented];
+}
