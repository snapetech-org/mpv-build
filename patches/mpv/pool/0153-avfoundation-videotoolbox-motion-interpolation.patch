+
+static bool motion_params_are_supported(const struct mp_image_params *params)
+{
+    if (!params || params->w < 1 || params->h < 1 ||
+        (int64_t)params->w * params->h > INT64_C(1920) * 1080 ||
+        MPMAX(params->w, params->h) > 1920 ||
+        params->repr.sys == PL_COLOR_SYSTEM_DOLBYVISION ||
+        params->sys_orig == PL_COLOR_SYSTEM_DOLBYVISION)
+        return false;
+
+    switch (params->color.transfer) {
+    case PL_COLOR_TRC_BT_1886:
+    case PL_COLOR_TRC_SRGB:
+    case PL_COLOR_TRC_GAMMA22:
+    case PL_COLOR_TRC_GAMMA28:
+        return true;
+    default:
+        return false;
+    }
