+static void publish_display_sync_feedback(
+    struct MPContext *mpctx, bool valid, double source_pts, int num_vsyncs,
+    double vsync_interval, double playback_speed, double error_before,
+    double error_after)
+{
+    if (!mpctx->vo_chain || !mpctx->vo_chain->filter)
+        return;
+    const struct mp_display_sync_feedback feedback = {
+        .valid = valid && isfinite(source_pts) && source_pts != MP_NOPTS_VALUE &&
+                 num_vsyncs >= 0 && isfinite(vsync_interval) &&
+                 vsync_interval > 0 && isfinite(playback_speed) &&
+                 playback_speed > 0 && isfinite(error_before) &&
+                 isfinite(error_after),
+        .source_pts = source_pts,
+        .num_vsyncs = num_vsyncs,
+        .vsync_interval = vsync_interval,
+        .playback_speed = playback_speed,
+        .error_before = error_before,
+        .error_after = error_after,
+    };
+    mp_output_chain_set_display_sync_feedback(mpctx->vo_chain->filter, &feedback);
+}
