+static bool packet_has_lcevc(AVCodecContext *avctx, const AVPacket *packet)
+{
+    size_t side_size = 0;
+    if (av_packet_get_side_data(packet, AV_PKT_DATA_LCEVC, &side_size) && side_size)
+        return true;
+    bool hevc = avctx->codec_id == AV_CODEC_ID_HEVC;
+    if (!hevc && avctx->codec_id != AV_CODEC_ID_H264)
+        return false;
+    unsigned length_size = 4;
+    unsigned index = hevc ? 21 : 4;
+    if (avctx->extradata && avctx->extradata_size > (int)index && avctx->extradata[0] == 1)
+        length_size = (avctx->extradata[index] & 3) + 1;
+    return packet->size > 0 && mp_lcevc_probe(hevc, packet->data, packet->size, length_size);
+}
