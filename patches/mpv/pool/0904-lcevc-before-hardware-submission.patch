diff --git a/video/decode/lcevc_probe.h b/video/decode/lcevc_probe.h
new file mode 100644
--- /dev/null
+++ b/video/decode/lcevc_probe.h
@@ -0,0 +1,127 @@
+/* Bounded LCEVC signalling probe. Does not modify or decode packet contents. */
+#ifndef MP_LCEVC_PROBE_H
+#define MP_LCEVC_PROBE_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+struct mp_lcevc_rbsp {
+    const uint8_t *data;
+    size_t size, offset;
+    unsigned zeros;
+};
+
+static bool mp_lcevc_byte(struct mp_lcevc_rbsp *r, uint8_t *value)
+{
+    if (r->offset >= r->size)
+        return false;
+    uint8_t byte = r->data[r->offset++];
+    if (r->zeros >= 2 && byte == 3 && r->offset < r->size &&
+        r->data[r->offset] <= 3)
+        byte = r->data[r->offset++];
+    r->zeros = byte == 0 ? (r->zeros < 2 ? r->zeros + 1 : 2) : 0;
+    *value = byte;
+    return true;
+}
+
+static bool mp_lcevc_number(struct mp_lcevc_rbsp *r, uint32_t *value)
+{
+    uint32_t total = 0;
+    uint8_t byte;
+    do {
+        if (!mp_lcevc_byte(r, &byte) || UINT32_MAX - total < byte)
+            return false;
+        total += byte;
+    } while (byte == 255);
+    *value = total;
+    return true;
+}
+
+static bool mp_lcevc_nal(bool hevc, const uint8_t *data, size_t size)
+{
+    size_t header = hevc ? 2 : 1;
+    if (size <= header || (data[0] & 0x80))
+        return false;
+    unsigned type = hevc ? ((data[0] >> 1) & 63) : (data[0] & 31);
+    if ((!hevc && type != 6) || (hevc && (type != 39 && type != 40)))
+        return false;
+    struct mp_lcevc_rbsp r = {data + header, size - header, 0, 0};
+    while (r.offset < r.size) {
+        uint32_t payload_type, payload_size;
+        if (!mp_lcevc_number(&r, &payload_type) ||
+            !mp_lcevc_number(&r, &payload_size) || payload_size > r.size - r.offset)
+            return false;
+        if (payload_type == 4 && payload_size > 4) {
+            uint8_t tag[4];
+            for (unsigned i = 0; i < 4; i++) {
+                if (!mp_lcevc_byte(&r, &tag[i]))
+                    return false;
+            }
+            // ITU-T T.35 UK registration used by LCEVC, not HDR10+/CC.
+            const uint8_t lcevc_tag[] = {0xb4, 0x00, 0x50, 0x00};
+            if (memcmp(tag, lcevc_tag, sizeof(tag)) == 0)
+                return true;
+            payload_size -= 4;
+        }
+        while (payload_size--) {
+            uint8_t ignored;
+            if (!mp_lcevc_byte(&r, &ignored))
+                return false;
+        }
+    }
+    return false;
+}
+
+static bool mp_lcevc_start(const uint8_t *data, size_t size,
+                           size_t *offset, size_t *prefix)
+{
+    for (size_t i = *offset; i < size && size - i >= 3; i++) {
+        if (data[i] || data[i + 1])
+            continue;
+        if (data[i + 2] == 1) {
+            *offset = i;
+            *prefix = 3;
+            return true;
+        }
+        if (size - i >= 4 && !data[i + 2] && data[i + 3] == 1) {
+            *offset = i;
+            *prefix = 4;
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool mp_lcevc_probe(bool hevc, const uint8_t *data, size_t size,
+                           unsigned length_size)
+{
+    if (!data || !size)
+        return false;
+    if (length_size >= 1 && length_size <= 4) {
+        size_t offset = 0;
+        while (size - offset >= length_size) {
+            uint32_t length = 0;
+            for (unsigned i = 0; i < length_size; i++)
+                length = (length << 8) | data[offset++];
+            if (length > size - offset)
+                break;
+            if (mp_lcevc_nal(hevc, data + offset, length))
+                return true;
+            offset += length;
+        }
+    }
+    size_t start = 0, prefix;
+    while (mp_lcevc_start(data, size, &start, &prefix)) {
+        size_t begin = start + prefix, next = begin, next_prefix;
+        bool more = mp_lcevc_start(data, size, &next, &next_prefix);
+        size_t end = more ? next : size;
+        if (mp_lcevc_nal(hevc, data + begin, end - begin))
+            return true;
+        if (!more)
+            break;
+        start = next;
+    }
+    return false;
+}
+#endif
