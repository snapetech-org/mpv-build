+static struct mp_image *pme_scale_image(struct mp_sws_context *sws,
+                                         struct mp_image *source, int width, int height)
+{
+    struct mp_image *scaled = mp_image_alloc(source->imgfmt, width, height);
+    if (!scaled)
+        return NULL;
+    mp_image_copy_attributes(scaled, source);
+    mp_image_set_size(scaled, width, height);
+    scaled->params.crop = (struct mp_rect){
+        .x0 = source->params.crop.x0 * width / source->w,
+        .y0 = source->params.crop.y0 * height / source->h,
+        .x1 = source->params.crop.x1 * width / source->w,
+        .y1 = source->params.crop.y1 * height / source->h,
+    };
+    if (mp_sws_scale(sws, scaled, source) < 0) {
+        mp_image_unrefp(&scaled);
+        return NULL;
+    }
+    return scaled;
+}
