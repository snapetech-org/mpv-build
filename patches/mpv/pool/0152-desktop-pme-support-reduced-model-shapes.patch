+// Resample decoder motion vectors into the model's working resolution.
+static void zoh_fill_scaled(const AVMotionVector *mvs, int n_mvs,
+                            float *fx, float *fy, int H, int W,
+                            int source_H, int source_W)
+{
+    if (W == source_W && H == source_H) {
+        zoh_fill(mvs, n_mvs, fx, fy, H, W);
+        return;
+    }
+
+    memset(fx, 0, (size_t)H * W * sizeof(float));
+    memset(fy, 0, (size_t)H * W * sizeof(float));
+    const float sx = (float)W / source_W;
+    const float sy = (float)H / source_H;
+    for (int i = 0; i < n_mvs; i++) {
+        const AVMotionVector *m = &mvs[i];
+        if (m->source != -1) continue;
+        const float motion_scale = m->motion_scale > 0 ? (float)m->motion_scale : 1.0f;
+        const float mx = -(float)m->motion_x / motion_scale * sx;
+        const float my = -(float)m->motion_y / motion_scale * sy;
+        const int x0 = (int)floorf(((float)m->dst_x - (float)m->w * 0.5f) * sx);
+        const int y0 = (int)floorf(((float)m->dst_y - (float)m->h * 0.5f) * sy);
+        const int x1 = (int)ceilf(((float)m->dst_x + (float)m->w * 0.5f) * sx);
+        const int y1 = (int)ceilf(((float)m->dst_y + (float)m->h * 0.5f) * sy);
+        const int bx = x0 < 0 ? 0 : x0;
+        const int by = y0 < 0 ? 0 : y0;
+        const int ex = x1 > W ? W : x1;
+        const int ey = y1 > H ? H : y1;
+        for (int y = by; y < ey; y++) {
+            float *fx_row = fx + (size_t)y * W + bx;
+            float *fy_row = fy + (size_t)y * W + bx;
+            for (int x = bx; x < ex; x++) {
+                fx_row[x - bx] = mx;
+                fy_row[x - bx] = my;
+            }
+        }
+    }
+}
