+static void pme_adapt_phase_budget_after_miss_locked(struct priv *p,
+                                                      struct mp_filter *f,
+                                                      struct pme_scheduler_job *job)
+{
+    if (job->phase_count <= 1 || p->adaptive_phase_budget <= 1)
+        return;
+
+    const int previous_budget = p->adaptive_phase_budget;
+    p->adaptive_phase_budget = MPMIN(p->adaptive_phase_budget,
+                                     job->phase_count - 1);
+    if (p->adaptive_phase_budget >= previous_budget)
+        return;
+    p->adaptive_phase_headroom_pairs = 0;
+    MP_WARN(f, "PME: reducing display phase limit from %d to %d after a deadline miss\n",
+            previous_budget, p->adaptive_phase_budget);
+    publish_pme_stats_locked(p);
+}
+
+static void pme_adapt_phase_budget_after_pair_locked(struct priv *p,
+                                                      struct mp_filter *f,
+                                                      struct pme_scheduler_job *job)
+{
+    if (job->phase_count <= 0 || !job->success || job->deadline_missed ||
+        job->generated_count != job->phase_count) {
+        p->adaptive_phase_headroom_pairs = 0;
+        return;
+    }
+
+    if (p->adaptive_phase_budget >= p->configured_phase_budget) {
+        p->adaptive_phase_headroom_pairs = 0;
+        return;
+    }
+
+    if (++p->adaptive_phase_headroom_pairs < PME_PHASE_RECOVERY_PAIRS)
+        return;
+
+    const int previous_budget = p->adaptive_phase_budget;
+    p->adaptive_phase_budget++;
+    p->adaptive_phase_headroom_pairs = 0;
+    MP_INFO(f, "PME: restoring display phase budget from %d to %d after %d on-time pairs\n",
+            previous_budget, p->adaptive_phase_budget, PME_PHASE_RECOVERY_PAIRS);
+    publish_pme_stats_locked(p);
+}
