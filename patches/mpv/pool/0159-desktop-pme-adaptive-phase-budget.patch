+static int pme_requested_phase_budget(const struct pme_opts *opts)
+{
+    if (opts && opts->preset && strcmp(opts->preset, "performance") == 0)
+        return 1;
+    if (opts && opts->preset && strcmp(opts->preset, "quality") == 0)
+        return PME_MAX_OUTPUT_PHASES;
+    return 3;
+}
+
+static int pme_adaptive_phase_budget_locked(struct priv *p, int configured)
+{
+    if (p->configured_phase_budget != configured || p->adaptive_phase_budget < 1) {
+        p->configured_phase_budget = configured;
+        p->adaptive_phase_budget = configured;
+        p->adaptive_phase_headroom_pairs = 0;
+        publish_pme_stats_locked(p);
+    }
+    return p->adaptive_phase_budget;
+}
