+static int pme_plan_output_phases(struct priv *p, struct mp_filter *f,
+                                  const struct mp_image *prev,
+                                  const struct mp_image *curr,
+                                  struct pme_output_phase *phases)
+{
+    if (!prev || !curr || !isfinite(prev->pts) || !isfinite(curr->pts) ||
+        prev->pts == MP_NOPTS_VALUE || curr->pts == MP_NOPTS_VALUE ||
+        curr->pts <= prev->pts) {
+        p->display_phase_error = 0.0;
+        p->display_phase_fps = 0.0;
+        return 0;
+    }
+
+    const double source_duration = curr->pts - prev->pts;
+    struct mp_stream_info *info = mp_filter_find_stream_info(f);
+    const double display_fps = info && info->get_display_fps ?
+        info->get_display_fps(info) : 0.0;
+
+    if (!isfinite(display_fps) || display_fps <= 0.0) {
+        p->display_phase_error = 0.0;
+        p->display_phase_fps = 0.0;
+        phases[0] = (struct pme_output_phase){
+            .alpha = 0.5,
+            .pts = prev->pts + source_duration * 0.5,
+            .duration = source_duration * 0.5,
+        };
+        return 1;
+    }
+
+    const double source_fps = 1.0 / source_duration;
+    if (display_fps <= source_fps + 0.01) {
+        p->display_phase_error = 0.0;
+        p->display_phase_fps = display_fps;
+        return 0;
+    }
+
+    if (!isfinite(p->display_phase_fps) ||
+        fabs(p->display_phase_fps - display_fps) > 0.01) {
+        p->display_phase_fps = display_fps;
+        p->display_phase_error = 0.0;
+    }
+
+    // This error diffusion mirrors the integer slot-count decision used by
+    // mpv's display-sync scheduler, but cannot see its live AV-sync corrections.
+    const double fractional_slots = source_duration * display_fps +
+                                   p->display_phase_error;
+    if (!isfinite(fractional_slots) || fractional_slots < 0.5 ||
+        fractional_slots > 1000000.0) {
+        p->display_phase_error = 0.0;
+        return 0;
+    }
+    const int target_slots = (int)llrint(fractional_slots);
+    p->display_phase_error = fractional_slots - target_slots;
+    if (target_slots <= 1)
+        return 0;
+
+    int phase_budget = 3;
+    if (p->opts && p->opts->preset &&
+        strcmp(p->opts->preset, "performance") == 0)
+        phase_budget = 1;
+    else if (p->opts && p->opts->preset &&
+             strcmp(p->opts->preset, "quality") == 0)
+        phase_budget = PME_MAX_OUTPUT_PHASES;
+
+    const int output_slots = MPMIN(target_slots, phase_budget + 1);
+    const int count = output_slots - 1;
+    for (int i = 0; i < count; i++) {
+        const double alpha = (double)(i + 1) / output_slots;
+        phases[i] = (struct pme_output_phase){
+            .alpha = alpha,
+            .pts = prev->pts + alpha * source_duration,
+        };
+    }
+
+    for (int i = 0; i < count; i++) {
+        const double next_pts = i + 1 < count ? phases[i + 1].pts : curr->pts;
+        phases[i].duration = next_pts - phases[i].pts;
+        if (!isfinite(phases[i].alpha) || phases[i].alpha <= 0.0 ||
+            phases[i].alpha >= 1.0 || !isfinite(phases[i].duration) ||
+            phases[i].duration <= 0.0)
+            return 0;
+    }
+    return count;
+}
