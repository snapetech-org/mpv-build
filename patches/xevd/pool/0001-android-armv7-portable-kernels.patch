diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2105671..f48091e 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -90,7 +90,12 @@ endif()
 
 string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" SYSTEM_PROCESSOR)
 message("SYSTEM_PROCESSOR=${CMAKE_SYSTEM_PROCESSOR}")
-if(ARM OR SYSTEM_PROCESSOR MATCHES "^(arm|aarch)")
+if(ANDROID AND CMAKE_ANDROID_ARCH_ABI STREQUAL "armeabi-v7a")
+  # XEVD's NEON implementation uses AArch64-only intrinsics. The existing
+  # portable C implementation preserves support for Android's 32-bit ABI.
+  set(ARM "FALSE")
+  set(X86 "FALSE")
+elseif(ARM OR SYSTEM_PROCESSOR MATCHES "^(arm|aarch)")
   set(ARM "TRUE")
   add_definitions(-DARM=1)
 elseif(SYSTEM_PROCESSOR MATCHES "^(x86|amd64|ia64|i386|i686)")
