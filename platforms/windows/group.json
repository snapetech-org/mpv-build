{
  "assetBase": "https://github.com/snapetech-org/mpv-build/releases/download/binaries-windows",
  "toolchain": "toolchain/windows.txt",
  "driver": [
    "platforms/windows/build.sh",
    "platforms/windows/package.sh",
    "platforms/windows/pin_packages.py",
    "platforms/windows/host_llvm_cache.py",
    "scripts/symbols.py",
    "scripts/patches.py",
    "platforms/windows/check_patches.py"
  ],
  "artifacts": {
    "libmpv-windows": {
      "components": [
        "mpv",
        "ffmpeg",
        "libass",
        "mpv-winbuild-cmake",
        "mingw-w64",
        "llvm",
        "svt-av1",
        "nv-codec-headers",
        "openssl",
        "libplacebo"
      ],
      "variants": [
        "x86_64",
        "aarch64"
      ],
      "assetPattern": "libmpv-windows-{key}-{variant}.zip",
      "symbolsPattern": "libmpv-windows-{key}-{variant}-symbols.zip"
    }
  }
}
