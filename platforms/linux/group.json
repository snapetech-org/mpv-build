{
  "assetBase": "https://github.com/snapetech-org/mpv-build/releases/download/binaries-linux",
  "toolchain": "toolchain/linux.txt",
  "driver": [
    "platforms/linux/build.sh",
    "platforms/linux/package.sh",
    "platforms/linux/container-build.sh",
    "scripts/symbols.py",
    "scripts/check_music_dsp_filters.py",
    "scripts/inspect_pcm_package.py",
    "scripts/codec_inventory.py",
    "scripts/codec_playback_smoke.py",
    "scripts/codec_stream_smoke.py",
    "scripts/codec_disc_smoke.py",
    "scripts/fixtures/bluray-title.tar.xz",
    "scripts/codec_reference_smoke.py",
    "scripts/build_disc_readers.sh",
    "scripts/build_jpegxl.sh",
    "scripts/build_video_decoder.sh",
    "scripts/fix_lcevc_pkgconfig.py",
    "scripts/stage_decoder_notices.py",
    "scripts/lcevc_playback_smoke.py"
  ],
  "artifacts": {
    "libmpv-linux": {
      "components": [
        "mpv",
        "ffmpeg",
        "libass",
        "libplacebo",
        "dav1d",
        "shaderc",
        "nv-codec-headers",
        "wayland-protocols",
        "vulkan-headers",
        "vulkan-loader",
        "libcdio",
        "libcdio-paranoia",
        "libdvdread",
        "libdvdnav",
        "libbluray_linux",
        "libjxl",
        "libxml2",
        "xevd",
        "dav2d",
        "davs2",
        "uavs3d",
        "lcevc_dec"
      ],
      "variants": [
        "x86_64",
        "aarch64"
      ],
      "assetPattern": "libmpv-linux-{key}-{variant}.tar.zst",
      "symbolsPattern": "libmpv-linux-{key}-{variant}-symbols.zip"
    }
  }
}
