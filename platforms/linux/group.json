{
  "assetBase": "https://github.com/snapetech-org/mpv-build/releases/download/binaries-linux",
  "toolchain": "toolchain/linux.txt",
  "driver": [
    "platforms/linux/build.sh",
    "platforms/linux/package.sh",
    "platforms/linux/container-build.sh",
    "scripts/symbols.py",
    "scripts/check_music_dsp_filters.py"
  ],
  "artifacts": {
    "libmpv-linux": {
      "components": [
        "mpv",
        "ffmpeg",
        "libass",
        "libplacebo",
        "dav1d",
        "shaderc",
        "nv-codec-headers",
        "wayland-protocols",
        "vulkan-headers",
        "vulkan-loader"
      ],
      "variants": [
        "x86_64",
        "aarch64"
      ],
      "assetPattern": "libmpv-linux-{key}-{variant}.tar.zst",
      "symbolsPattern": "libmpv-linux-{key}-{variant}-symbols.zip"
    }
  }
}
